<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\conic.ico</ApplicationIcon>
    <AssemblyName>Conic</AssemblyName>
    <RootNamespace>Conic</RootNamespace>
  </PropertyGroup>

  <!-- The interactive smoke harness compiles only into builds that ask for it:
       Debug builds during development, and Release packages published with
       -p:Smoke=true for hardware qualification. The shipped product build
       excludes it entirely. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(Smoke)' == 'true'">
    <DefineConstants>$(DefineConstants);SMOKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.20348-beta1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\conic.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\VideoGeometry.cs" Link="Interop\VideoGeometry.cs" />
    <Compile Include="..\Shared\SubtitleComposer.cs" Link="Interop\SubtitleComposer.cs" />
    <ProjectReference Include="..\Player.Contracts\Player.Contracts.csproj" />
    <ProjectReference Include="..\Player.Domain\Player.Domain.csproj" />
    <ProjectReference Include="..\Player.Application\Player.Application.csproj" />
    <ProjectReference Include="..\VLCLR\VLCLR.csproj" />
  </ItemGroup>

</Project>
