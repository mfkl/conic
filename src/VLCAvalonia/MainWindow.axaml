<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:VLCAvalonia.Controls"
        xmlns:viewModels="clr-namespace:VLCAvalonia.ViewModels"
        xmlns:application="clr-namespace:Player.Application;assembly=Player.Application"
        xmlns:input="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
        xmlns:views="clr-namespace:VLCAvalonia.Views"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="720"
        x:Class="VLCAvalonia.MainWindow"
        x:DataType="viewModels:PlayerPresentationViewModel"
        Title="VLC Avalonia"
        Icon="avares://VLCAvalonia/Assets/vlc-avalonia.ico"
        MinWidth="480"
        MinHeight="360"
        Background="{DynamicResource PlayerCanvas}"
        Foreground="{DynamicResource PlayerText}"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

    <!-- Rows: the 40 px title bar, the video, the 54 px control bar. Windowed,
         the bars dock around the video in rows 0 and 2; in fullscreen and
         picture in picture the video spans all rows and the bars overlay it
         (MainWindow.Chrome.cs, ApplyVideoLayout). Every other layer spans all
         rows. -->
    <Grid x:Name="VideoArea"
          RowDefinitions="40,*,54"
          Background="{DynamicResource PlayerCanvas}"
          PointerMoved="OnPlayerInteraction"
          PointerPressed="OnVideoPointerPressed"
          KeyDown="OnPlayerKeyDown"
          input:DragDrop.AllowDrop="True"
          input:DragDrop.DragOver="OnMediaDragOver"
          input:DragDrop.Drop="OnMediaDrop">

        <!-- The right-click menu (design 6065:13616): transport first, then
             the Playback, Video, Audio and Subtitle submenus, then More
             Settings, Playlist and Open Media. Every command the menu had is
             kept in the matching group; the design's Record, Hide UI and Quit
             are left out (D2). Shortcut hints are filled in when it opens
             (Controls/MenuShortcuts); the styles are in PlayerChrome.axaml
             ("Menus"). -->
        <Grid.ContextMenu>
            <ContextMenu x:Name="VideoContextMenu" Opening="OnVideoContextMenuOpening">
                <MenuItem Header="{Binding PlayPauseName}"
                          Command="{Binding TogglePauseCommand}"
                          controls:MenuShortcuts.Command="TogglePause">
                    <MenuItem.Icon>
                        <Panel>
                            <controls:VlcIcon Classes="menuIcon" IsVisible="{Binding !IsPlaying}" Icon="{StaticResource Icon.Play}" />
                            <controls:VlcIcon Classes="menuIcon" IsVisible="{Binding IsPlaying}" Icon="{StaticResource Icon.Pause}" />
                        </Panel>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Stop"
                          Command="{Binding StopCommand}"
                          controls:MenuShortcuts.Command="Stop">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Stop}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Previous Item"
                          Command="{Binding PreviousCommand}"
                          controls:MenuShortcuts.Command="QueuePrevious">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Previous}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Next Item"
                          Command="{Binding NextCommand}"
                          controls:MenuShortcuts.Command="QueueNext">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Next}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding SkipBackwardMenuText}"
                          Command="{Binding SkipBackwardCommand}"
                          controls:MenuShortcuts.Command="SkipBackward">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.SkipBackwardArrow}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding SkipForwardMenuText}"
                          Command="{Binding SkipForwardCommand}"
                          controls:MenuShortcuts.Command="SkipForward">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.SkipForwardArrow}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Playback">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Playback}" /></MenuItem.Icon>
                    <MenuItem Header="Speed 0.5×" ToggleType="Radio" GroupName="VideoMenuSpeed"
                              IsChecked="{Binding PlaybackRate, Mode=OneWay, Converter={x:Static controls:RateEqualsConverter.Instance}, ConverterParameter=0.5}"
                              Command="{Binding SetPlaybackRateCommand}" CommandParameter="0.5" />
                    <MenuItem Header="Speed 1×" ToggleType="Radio" GroupName="VideoMenuSpeed"
                              IsChecked="{Binding PlaybackRate, Mode=OneWay, Converter={x:Static controls:RateEqualsConverter.Instance}, ConverterParameter=1}"
                              Command="{Binding SetPlaybackRateCommand}" CommandParameter="1" />
                    <MenuItem Header="Speed 1.5×" ToggleType="Radio" GroupName="VideoMenuSpeed"
                              IsChecked="{Binding PlaybackRate, Mode=OneWay, Converter={x:Static controls:RateEqualsConverter.Instance}, ConverterParameter=1.5}"
                              Command="{Binding SetPlaybackRateCommand}" CommandParameter="1.5" />
                    <MenuItem Header="Speed 2×" ToggleType="Radio" GroupName="VideoMenuSpeed"
                              IsChecked="{Binding PlaybackRate, Mode=OneWay, Converter={x:Static controls:RateEqualsConverter.Instance}, ConverterParameter=2}"
                              Command="{Binding SetPlaybackRateCommand}" CommandParameter="2" />
                    <Separator />
                    <MenuItem Header="Chapters"
                              Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Chapters" />
                </MenuItem>
                <MenuItem Header="Video">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Video}" /></MenuItem.Icon>
                    <MenuItem Header="Fullscreen"
                              Command="{Binding ToggleFullscreenCommand}"
                              controls:MenuShortcuts.Command="ToggleFullscreen">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Fullscreen}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding PictureInPictureLabel}"
                              Command="{Binding TogglePictureInPictureCommand}"
                              controls:MenuShortcuts.Command="TogglePictureInPicture">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Pip}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Video Adjustments"
                              Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Video">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Paint}" /></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Audio">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Audio}" /></MenuItem.Icon>
                    <MenuItem Header="Mute"
                              Command="{Binding ToggleMuteCommand}"
                              controls:MenuShortcuts.Command="ToggleMute">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.VolumeMute}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Audio Tracks"
                              Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Audio" />
                </MenuItem>
                <MenuItem Header="Subtitle">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Subtitles}" /></MenuItem.Icon>
                    <MenuItem Header="Subtitle Tracks"
                              Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Subtitles" />
                </MenuItem>
                <Separator />
                <MenuItem Header="More Settings">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Settings}" /></MenuItem.Icon>
                    <MenuItem Header="Media Information"
                              Command="{Binding MediaInformationCommand}"
                              controls:MenuShortcuts.Command="MediaInformation">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Info}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Keyboard Shortcuts" Click="OnShowKeyboardShortcuts">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Hotkeys}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Settings"
                              Command="{Binding OpenSettingsCommand}"
                              controls:MenuShortcuts.Command="OpenSettings">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Preferences}" /></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Playlist">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Playlist}" /></MenuItem.Icon>
                    <MenuItem Header="Playback Queue"
                              Command="{Binding ToggleQueueCommand}"
                              controls:MenuShortcuts.Command="ToggleQueue">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Lists}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding RepeatLabel}" Command="{Binding CycleRepeatCommand}">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Repeat}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding ShuffleLabel}" Command="{Binding ToggleShuffleCommand}">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Shuffle}" /></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Open Media">
                    <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Open}" /></MenuItem.Icon>
                    <MenuItem Header="Open File…"
                              Command="{Binding OpenMediaCommand}"
                              controls:MenuShortcuts.Command="OpenMedia">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.File}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Folder…"
                              Command="{Binding OpenFolderCommand}"
                              controls:MenuShortcuts.Command="OpenFolder">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Folder}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Network Stream…"
                              Command="{Binding OpenUrlCommand}"
                              controls:MenuShortcuts.Command="OpenUrl">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Link}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Load Playlist…"
                              Command="{Binding LoadPlaylistCommand}"
                              controls:MenuShortcuts.Command="LoadPlaylist">
                        <MenuItem.Icon><controls:VlcIcon Classes="menuIcon" Icon="{StaticResource Icon.Playlist}" /></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Never re-parent the surface (detaching disposes the VLC backend);
             only its row changes. Subtitles always share its cell. -->
        <controls:CompositionVideoSurface x:Name="VideoSurface" Grid.Row="1" />
        <controls:SubtitleOverlay x:Name="SubtitleLayer" Grid.Row="1" />

        <views:HomeView x:Name="HomeScreen"
                        Grid.RowSpan="3"
                        ZIndex="1"
                        IsVisible="{Binding IsHomeOpen}" />

        <!-- Over the video, so dark in both themes. -->
        <ThemeVariantScope x:Name="PictureInPictureChrome"
                           Grid.RowSpan="3"
                           ZIndex="2"
                           IsVisible="False"
                           Focusable="True"
                           RequestedThemeVariant="Dark"
                           AutomationProperties.Name="Picture in picture controls">
            <Grid>
                <!-- Styled like the mini player's preview overlay: a dark scrim
                     header (return, title, close), the accent play pill in the
                     middle and the design timeline at the bottom. -->
                <Border x:Name="PictureInPictureHeader"
                        VerticalAlignment="Top"
                        Background="{DynamicResource Vlc.OnMedia.Scrim}"
                        PointerPressed="OnPictureInPictureDrag"
                        Padding="6,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="PictureInPictureReturn"
                                Classes="icon"
                                Foreground="{DynamicResource Vlc.Fg.2}"
                                Command="{Binding TogglePictureInPictureCommand}"
                                ToolTip.Tip="Return to main window (Escape)"
                                AutomationProperties.Name="Return from picture in picture">
                            <controls:VlcIcon Width="24" Height="24"
                                              Icon="{StaticResource Icon.Open}" />
                        </Button>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MediaTitle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource Vlc.Fg.2}" />
                        <Button Grid.Column="2"
                                Classes="icon"
                                Foreground="{DynamicResource Vlc.Fg.2}"
                                Click="OnPictureInPictureClose"
                                ToolTip.Tip="Close VLC"
                                AutomationProperties.Name="Close VLC">
                            <controls:VlcIcon Width="24" Height="24"
                                              Icon="{StaticResource Icon.Close}" />
                        </Button>
                    </Grid>
                </Border>
                <Button x:Name="PictureInPicturePlay"
                        Classes="primary play"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding TogglePauseCommand}"
                        ToolTip.Tip="{Binding PlayPauseToolTip}"
                        AutomationProperties.Name="{Binding PlayPauseName}">
                    <Grid>
                        <controls:VlcIcon Width="24" Height="24"
                                          IsVisible="{Binding !IsPlaying}"
                                          Icon="{StaticResource Icon.Play}" />
                        <controls:VlcIcon Width="24" Height="24"
                                          IsVisible="{Binding IsPlaying}"
                                          Icon="{StaticResource Icon.Pause}" />
                    </Grid>
                </Button>
                <Border VerticalAlignment="Bottom"
                        Background="{DynamicResource Vlc.OnMedia.Scrim}"
                        Padding="10,4,10,8">
                    <Grid RowDefinitions="Auto,28" ColumnDefinitions="*,Auto" RowSpacing="2">
                        <TextBlock Text="{Binding ElapsedText}"
                                   FontSize="11"
                                   FontFeatures="tnum"
                                   Foreground="{DynamicResource Vlc.Fg.2}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DurationText}"
                                   FontSize="11"
                                   FontFeatures="tnum"
                                   Foreground="{DynamicResource PlayerSecondaryText}" />
                        <controls:PlayerTimeline x:Name="PictureInPictureTimeline"
                                                 Grid.Row="1"
                                                 Grid.ColumnSpan="2"
                                                 Classes="timeline"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 SmallChange="{Binding SeekStep}"
                                                 Value="{Binding Position, Mode=TwoWay}"
                                                 IsEnabled="{Binding CanSeek}"
                                                 AutomationProperties.Name="Picture in picture position"
                                                 AutomationProperties.HelpText="Use left and right arrow keys to seek."
                                                 SeekStarted="OnSeekStarted"
                                                 SeekCommitted="OnSeekCommitted" />
                    </Grid>
                </Border>
            </Grid>
        </ThemeVariantScope>

        <!-- Ready, opening and error states sit on the black video canvas,
             so they keep the dark theme. -->
        <ThemeVariantScope Grid.Row="1" RequestedThemeVariant="Dark">
            <Panel TextElement.Foreground="{DynamicResource PlayerText}">
            <!-- Hidden under Home, which covers the player. -->
            <StackPanel x:Name="NoMediaSurface"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsNoMedia" />
                        <Binding Path="!IsHomeOpen" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{DynamicResource PlayerCard}"
                        BorderBrush="{DynamicResource PlayerBorder}"
                        BorderThickness="1">
                    <controls:VlcIcon Width="32" Height="32"
                                      Foreground="{DynamicResource PlayerSecondaryText}"
                                      Icon="{StaticResource Icon.Play}" />
                </Border>
                <TextBlock Text="Ready to play"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Button Classes="openMedia"
                        Content="Open media"
                        Command="{Binding OpenMediaCommand}"
                        AutomationProperties.Name="Open media"
                        ToolTip.Tip="Open a media file (Ctrl+O)" />
                <TextBlock Text="or drop media anywhere"
                           Foreground="{DynamicResource PlayerSecondaryText}"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsOpening}"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar x:Name="OpeningIndicator"
                             Classes="openingIndicator"
                             Width="220"
                             Height="4"
                             IsIndeterminate="True"
                             x:FieldModifier="internal" />
                <TextBlock Text="{Binding MediaTitle, StringFormat='Opening {0}…'}"
                           Foreground="{DynamicResource Vlc.Fg.2}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsFaulted}"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="Media could not be played"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PlayerErrorText}" />
                <Button Classes="openMedia"
                        Content="Open another file"
                        Command="{Binding OpenMediaCommand}" />
            </StackPanel>
            </Panel>
        </ThemeVariantScope>

        <!-- The design's title bar doubles as the caption: with the client
             area extended over the decorations, dragging it moves the window
             and the in-app buttons replace the light system caption (macOS
             keeps its traffic lights; see PlatformChrome). Docked above the
             video in a window; in fullscreen it overlays the video and hides
             with the control bar while playing. -->
        <Border x:Name="TopChrome"
                Grid.Row="0"
                Classes="titleBar"
                VerticalAlignment="Top"
                Background="{DynamicResource Vlc.Bg.A3}"
                PointerPressed="OnCaptionPointerPressed">
            <controls:TitleBarPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <!-- VLC cone vector from VideoLAN's vlc/modules/gui/qt/pixmaps/misc/cone.svg. -->
                    <Viewbox x:Name="ProductMark"
                             Width="24"
                             Height="24"
                             Margin="7,2"
                             VerticalAlignment="Center">
                        <Canvas Width="130" Height="130">
                            <Path Fill="{DynamicResource Vlc.Accent.Logo}"
                                  Data="M65 8.76c-1.511 0-3.023.369-4.219 1.108-2.675 1.654-4.219 8.438-4.219 8.438L54.031 25.9c7.312
                                          4.599 14.625 4.647 21.938 0l-2.532-7.594s-1.543-6.784-4.218-8.438C68.022 9.129 66.511 8.761 65
                                          8.761zM47.281 46.15l-8.437 25.312c17.304 11.16 34.739 11.376 52.312 0L82.72 46.15c-11.912
                                          8.86-23.725 8.888-35.438 0zM22.812 81.587 11 121.243h108l-11.813-39.656H94.531l1.688 5.063s1.401
                                          4.523 0 5.906c-14.817 14.618-47.82 13.973-62.438-.844-1.185-1.201 0-5.062 0-5.062l1.688-5.063z" />
                            <Path Fill="White"
                                  Data="m35.469 81.585-1.688 5.063s-1.185 3.86 0 5.062c14.618 14.817 47.62 15.462 62.438.844 1.401-1.383
                                          0-5.906 0-5.906l-1.688-5.063-3.375-10.125c-17.573 11.376-35.008 11.159-52.312
                                          0zm11.812-35.437c11.713 8.888 23.526 8.86 35.438 0l-6.75-20.25c-7.313 4.647-14.625 4.599-21.938
                                          0z" />
                        </Canvas>
                    </Viewbox>
                    <Button x:Name="OpenOptionsButton"
                            Classes="titleBar"
                            Click="OnOpenOptions"
                            ToolTip.Tip="More playback controls"
                            AutomationProperties.Name="More playback controls">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.More}" />
                    </Button>
                    <Border Classes="titleDivider" />
                    <!-- Where the library screens show their location. -->
                    <Button x:Name="HomeButton"
                            Classes="titleBar"
                            Command="{Binding ShowHomeCommand}"
                            ToolTip.Tip="Home (Alt+Home)"
                            AutomationProperties.Name="Home">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.ArrowLeft}" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TopChromeTitle"
                           Classes="windowTitle"
                           Text="{Binding MediaTitle}"
                           ToolTip.Tip="{Binding MediaTitle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:WindowCaptionButtons>
                        <!-- Design: minimize, maximize, fullscreen, close. It
                             stays in fullscreen (as exit) and on macOS. -->
                        <controls:WindowCaptionButtons.Accessory>
                            <Button x:Name="FullscreenButton"
                                    Classes="caption"
                                    ToolTip.Tip="{Binding FullscreenName}"
                                    Command="{Binding ToggleFullscreenCommand}"
                                    AutomationProperties.Name="{Binding FullscreenName}">
                                <Grid>
                                    <controls:VlcIcon Width="24" Height="24"
                                                      IsVisible="{Binding !IsFullscreen}"
                                                      Icon="{StaticResource Icon.Fullscreen}" />
                                    <controls:VlcIcon Width="24" Height="24"
                                                      IsVisible="{Binding IsFullscreen}"
                                                      Icon="{StaticResource Icon.FullscreenExit}" />
                                </Grid>
                            </Button>
                        </controls:WindowCaptionButtons.Accessory>
                    </controls:WindowCaptionButtons>
                    <Button x:Name="LibraryButton"
                            IsVisible="False"
                            Command="{Binding OpenLibraryCommand}" />
                </StackPanel>
            </controls:TitleBarPanel>
        </Border>

        <!-- The More menu (design 6062:13354), shared by the player's and
             Home's title bar "…" buttons. The design's groups: opening media
             (with Open Recent), then the player's own commands (not in the
             design's menu; kept), then Keyboard Shortcuts and Settings.
             Options the app cannot do are left out (D2): Open Disc, Open
             Capture Device, Convert, Profile, Customize Player, About.
             Open Recent shows its page in place of the options (Right or
             Enter; Left, Backspace, Escape or the back row return). Arrow
             keys move between options (OnOpenMenuKeyDown); choosing one
             closes the menu. Shortcut hints follow the user's shortcuts
             (Controls/MenuShortcuts). -->
        <Border x:Name="OpenMenu"
                Grid.RowSpan="3"
                ZIndex="20"
                IsVisible="False"
                Focusable="True"
                Classes="menuSurface"
                Width="375"
                MaxHeight="380"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="6,44,20,0"
                KeyDown="OnOpenMenuKeyDown"
                AutomationProperties.Name="More options">
            <ScrollViewer x:Name="OpenMenuScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Panel>
                    <StackPanel x:Name="MoreMenuMain">
                        <controls:MenuRow Content="Open File…"
                                          Icon="{StaticResource Icon.File}"
                                          controls:MenuShortcuts.Command="OpenMedia"
                                          Click="OnOpenFile"
                                          ToolTip.Tip="Open a local media file" />
                        <controls:MenuRow x:Name="OpenFolderAction"
                                          Content="Open Folder…"
                                          Icon="{StaticResource Icon.Folder}"
                                          controls:MenuShortcuts.Command="OpenFolder"
                                          Command="{Binding OpenFolderCommand}"
                                          ToolTip.Tip="Every supported file in the folder is added as a flat playback queue" />
                        <controls:MenuRow Content="Open Network Stream…"
                                          Icon="{StaticResource Icon.Link}"
                                          controls:MenuShortcuts.Command="OpenUrl"
                                          Command="{Binding OpenUrlCommand}"
                                          ToolTip.Tip="Open an http or https media address" />
                        <controls:MenuRow Content="Load Playlist…"
                                          Icon="{StaticResource Icon.Playlist}"
                                          controls:MenuShortcuts.Command="LoadPlaylist"
                                          Command="{Binding LoadPlaylistCommand}"
                                          ToolTip.Tip="Load a flat M3U or M3U8 playback queue" />
                        <controls:MenuRow x:Name="OpenRecentRow"
                                          Content="Open Recent"
                                          Icon="{StaticResource Icon.Recent}"
                                          HasSubmenu="True"
                                          Click="OnShowRecentPage" />
                        <Border Classes="menuSeparator" />
                        <controls:MenuRow Content="Stop"
                                          Icon="{StaticResource Icon.Stop}"
                                          controls:MenuShortcuts.Command="Stop"
                                          Command="{Binding StopCommand}"
                                          IsVisible="{Binding CanStop}" />
                        <controls:MenuRow Content="Tracks and Synchronization"
                                          Icon="{StaticResource Icon.Audio}"
                                          Command="{Binding ToggleMediaControlsCommand}"
                                          CommandParameter="Audio" />
                        <controls:MenuRow Content="Video Adjustments"
                                          Icon="{StaticResource Icon.Video}"
                                          Command="{Binding ToggleMediaControlsCommand}"
                                          CommandParameter="Video" />
                        <controls:MenuRow Content="Media Information"
                                          Icon="{StaticResource Icon.Info}"
                                          controls:MenuShortcuts.Command="MediaInformation"
                                          Command="{Binding MediaInformationCommand}" />
                        <controls:MenuRow Content="Picture in Picture"
                                          Icon="{StaticResource Icon.Pip}"
                                          controls:MenuShortcuts.Command="TogglePictureInPicture"
                                          Command="{Binding TogglePictureInPictureCommand}"
                                          ToolTip.Tip="Keep video above other windows" />
                        <Grid Classes="menuControlRow" ColumnDefinitions="24,*,Auto">
                            <controls:VlcIcon Icon="{StaticResource Icon.Speed}" />
                            <TextBlock Grid.Column="1" Text="Playback Speed" />
                            <ComboBox x:Name="SpeedSelector"
                                      Grid.Column="2"
                                      Width="88"
                                      VerticalAlignment="Center"
                                      PlaceholderText="{Binding PlaybackRate, StringFormat='{}{0:0.##}×'}"
                                      SelectionChanged="OnSpeedChanged"
                                      AutomationProperties.Name="Playback speed">
                                <ComboBoxItem Content="0.5×" Tag="0.5" />
                                <ComboBoxItem Content="1×" Tag="1" />
                                <ComboBoxItem Content="1.5×" Tag="1.5" />
                                <ComboBoxItem Content="2×" Tag="2" />
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="AlwaysOnTopChrome" Classes="menuControlRow" ColumnDefinitions="24,*">
                            <controls:VlcIcon Icon="{StaticResource Icon.Window}" />
                            <CheckBox Grid.Column="1"
                                      Content="Always on Top"
                                      IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                                      Command="{Binding SetAlwaysOnTopCommand}"
                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                        <Border Classes="menuSeparator" />
                        <controls:MenuRow x:Name="KeyboardShortcutsRow"
                                          Content="Keyboard Shortcuts"
                                          Icon="{StaticResource Icon.Hotkeys}"
                                          HasSubmenu="True"
                                          Click="OnShowKeyboardShortcuts"
                                          ToolTip.Tip="Change shortcuts in Settings, Controls" />
                        <controls:MenuRow x:Name="OpenSettingsButton"
                                          Content="Settings"
                                          Icon="{StaticResource Icon.Settings}"
                                          controls:MenuShortcuts.Command="OpenSettings"
                                          Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>

                    <!-- Open Recent: the recent media, each with a remove
                         button, and Clear recent with a confirmation. -->
                    <StackPanel x:Name="MoreMenuRecent" IsVisible="False">
                        <controls:MenuRow x:Name="RecentBackRow"
                                          Content="Open Recent"
                                          Icon="{StaticResource Icon.ChevronLeft}"
                                          Click="OnShowMainMenuPage"
                                          AutomationProperties.Name="Open Recent, back to menu" />
                        <Border Classes="menuSeparator" />
                        <ScrollViewer x:Name="RecentScroll"
                                      MaxHeight="300"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding HasRecentItems}">
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:RecentMediaEntry">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,6,0">
                                            <Button Classes="recentItem"
                                                    ToolTip.Tip="{Binding Source}"
                                                    Click="OnOpenRecent"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Open {0}'}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="recentRemove"
                                                    ToolTip.Tip="Remove from recent media"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat='Remove {0} from recent media'}"
                                                    Command="{Binding DataContext.RemoveRecentCommand, ElementName=VideoArea}"
                                                    CommandParameter="{Binding Source}">
                                                <controls:VlcIcon Width="24" Height="24"
                                                                  Icon="{StaticResource Icon.Close}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="RecentEmptyState"
                                   IsVisible="{Binding HasNoRecentItems}"
                                   Text="No recent media yet."
                                   Classes="panelHint"
                                   Foreground="{DynamicResource Vlc.Fg.A2}"
                                   Margin="14,10" />
                        <TextBlock IsVisible="{Binding HasHistoryError}"
                                   Text="{Binding HistoryError}"
                                   Foreground="{DynamicResource PlayerErrorText}"
                                   TextWrapping="Wrap"
                                   Margin="14,6"
                                   AutomationProperties.Name="Recent history error" />
                        <StackPanel x:Name="ClearRecentPrompt"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="8"
                                    Spacing="6"
                                    IsVisible="False">
                            <TextBlock Text="Clear recent media?"
                                       VerticalAlignment="Center"
                                       Classes="panelHint"
                                       Foreground="{DynamicResource Vlc.Fg.A2}" />
                            <Button Classes="secondary" Content="Cancel" Click="OnCancelClearRecent" />
                            <Button Classes="secondary" Content="Clear" Command="{Binding ClearRecentCommand}" Click="OnConfirmClearRecent" />
                        </StackPanel>
                        <Button x:Name="ClearRecentButton"
                                Classes="secondary"
                                HorizontalAlignment="Right"
                                Margin="8"
                                Content="Clear recent"
                                IsVisible="{Binding HasRecentItems}"
                                Click="OnClearRecent"
                                ToolTip.Tip="Clear recent media" />
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Border>

        <!-- Drawers and panels open below the title bar and above the
             control bar (ApplyDrawerLayout). The library drawer shares the
             bar panels' surface and tab row. -->
        <Border x:Name="LibraryPanel"
                Grid.RowSpan="3"
                ZIndex="30"
                Classes="barPanel"
                IsVisible="{Binding IsLibraryOpen}"
                Focusable="True"
                Width="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{Binding LibraryPanelAutomationName}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Classes="panelTabs">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <UniformGrid Rows="1">
                            <Button x:Name="LibraryRecentTab"
                                    Classes="panelTab"
                                    Classes.selected="{Binding IsLibraryRecentTab}"
                                    Click="OnLibraryTab"
                                    Tag="Recent"
                                    AutomationProperties.Name="{Binding LibraryRecentTabAutomationName}">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Recent}" />
                                    <TextBlock Text="{Binding LibraryRecentTabText}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsLibraryFavoritesTab}"
                                    Click="OnLibraryTab"
                                    Tag="Favorites"
                                    AutomationProperties.Name="{Binding LibraryFavoritesTabAutomationName}">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Favorite}" />
                                    <TextBlock Text="{Binding LibraryFavoritesTabText}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsLibraryResumeTab}"
                                    Click="OnLibraryTab"
                                    Tag="Resume"
                                    AutomationProperties.Name="{Binding LibraryResumeTabAutomationName}">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Replay}" />
                                    <TextBlock Text="{Binding LibraryResumeTabText}" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button Grid.Column="1"
                                Classes="icon"
                                Command="{Binding AddFavoriteCommand}"
                                IsVisible="{Binding !IsCurrentFavorite}"
                                ToolTip.Tip="{Binding LibraryFavoriteCurrentToolTip}"
                                AutomationProperties.Name="{Binding LibraryFavoriteCurrentAutomationName}">
                            <controls:VlcIcon Width="24" Height="24"
                                              Icon="{StaticResource Icon.FavoriteActive}" />
                        </Button>
                        <Button x:Name="CloseLibraryButton"
                                Grid.Column="2"
                                Classes="icon"
                                Click="OnCloseLibrary"
                                ToolTip.Tip="{Binding LibraryCloseToolTip}"
                                AutomationProperties.Name="{Binding LibraryCloseAutomationName}">
                            <controls:VlcIcon Width="20" Height="20"
                                              Icon="{StaticResource Icon.Close}" />
                        </Button>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="16,8,12,8">
                    <Grid IsVisible="{Binding IsLibraryRecentTab}" RowDefinitions="Auto,*,Auto" RowSpacing="4">
                        <TextBlock Classes="panelCaption" Text="{Binding LibraryRecentTitle}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:RecentMediaEntry">
                                        <Border Classes="panelItem">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Classes="panelRow"
                                                        Click="OnOpenLibraryEntry"
                                                        ToolTip.Tip="{Binding DataContext.LibraryOpenRecentToolTip, ElementName=VideoArea}"
                                                        AutomationProperties.Name="{Binding DataContext.LibraryOpenRecentAutomationName, ElementName=VideoArea}">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <StackPanel Grid.Column="1" Classes="rowActions">
                                                    <Button Classes="icon rowAction"
                                                            Command="{Binding DataContext.RemoveRecentCommand, ElementName=VideoArea}"
                                                            CommandParameter="{Binding Source}"
                                                            AutomationProperties.Name="{Binding DataContext.LibraryRemoveRecentAutomationName, ElementName=VideoArea}">
                                                        <controls:VlcIcon Width="20" Height="20"
                                                                          Icon="{StaticResource Icon.Close}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding LibraryNoRecent}"
                                   IsVisible="{Binding HasNoRecentItems}"
                                   Classes="panelHint" />
                    </Grid>
                    <Grid IsVisible="{Binding IsLibraryFavoritesTab}" RowDefinitions="Auto,*,Auto" RowSpacing="4">
                        <TextBlock Classes="panelCaption" Text="{Binding LibraryFavoritesTitle}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FavoriteItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:FavoriteMediaEntry">
                                        <Border Classes="panelItem">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Classes="panelRow"
                                                        Click="OnOpenLibraryEntry"
                                                        ToolTip.Tip="{Binding DataContext.LibraryOpenFavoriteToolTip, ElementName=VideoArea}"
                                                        AutomationProperties.Name="{Binding DataContext.LibraryOpenFavoriteAutomationName, ElementName=VideoArea}">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <StackPanel Grid.Column="1" Classes="rowActions">
                                                    <Button Classes="icon rowAction"
                                                            Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=VideoArea}"
                                                            CommandParameter="{Binding Source}"
                                                            AutomationProperties.Name="{Binding DataContext.LibraryRemoveFavoriteAutomationName, ElementName=VideoArea}">
                                                        <controls:VlcIcon Width="20" Height="20"
                                                                          Icon="{StaticResource Icon.Close}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding LibraryNoFavorites}"
                                   IsVisible="{Binding !HasFavoriteItems}"
                                   Classes="panelHint" />
                    </Grid>
                    <Grid IsVisible="{Binding IsLibraryResumeTab}" RowDefinitions="Auto,*,Auto" RowSpacing="4">
                        <TextBlock Classes="panelCaption" Text="{Binding LibraryResumeTitle}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ResumeItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:ResumeEntry">
                                        <Border Classes="panelItem">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Button Classes="panelRow"
                                                        Click="OnOpenLibraryEntry"
                                                        ToolTip.Tip="{Binding DataContext.LibraryOpenResumeToolTip, ElementName=VideoArea}"
                                                        AutomationProperties.Name="{Binding DataContext.LibraryOpenResumeAutomationName, ElementName=VideoArea}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Source}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Classes="rowDetail"
                                                                   Text="{Binding Position}" />
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" Classes="rowActions">
                                                    <Button Classes="icon rowAction"
                                                            Command="{Binding DataContext.RemoveResumeCommand, ElementName=VideoArea}"
                                                            CommandParameter="{Binding Source}"
                                                            AutomationProperties.Name="{Binding DataContext.LibraryRemoveResumeAutomationName, ElementName=VideoArea}">
                                                        <controls:VlcIcon Width="20" Height="20"
                                                                          Icon="{StaticResource Icon.Close}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding LibraryNoResume}"
                                   IsVisible="{Binding !HasResumeItems}"
                                   Classes="panelHint" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="2" Spacing="6" Margin="16,0,16,12">
                    <TextBlock Text="{Binding LibraryDescription}"
                               Classes="panelHint" />
                    <TextBlock Text="{Binding LibraryPrivacy}"
                               Classes="panelHint" />
                    <StackPanel x:Name="ClearLibraryPrompt"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                IsVisible="False">
                        <TextBlock Text="{Binding LibraryClearPrompt}"
                                   VerticalAlignment="Center"
                                   Classes="panelHint" />
                        <Button x:Name="CancelClearLibraryButton"
                                Content="{Binding LibraryCancel}"
                                Click="OnCancelClearLibrary" />
                        <Button Content="{Binding LibraryClearAll}"
                                Command="{Binding ClearLibraryCommand}"
                                Click="OnConfirmClearLibrary"
                                AutomationProperties.Name="{Binding LibraryClearAllAutomationName}" />
                    </StackPanel>
                    <Button x:Name="ClearLibraryButton"
                            Content="{Binding LibraryClear}"
                            HorizontalAlignment="Right"
                            Click="OnClearLibrary"
                            IsEnabled="{Binding HasLibraryItems}"
                            AutomationProperties.Name="{Binding LibraryClearAutomationName}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Open Network Stream (design 6216:13614) in the modal shell Settings
             uses (Controls/ModalDialog): a dimmed backdrop, the dialog (its
             body BG/A3 as in the frame, which has the design's BG/A3
             Transparent), the 50 px header with the title and close, the URL
             field with the open error, and Cancel / Open in the footer.
             Escape, Cancel, close and the backdrop dismiss it; focus returns
             to the More button. The app opens one http or https address, so
             the design's multi-link text area is a one-line field (Enter
             opens), and the optional playlist name is left out (D2). -->
        <controls:ModalDialog x:Name="UrlPanel"
                              Grid.RowSpan="3"
                              ZIndex="30"
                              IsVisible="False"
                              Classes="fit"
                              Background="{DynamicResource Vlc.Bg.A3}"
                              CloseRequested="OnUrlDialogCloseRequested"
                              AutomationProperties.Name="Open Network Stream">
            <controls:ModalDialog.Header>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="dialogTitle"
                               Margin="10,0,12,0"
                               Text="Open Network Stream" />
                    <Button x:Name="UrlCloseButton"
                            Grid.Column="1"
                            Classes="icon dialogClose"
                            Click="OnUrlCancel"
                            ToolTip.Tip="Close (Escape)"
                            AutomationProperties.Name="Close Open Network Stream">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
            </controls:ModalDialog.Header>
            <controls:ModalDialog.Footer>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button x:Name="UrlCancelButton"
                            Classes="secondary dialogAction"
                            Content="Cancel"
                            Click="OnUrlCancel"
                            AutomationProperties.Name="Cancel opening URL" />
                    <Button x:Name="UrlSubmitButton"
                            Grid.Column="2"
                            Classes="primary dialogAction"
                            Content="Open"
                            Click="OnUrlSubmit"
                            AutomationProperties.Name="Open network URL" />
                </Grid>
            </controls:ModalDialog.Footer>
            <StackPanel Classes="dialogBody">
                <StackPanel>
                    <TextBlock Classes="dialogHeading" Text="Network URL" />
                    <TextBlock Classes="dialogHint"
                               Text="Paste an http or https media address, then press Open or Enter." />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBox x:Name="UrlTextBox"
                             Classes="dialogField"
                             Text="{Binding UrlText, Mode=TwoWay}"
                             KeyDown="OnUrlTextKeyDown"
                             PlaceholderText="e.g., https://www.example.com/stream.mp4"
                             AutomationProperties.Name="Media URL"
                             ToolTip.Tip="Only http and https URLs are supported" />
                    <TextBlock x:Name="UrlOpenError"
                               IsVisible="{Binding HasOpenError}"
                               Text="{Binding OpenError}"
                               Foreground="{DynamicResource PlayerErrorText}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="URL open error" />
                </StackPanel>
            </StackPanel>
        </controls:ModalDialog>

        <Border x:Name="ResumePanel"
                Grid.RowSpan="3"
                ZIndex="30"
                IsVisible="{Binding HasPendingResume}"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Padding="20"
                CornerRadius="18"
                Background="{DynamicResource Vlc.Bg.B1Transparent}"
                BorderBrush="{DynamicResource PlayerAccent}"
                BorderThickness="1"
                BoxShadow="0 16 42 0 #90000000">
            <StackPanel Spacing="10">
                <TextBlock Text="Resume playback"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding PendingResumeText}" FontSize="16" />
                <TextBlock x:Name="ResumeCountdown"
                           Classes="settingHint"
                           TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HasHistoryError}"
                           Text="{Binding HistoryError}"
                           Foreground="{DynamicResource PlayerErrorText}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Resume history error" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="CancelResumeAction"
                            Content="Cancel"
                            Click="OnDismissResume"
                            ToolTip.Tip="Close and keep the saved position (Esc)"
                            AutomationProperties.Name="Dismiss resume prompt" />
                    <Button x:Name="DeclineResumeAction"
                            Content="Start over"
                            Click="OnDeclineResume"
                            ToolTip.Tip="Start this media from the beginning"
                            AutomationProperties.Name="Start media over" />
                    <Button x:Name="ResumeAction"
                            Content="Resume"
                            Click="OnAcceptResume"
                            ToolTip.Tip="Resume from the saved position"
                            AutomationProperties.Name="Resume media" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="OpenErrorToast"
                Grid.RowSpan="3"
                ZIndex="30"
                IsVisible="False"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="24,52,24,0"
                Padding="10"
                Background="{DynamicResource PlayerErrorSurface}"
                CornerRadius="10">
            <TextBlock Text="{Binding OpenError}"
                       Foreground="{DynamicResource PlayerErrorText}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- The design's bar panels: one drawer whose tab set follows the
             selected tab (PlayerPresentationViewModel.Panels): Queue and
             Chapters from the queue button, Audio and Subtitles from the track
             buttons, Playback, Video and Info from the playback settings gear.
             Anchored right between the title bar and the control bar, or a
             sheet above the bar in narrow windows (ApplyDrawerLayout). -->
        <Border x:Name="QueueDrawer"
                Grid.RowSpan="3"
                ZIndex="10"
                Classes="barPanel"
                IsVisible="{Binding IsQueueOpen}"
                Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle"
                LayoutUpdated="OnQueueDrawerLayoutUpdated"
                Width="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{Binding DrawerAutomationName}">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Classes="panelTabs">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <UniformGrid x:Name="DrawerTabs"
                                     Rows="1"
                                     KeyDown="OnDrawerTabsKeyDown">
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsQueueTab}"
                                    IsVisible="{Binding IsQueuePanel}"
                                    Tag="Queue"
                                    Command="{Binding ToggleMediaControlsCommand}"
                                    CommandParameter="Queue"
                                    AutomationProperties.Name="Queue">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Queue}" />
                                    <TextBlock Text="Queue" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsChapterTab}"
                                    IsVisible="{Binding IsQueuePanel}"
                                    Tag="Chapters"
                                    Command="{Binding ToggleMediaControlsCommand}"
                                    CommandParameter="Chapters"
                                    AutomationProperties.Name="Chapters">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.List}" />
                                    <TextBlock Text="Chapters" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsAudioTab}"
                                    IsVisible="{Binding IsTracksPanel}"
                                    Tag="Audio"
                                    Command="{Binding ToggleMediaControlsCommand}"
                                    CommandParameter="Audio"
                                    AutomationProperties.Name="Audio">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Audio}" />
                                    <TextBlock Text="Audio" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsSubtitleTab}"
                                    IsVisible="{Binding IsTracksPanel}"
                                    Tag="Subtitles"
                                    Command="{Binding ToggleMediaControlsCommand}"
                                    CommandParameter="Subtitles"
                                    AutomationProperties.Name="Subtitles">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Subtitles}" />
                                    <TextBlock Text="Subtitles" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsPlaybackTab}"
                                    IsVisible="{Binding IsPlaybackPanel}"
                                    Tag="Playback"
                                    Command="{Binding ToggleMediaControlsCommand}"
                                    CommandParameter="Playback"
                                    AutomationProperties.Name="Playback">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Playback}" />
                                    <TextBlock Text="Playback" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsVideoTab}"
                                    IsVisible="{Binding IsPlaybackPanel}"
                                    Tag="Video"
                                    Command="{Binding ToggleMediaControlsCommand}"
                                    CommandParameter="Video"
                                    AutomationProperties.Name="Video">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Video}" />
                                    <TextBlock Text="Video" />
                                </StackPanel>
                            </Button>
                            <Button Classes="panelTab"
                                    Classes.selected="{Binding IsInformationTab}"
                                    IsVisible="{Binding IsPlaybackPanel}"
                                    Tag="Information"
                                    Command="{Binding MediaInformationCommand}"
                                    AutomationProperties.Name="Info">
                                <StackPanel Classes="panelTab">
                                    <controls:VlcIcon Icon="{StaticResource Icon.Info}" />
                                    <TextBlock Text="Info" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Button x:Name="CloseQueueButton"
                                Grid.Column="1"
                                Classes="icon"
                                Click="OnCloseDrawer"
                                ToolTip.Tip="Close panel (Esc)"
                                AutomationProperties.Name="Close playback drawer">
                            <controls:VlcIcon Width="20" Height="20"
                                              Icon="{StaticResource Icon.Close}" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Queue (design: "4 items" and the queue tools, then
                         30-tall rows with a drag handle and the title). -->
                    <Grid IsVisible="{Binding IsQueueTab}" RowDefinitions="Auto,*,Auto" Margin="16,8,12,8" RowSpacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelCaption"
                                       VerticalAlignment="Center"
                                       Text="{Binding QueueSummaryText}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Classes="icon"
                                        Classes.active="{Binding IsRepeatOn}"
                                        Command="{Binding CycleRepeatCommand}"
                                        ToolTip.Tip="{Binding RepeatLabel}"
                                        AutomationProperties.Name="{Binding RepeatLabel}">
                                    <Grid>
                                        <controls:VlcIcon Width="24" Height="24"
                                                          Icon="{StaticResource Icon.Repeat}" />
                                        <TextBlock Classes="repeatOne"
                                                   Text="1"
                                                   IsVisible="{Binding IsRepeatItem}" />
                                    </Grid>
                                </Button>
                                <Button Classes="icon"
                                        Classes.active="{Binding IsShuffleOn}"
                                        Command="{Binding ToggleShuffleCommand}"
                                        ToolTip.Tip="{Binding ShuffleLabel}"
                                        AutomationProperties.Name="{Binding ShuffleLabel}">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Shuffle}" />
                                </Button>
                                <Button Classes="icon"
                                        Command="{Binding SavePlaylistCommand}"
                                        ToolTip.Tip="Save playlist…"
                                        AutomationProperties.Name="Save playlist">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Save}" />
                                </Button>
                                <Button Classes="icon"
                                        Command="{Binding ClearQueueCommand}"
                                        ToolTip.Tip="Clear queue"
                                        AutomationProperties.Name="Clear queue">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Remove}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock IsVisible="{Binding IsQueueLoading}"
                                       Text="Loading queue…"
                                       Classes="settingHint"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ScrollViewer x:Name="QueueScroll"
                                          IsVisible="{Binding HasQueueItems}"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding QueueItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="application:QueueItem">
                                            <Border Classes="panelItem">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Button Classes="panelRow"
                                                            Classes.current="{Binding IsCurrent}"
                                                            Command="{Binding DataContext.SelectQueueItemCommand, ElementName=VideoArea}"
                                                            CommandParameter="{Binding Token}"
                                                            ToolTip.Tip="{Binding Name}"
                                                            AutomationProperties.Name="{Binding Name}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <!-- Design drag handle; reorder with the
                                                                 row's earlier/later buttons. -->
                                                            <Path Classes="dragHandle" Data="M0,0.5 H10 M0,4.5 H10" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                    <StackPanel Grid.Column="1" Classes="rowActions">
                                                        <Button Classes="icon rowAction"
                                                                Click="OnMoveQueueItemUp"
                                                                ToolTip.Tip="Move earlier"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Move {0} earlier in queue'}">
                                                            <controls:VlcIcon Width="20" Height="20"
                                                                              Icon="{StaticResource Icon.ChevronUp}" />
                                                        </Button>
                                                        <Button Classes="icon rowAction"
                                                                Click="OnMoveQueueItemDown"
                                                                ToolTip.Tip="Move later"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Move {0} later in queue'}">
                                                            <controls:VlcIcon Width="20" Height="20"
                                                                              Icon="{StaticResource Icon.ChevronDown}" />
                                                        </Button>
                                                        <Button Classes="icon rowAction"
                                                                Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=VideoArea}"
                                                                CommandParameter="{Binding Token}"
                                                                ToolTip.Tip="Remove from queue"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from queue'}">
                                                            <controls:VlcIcon Width="20" Height="20"
                                                                              Icon="{StaticResource Icon.Close}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <TextBlock IsVisible="{Binding HasEmptyQueue}"
                                       Text="Your queue is empty. Open or drop media to start playing."
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding HasQueueError}"
                                       Text="{Binding QueueError}"
                                       Foreground="{DynamicResource PlayerErrorText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Chapters (and titles), as track-style lists. -->
                    <ScrollViewer x:Name="ChapterScroll"
                                  IsVisible="{Binding IsChapterTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="panelPage">
                            <TextBlock Classes="panelCaption" Text="Titles and chapters" />
                            <TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}"
                                       Text="Loading media controls…"
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding AreMediaControlsUnavailable}"
                                       Text="Open media to select titles and chapters."
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}"
                                       Text="This media has no titles or chapters."
                                       Classes="panelHint" />
                            <ItemsControl ItemsSource="{Binding Titles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaTitle">
                                        <Button Classes="panelRow"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding DataContext.SelectTitleCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                                <controls:VlcIcon Classes="rowCheck"
                                                                  IsVisible="{Binding IsSelected}"
                                                                  Icon="{StaticResource Icon.Check}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Chapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaChapter">
                                        <Button Classes="panelRow"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding DataContext.SelectChapterCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                                <controls:VlcIcon Classes="rowCheck"
                                                                  IsVisible="{Binding IsSelected}"
                                                                  Icon="{StaticResource Icon.Check}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Audio (design: Embedded Tracks with a check on the
                         selected one; Output Device is not supported). -->
                    <ScrollViewer x:Name="AudioScroll"
                                  IsVisible="{Binding IsAudioTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="panelPage">
                            <TextBlock Classes="panelCaption" Text="Embedded Tracks" />
                            <TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}"
                                       Text="Loading media controls…"
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding AreMediaControlsUnavailable}"
                                       Text="Open media to select audio tracks."
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}"
                                       Text="No audio tracks are available."
                                       Classes="panelHint" />
                            <ItemsControl ItemsSource="{Binding AudioTracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaTrack">
                                        <Button Classes="panelRow"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding DataContext.SelectAudioTrackCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                                <controls:VlcIcon Classes="rowCheck"
                                                                  IsVisible="{Binding IsSelected}"
                                                                  Icon="{StaticResource Icon.Check}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="panelDivider" />
                            <TextBlock Classes="panelCaption" Text="Synchronization" />
                            <TextBlock Classes="panelLabel" Text="Audio delay (ms)" />
                            <WrapPanel>
                                <Button Classes="panelStep"
                                        Content="−100"
                                        Command="{Binding AdjustAudioDelayCommand}"
                                        CommandParameter="-100"
                                        AutomationProperties.Name="Decrease audio delay by 100 milliseconds" />
                                <NumericUpDown x:Name="AudioDelayInput"
                                               Margin="0,0,6,6"
                                               Minimum="-10000"
                                               Maximum="10000"
                                               Increment="100"
                                               Width="112"
                                               Value="{Binding AudioDelayMilliseconds, Mode=TwoWay}"
                                               AutomationProperties.Name="Audio delay milliseconds" />
                                <Button Classes="panelStep"
                                        Content="+100"
                                        Command="{Binding AdjustAudioDelayCommand}"
                                        CommandParameter="100"
                                        AutomationProperties.Name="Increase audio delay by 100 milliseconds" />
                                <Button Classes="panelStep"
                                        Content="Reset"
                                        Command="{Binding ResetAudioDelayCommand}"
                                        AutomationProperties.Name="Reset audio delay" />
                            </WrapPanel>
                            <Border Classes="panelDivider" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panelCaption"
                                           VerticalAlignment="Center"
                                           Text="External Tracks" />
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Command="{Binding AttachExternalAudioCommand}"
                                        ToolTip.Tip="Add an audio file. It plays from the next time this media opens."
                                        AutomationProperties.Name="Add audio file">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Add}" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="panelHint" Text="Adds a track only for the next media open." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Subtitles (design: Embedded Tracks, External Tracks). -->
                    <ScrollViewer x:Name="SubtitleScroll"
                                  IsVisible="{Binding IsSubtitleTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="panelPage">
                            <TextBlock Classes="panelCaption" Text="Embedded Tracks" />
                            <TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}"
                                       Text="Loading media controls…"
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding AreMediaControlsUnavailable}"
                                       Text="Open media to select subtitle tracks."
                                       Classes="panelHint" />
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}"
                                       Text="No subtitle tracks are available."
                                       Classes="panelHint" />
                            <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaTrack">
                                        <Button Classes="panelRow"
                                                Classes.selected="{Binding IsSelected}"
                                                Command="{Binding DataContext.SelectSubtitleTrackCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                                <controls:VlcIcon Classes="rowCheck"
                                                                  IsVisible="{Binding IsSelected}"
                                                                  Icon="{StaticResource Icon.Check}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="panelDivider" />
                            <TextBlock Classes="panelCaption" Text="Synchronization" />
                            <TextBlock Classes="panelLabel" Text="Subtitle delay (ms)" />
                            <WrapPanel>
                                <Button Classes="panelStep"
                                        Content="−100"
                                        Command="{Binding AdjustSubtitleDelayCommand}"
                                        CommandParameter="-100"
                                        AutomationProperties.Name="Decrease subtitle delay by 100 milliseconds" />
                                <NumericUpDown x:Name="SubtitleDelayInput"
                                               Margin="0,0,6,6"
                                               Minimum="-10000"
                                               Maximum="10000"
                                               Increment="100"
                                               Width="112"
                                               Value="{Binding SubtitleDelayMilliseconds, Mode=TwoWay}"
                                               AutomationProperties.Name="Subtitle delay milliseconds" />
                                <Button Classes="panelStep"
                                        Content="+100"
                                        Command="{Binding AdjustSubtitleDelayCommand}"
                                        CommandParameter="100"
                                        AutomationProperties.Name="Increase subtitle delay by 100 milliseconds" />
                                <Button Classes="panelStep"
                                        Content="Reset"
                                        Command="{Binding ResetSubtitleDelayCommand}"
                                        AutomationProperties.Name="Reset subtitle delay" />
                            </WrapPanel>
                            <Border Classes="panelDivider" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panelCaption"
                                           VerticalAlignment="Center"
                                           Text="External Tracks" />
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Command="{Binding AttachExternalSubtitleCommand}"
                                        ToolTip.Tip="Add a subtitle file. It shows from the next time this media opens."
                                        AutomationProperties.Name="Add subtitle file">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Add}" />
                                </Button>
                            </Grid>
                            <TextBlock Classes="panelHint" Text="Adds a track only for the next media open." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Playback (design: setting rows; only Speed is
                         supported): the value and a 0.25-2 slider with a tick
                         and a label every 0.25. -->
                    <ScrollViewer x:Name="PlaybackScroll"
                                  IsVisible="{Binding IsPlaybackTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="panelPage" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="panelLabel"
                                           VerticalAlignment="Center"
                                           Text="Speed" />
                                <Border Grid.Column="1" Classes="panelValue">
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding PlaybackRateText}" />
                                </Border>
                            </Grid>
                            <Slider x:Name="SpeedSlider"
                                    Classes="speed"
                                    Minimum="0.25"
                                    Maximum="2"
                                    SmallChange="0.25"
                                    LargeChange="0.25"
                                    TickFrequency="0.25"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding PlaybackSpeed, Mode=TwoWay}"
                                    ToolTip.Tip="{Binding PlaybackRateText}"
                                    AutomationProperties.Name="Playback speed" />
                            <controls:TickPanel Inset="6">
                                <TextBlock Classes="tickLabel" Text="0.25" />
                                <TextBlock Classes="tickLabel" Text="0.5" />
                                <TextBlock Classes="tickLabel" Text="0.75" />
                                <TextBlock Classes="tickLabel" Text="1" />
                                <TextBlock Classes="tickLabel" Text="1.25" />
                                <TextBlock Classes="tickLabel" Text="1.5" />
                                <TextBlock Classes="tickLabel" Text="1.75" />
                                <TextBlock Classes="tickLabel" Text="2" />
                            </controls:TickPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer IsVisible="{Binding IsVideoTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <views:VideoAdjustmentsView Margin="16,12" DataContext="{Binding VideoAdjustments}" />
                    </ScrollViewer>

                    <Grid IsVisible="{Binding IsInformationTab}" RowDefinitions="*,Auto" RowSpacing="10" Margin="16,12">
                        <ScrollViewer x:Name="InformationScroll"
                                      HorizontalScrollBarVisibility="Disabled">
                            <views:MediaInformationView DataContext="{Binding MediaInformation}" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <WrapPanel>
                                <Button Margin="0,0,8,0"
                                        Content="Refresh"
                                        Command="{Binding MediaInformationCommand}" />
                                <Button Content="Copy diagnostics"
                                        Command="{Binding CopyDiagnosticsCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding CopyStatus}"
                                       IsVisible="{Binding HasCopyStatus}"
                                       Classes="panelHint" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="2">
                    <ScrollViewer MaxHeight="80"
                                  Margin="16,0,16,8"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="HasMediaCapabilitiesError" />
                                <Binding Path="HasMediaControlsNotice" />
                            </MultiBinding>
                        </ScrollViewer.IsVisible>
                        <StackPanel Spacing="4">
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesError}"
                                       Text="{Binding MediaCapabilitiesError}"
                                       Foreground="{DynamicResource PlayerErrorText}"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasMediaControlsNotice}"
                                       Text="{Binding MediaControlsNotice}"
                                       Foreground="{DynamicResource PlayerAccentText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Design: "Show Preferences" at the foot of the tracks
                         panel; opens the matching Settings page. -->
                    <Button x:Name="ShowPreferencesButton"
                            Classes="panelFooter"
                            Content="Show Preferences"
                            IsVisible="{Binding IsTracksPanel}"
                            Click="OnShowPreferences"
                            ToolTip.Tip="Open the audio and subtitle settings" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The design's control bar (design spec "Control bar"): one row of
             transport, timeline, volume and tool groups. Docked below the
             video in a window; in fullscreen it overlays the video and
             auto-hides. PlayerLayoutPolicy drops secondary controls as the
             window narrows. -->
        <Border x:Name="PlayerDock"
                Grid.Row="2"
                Classes="playerBar"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch">
            <Grid x:Name="DockGrid"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="20">
                <StackPanel x:Name="TransportGroup"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousButton"
                            Classes="transport"
                            Command="{Binding PreviousCommand}"
                            AutomationProperties.Name="Previous queue item"
                            ToolTip.Tip="Previous queue item">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Previous}" />
                    </Button>
                    <Button x:Name="PlayButton"
                            Classes="primary play"
                            Command="{Binding TogglePauseCommand}"
                            AutomationProperties.Name="{Binding PlayPauseName}"
                            ToolTip.Tip="{Binding PlayPauseToolTip}">
                        <Grid>
                            <controls:VlcIcon Width="24" Height="24"
                                              IsVisible="{Binding !IsPlaying}"
                                              Icon="{StaticResource Icon.Play}" />
                            <controls:VlcIcon Width="24" Height="24"
                                              IsVisible="{Binding IsPlaying}"
                                              Icon="{StaticResource Icon.Pause}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton"
                            Classes="transport"
                            Command="{Binding NextCommand}"
                            AutomationProperties.Name="Next queue item"
                            ToolTip.Tip="Next queue item">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Next}" />
                    </Button>
                    <!-- Not in the design's default bar, but in its customize
                         palette; kept so Stop stays one click away. -->
                    <Button x:Name="StopButton"
                            Classes="transport"
                            Command="{Binding StopCommand}"
                            AutomationProperties.Name="Stop playback"
                            ToolTip.Tip="Stop playback">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Stop}" />
                    </Button>
                </StackPanel>

                <Grid x:Name="TimelineGroup"
                      Grid.Column="1"
                      ColumnDefinitions="Auto,*,Auto"
                      VerticalAlignment="Center">
                    <TextBlock x:Name="ElapsedLabel"
                               Classes="barTime"
                               Margin="0,0,8,0"
                               Text="{Binding ElapsedText}" />
                    <controls:PlayerTimeline x:Name="PlayerTimeline"
                                             Grid.Column="1"
                                             Classes="timeline monochrome"
                                             Minimum="0"
                                             Maximum="1"
                                             SmallChange="{Binding SeekStep}"
                                             Value="{Binding Position, Mode=TwoWay}"
                                             IsEnabled="{Binding CanSeek}"
                                             AutomationProperties.Name="Playback position"
                                             AutomationProperties.HelpText="Use left and right arrow keys to seek."
                                             SeekStarted="OnSeekStarted"
                                             SeekCommitted="OnSeekCommitted" />
                    <!-- Seek preview, above the bar while dragging. -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding IsSeeking}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,-34,0,0"
                            Padding="7,3"
                            CornerRadius="6"
                            Background="{DynamicResource Vlc.Bg.B1Transparent}">
                        <TextBlock Text="{Binding SeekPreviewText}"
                                   FontSize="11"
                                   FontFeatures="tnum" />
                    </Border>
                    <TextBlock x:Name="DurationLabel"
                               Grid.Column="2"
                               Classes="barTime"
                               Margin="8,0,0,0"
                               Text="{Binding DurationText}" />
                </Grid>

                <StackPanel x:Name="VolumeGroup"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="MuteButton"
                            Classes="icon"
                            Command="{Binding ToggleMuteCommand}"
                            AutomationProperties.Name="{Binding MuteName}"
                            ToolTip.Tip="{Binding MuteName}">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{Binding VolumeLevel, Converter={x:Static controls:VolumeIconConverter.Instance}}" />
                    </Button>
                    <!-- The level shows in the tooltip and through automation
                         (0-200 %); the fill turns bright above 100 %. -->
                    <controls:PlayerVolumeSlider x:Name="PlayerVolume"
                                                 Classes="volume monochrome"
                                                 Minimum="0"
                                                 Maximum="200"
                                                 IsEnabled="{Binding HasPlayableMedia}"
                                                 TickFrequency="100"
                                                 SmallChange="2"
                                                 LargeChange="10"
                                                 Value="{Binding Volume, Mode=TwoWay}"
                                                 AutomationProperties.Name="Volume"
                                                 AutomationProperties.HelpText="0 to 200 percent. Values above 100 percent are amplified."
                                                 ToolTip.Tip="{Binding VolumeText}"
                                                 DragStarted="OnVolumeDragStarted"
                                                 DragCompleted="OnVolumeDragCompleted" />
                </StackPanel>

                <!-- Tools: each opens its bar panel (the drawer's tab set for
                     that button) and shows the accent state while it is open. -->
                <StackPanel x:Name="ToolsGroup"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Button x:Name="AudioTracksButton"
                            Classes="icon"
                            Classes.active="{Binding IsAudioPanelOpen}"
                            Click="OnBarPanelButtonClick"
                            Command="{Binding ToggleDrawerPanelCommand}"
                            CommandParameter="Audio"
                            ToolTip.Tip="Audio tracks and synchronization"
                            AutomationProperties.Name="Audio tracks">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Audio}" />
                    </Button>
                    <Button x:Name="SubtitleTracksButton"
                            Classes="icon"
                            Classes.active="{Binding IsSubtitlePanelOpen}"
                            Click="OnBarPanelButtonClick"
                            Command="{Binding ToggleDrawerPanelCommand}"
                            CommandParameter="Subtitles"
                            ToolTip.Tip="Subtitle tracks and synchronization"
                            AutomationProperties.Name="Subtitle tracks">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Subtitles}" />
                    </Button>
                    <Button x:Name="PlaybackSettingsButton"
                            Classes="icon"
                            Classes.active="{Binding IsPlaybackPanelOpen}"
                            Click="OnBarPanelButtonClick"
                            Command="{Binding ToggleDrawerPanelCommand}"
                            CommandParameter="Playback"
                            ToolTip.Tip="Playback settings: speed, video adjustments and media information"
                            AutomationProperties.Name="Playback settings">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Settings}" />
                    </Button>
                    <Button x:Name="QueueButton"
                            Classes="icon"
                            Classes.active="{Binding IsQueuePanelOpen}"
                            Click="OnBarPanelButtonClick"
                            Command="{Binding ToggleDrawerPanelCommand}"
                            CommandParameter="Queue"
                            ToolTip.Tip="Playback queue (Ctrl+J)"
                            AutomationProperties.Name="Open playback queue">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Lists}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:SettingsView x:Name="SettingsPanel"
                            Grid.RowSpan="3"
                            ZIndex="30"
                            IsVisible="False" />
    </Grid>
</Window>
