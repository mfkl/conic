<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VLCAvalonia.Controls.WindowCaptionButtons">
    <!-- Windows-standard 46x34 caption hit targets, drawn in-app so the
         caption matches the dark chrome instead of the light system one. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimize" AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize">
            <PathIcon Width="10" Height="10" Data="M0,5 H10 V6 H0 Z" />
        </Button>
        <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximize" AutomationProperties.Name="Maximize" ToolTip.Tip="Maximize">
            <PathIcon x:Name="MaximizeIcon" Width="10" Height="10" Data="M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z" />
        </Button>
        <Button x:Name="CloseButton" Classes="caption close" Click="OnClose" AutomationProperties.Name="Close" ToolTip.Tip="Close">
            <PathIcon Width="10" Height="10" Data="M0,0 H1.41 L5,3.59 8.59,0 H10 V1.41 L6.41,5 10,8.59 V10 H8.59 L5,6.41 1.41,10 H0 V8.59 L3.59,5 0,1.41 Z" />
        </Button>
    </StackPanel>
</UserControl>
