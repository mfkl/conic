<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VLCAvalonia.ViewModels"
             x:Class="VLCAvalonia.Views.VideoAdjustmentsView"
             x:DataType="vm:VideoAdjustmentsViewModel" x:CompileBindings="True">
    <!-- Shown in the playback settings panel's Video tab, which names it. -->
    <StackPanel Spacing="12">
        <TextBlock IsVisible="{Binding !Available}" Text="Play a video to adjust its picture." Classes="panelHint" />
        <StackPanel IsVisible="{Binding Available}" Spacing="14">
            <StackPanel Spacing="6"><TextBlock Classes="panelLabel" Text="Aspect ratio" /><ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding Aspect, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Aspect ratio" /></StackPanel>
            <StackPanel Spacing="6"><TextBlock Classes="panelLabel" Text="Crop" /><ComboBox ItemsSource="{Binding Crops}" SelectedItem="{Binding Crop, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Video crop" /></StackPanel>
            <StackPanel Spacing="6"><TextBlock Classes="panelLabel" Text="Zoom" /><ComboBox ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Video zoom" /></StackPanel>
            <TextBlock Text="Fit keeps the picture inside the window. Fixed sizes may extend beyond its edges." Classes="panelHint" />
            <Button Content="Reset video adjustments" Click="OnReset" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</UserControl>
