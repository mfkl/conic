<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>libvlc_avalonia_plugin</AssemblyName>
    <RootNamespace>Conic.Vout</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\VideoGeometry.cs" Link="Interop\VideoGeometry.cs" />
    <Compile Include="..\Shared\SubtitleComposer.cs" Link="Interop\SubtitleComposer.cs" />
    <ProjectReference Include="..\..\external\vlclr\src\VLCLR\VLCLR.csproj" />
  </ItemGroup>

  <!-- Windows: the D3D11 video output plus the playlist control interface. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);CONIC_D3D11</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.20348-beta1" />
    <DirectPInvoke Include="libvlccore" />
    <NativeLibrary Include="..\..\external\vlclr\lib\libvlccore.lib" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64'">
    <Compile Remove="CompositionVoutPlugin.cs;D3D11*.cs" />
  </ItemGroup>

  <!-- macOS: the IOSurface video output plus the playlist control interface.
       libvlccore is bound at load time to the core that loaded the plugin. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <DefineConstants>$(DefineConstants);CONIC_IOSURFACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <Compile Include="..\Shared\MacOS\CoreVideo.cs" Link="MacOS\CoreVideo.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('osx-'))">
    <Compile Remove="IOSurfaceVoutPlugin.cs" />
  </ItemGroup>

  <!-- Linux: the playlist control interface only. The GPU video output is not
       implemented yet, so VLC must be started with another video output. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Compile Include="..\Shared\Linux\VaApi.cs" Link="Linux\VaApi.cs" />
  </ItemGroup>

  <Target Name="RequireImplementedPluginTarget" BeforeTargets="PrepareForBuild"
          Condition="'$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'linux-x64' and '$(RuntimeIdentifier)' != 'osx-arm64' and '$(RuntimeIdentifier)' != 'osx-x64'">
    <Error Text="Conic.Vout targets win-x64, linux-x64, osx-arm64 and osx-x64. The VLC ABI for $(RuntimeIdentifier) has not been validated." />
  </Target>

</Project>
