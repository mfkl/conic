<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Conic.Controls">
    <!-- Control styles from the Figma design (design/figma/spec.md). Colors
         come from Styles/PlayerPalette.axaml: the Vlc.* tokens, the Player*
         aliases, and the Fluent control resources mapped onto them there.

         Fluent paints a Button's hover, pressed and disabled states on its
         template's ContentPresenter, so a state color set on the Button itself
         does not show; state styles below target the presenter. Buttons with a
         transparent background get the shared Vlc.Overlay.Hover/Pressed from the
         palette's Button* resources without a style of their own.

         Classes for new screens:
           Button.icon, ToggleButton.icon   30x32 icon button (24 icon)
           Button.primary                   accent fill
           Button.secondary                 the plain button look, explicitly
           TextBox.search                   search field with a leading icon
           Slider.timeline, Slider.volume   player sliders
           Slider.speed                     0.25-2 speed slider with ticks
           Border.barPanel, Button.panelTab bar panel surface and tabs
           Button.panelRow, Border.panelItem 30-tall panel rows
           CheckBox                         every CheckBox is an ON/OFF toggle -->
    <Styles.Resources>
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
        <!-- A slider part: a transparent hit area with an inset fill drawn in
             the part's Background (Padding sets the inset). -->
        <ControlTheme x:Key="PlayerSliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="PlayerSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Buttons ............................................................ -->

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- Accent fill (design: play pill, primary actions). The label stays dark
         on every state; disabled drops to a neutral fill. -->
    <Style Selector="Button.primary, Button.openMedia, Button.play">
        <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.openMedia:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayerAccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.openMedia:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayerAccentPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.OnAccent}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.openMedia:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.play:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A1}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="Button.openMedia">
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="Height" Value="48" />
        <!-- Fixed height, so the label has to be centered in it. -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The control bar's play pill: 54x28, a centered 24 icon. -->
    <Style Selector="Button.play">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Design icon button: 30x32, radius 4, 24 icon in FG/A2; accent when
         checked or marked .active. -->
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="3,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="ToggleButton.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="Button.icon.active /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
    </Style>
    <Style Selector="Button.icon.active:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentTextHover}" />
    </Style>
    <Style Selector="Button.icon.active:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentTextHover}" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A4}" />
    </Style>

    <!-- Player icon buttons over the video and in the title row. Fixed boxes
         with a 24 content area, so icons need no margins. -->
    <Style Selector="Button.iconChrome">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Control bar transport buttons (previous, next, stop): 30x28. -->
    <Style Selector="Button.transport">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>
    <!-- Disabled transport controls stay quiet. -->
    <Style Selector="Button.transport:disabled">
        <Setter Property="Opacity" Value="0.48" />
    </Style>
    <Style Selector="Button.transport:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Text buttons: secondary labels in FG/A2 that brighten on hover. -->
    <Style Selector="Button.playbackAction">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>
    <!-- Menus ............................................................ -->

    <!-- The design's menus (More 6062:13354, right-click 6065:13616): an
         opaque BG/A3 surface (the design's BG/A3 Transparent without its
         blur), padding 4, 48-tall options with a 24 accent icon, the label in
         14 FG/2, a right-aligned shortcut hint in FG/A2 (FG/A3 is below 4.5:1
         on the surface) or a chevron for a submenu, and full-width
         separators. The More menu is a Border of MenuRow buttons (it hosts the
         speed selector and the always-on-top toggle); context menus and menu
         flyouts are Fluent's MenuItem, recolored through the MenuFlyout*
         resources in Styles/PlayerPalette.axaml and sized here. -->
    <Style Selector="Border.menuSurface">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Bright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ContextMenu, MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Bright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.menuSurface">
        <Setter Property="BoxShadow" Value="0 8 15 0 #75000000" />
    </Style>
    <Style Selector="controls|MenuRow">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MenuRow">
                <Border Name="PART_Row"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10">
                        <controls:VlcIcon Name="PART_Icon"
                                          Width="24" Height="24"
                                          VerticalAlignment="Center"
                                          Icon="{TemplateBinding Icon}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextTrimming="CharacterEllipsis" />
                        <TextBlock Name="PART_Shortcut"
                                   Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Shortcut}"
                                   IsVisible="{TemplateBinding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <controls:VlcIcon Name="PART_Chevron"
                                          Grid.Column="2"
                                          Width="24" Height="24"
                                          VerticalAlignment="Center"
                                          IsVisible="{TemplateBinding HasSubmenu}"
                                          Icon="{StaticResource Icon.ChevronRight}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|MenuRow /template/ controls|VlcIcon#PART_Icon">
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
    </Style>
    <Style Selector="controls|MenuRow /template/ TextBlock#PART_Shortcut">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="controls|MenuRow /template/ controls|VlcIcon#PART_Chevron">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="controls|MenuRow:pointerover, controls|MenuRow:focus-visible">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="controls|MenuRow:pointerover /template/ TextBlock#PART_Shortcut, controls|MenuRow:focus-visible /template/ TextBlock#PART_Shortcut">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="controls|MenuRow:pointerover /template/ controls|VlcIcon#PART_Chevron, controls|MenuRow:focus-visible /template/ controls|VlcIcon#PART_Chevron">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="controls|MenuRow:pressed">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Pressed}" />
    </Style>
    <Style Selector="controls|MenuRow:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
    </Style>
    <Style Selector="controls|MenuRow:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="controls|MenuRow:disabled /template/ controls|VlcIcon#PART_Icon">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A4}" />
    </Style>
    <!-- A More menu row that holds a control (speed, always on top): the
         same 24 icon column and 14 label. -->
    <Style Selector="Grid.menuControlRow">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="16,0,14,0" />
        <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.menuControlRow > controls|VlcIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
    </Style>
    <Style Selector="Grid.menuControlRow > TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="Grid.menuControlRow > CheckBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="Border.menuSeparator">
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Bright}" />
    </Style>
    <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator, MenuItem Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Bright}" />
    </Style>
    <!-- Recent entries in the More menu's Open Recent page. -->
    <Style Selector="Button.recentItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="Button.recentRemove">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>
    <!-- Context menus and flyouts: Fluent's MenuItem at the design's size. -->
    <Style Selector="MenuItem">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="MenuItem /template/ ContentControl#PART_IconPresenter">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="MenuItem:disabled /template/ ContentControl#PART_IconPresenter">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="24,0,0,0" />
    </Style>
    <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
        <Setter Property="Margin" Value="24,0,4,0" />
    </Style>
    <Style Selector="controls|VlcIcon.menuIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
    </Style>

    <!-- Dialogs .......................................................... -->

    <!-- Controls/ModalDialog, the shell of Settings (999:5047) and Open
         Network Stream (6216:13614): a dimmed backdrop, a surface of at most
         1048x865 kept 48 below the top (clear of the title bar), radius 14,
         the design's shadow, a 50 tall BG/B2 header and an optional footer
         padded 20. The surface is opaque: without the design's backdrop blur
         its 95 % (80 % in Light) let the screen behind show through. The
         shadow is on a childless Border behind the content, because offscreen
         captures above 100 % scale misplace the children of a shadowed
         Border. .fit sizes the dialog to its content; :compact (narrower
         than 720) fills the window. -->
    <Style Selector="controls|ModalDialog">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B1}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:ModalDialog">
                <Panel>
                    <Border Name="PART_Scrim" Background="{DynamicResource Vlc.Overlay.Scrim}" />
                    <Panel Name="PART_Dialog" KeyboardNavigation.TabNavigation="Cycle">
                        <Border Name="PART_Surface" Background="{TemplateBinding Background}" />
                        <Border Name="PART_Frame">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Border Name="PART_Header">
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Center" />
                                </Border>
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Grid.Row="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" />
                                <ContentPresenter Name="PART_FooterPresenter"
                                                  Grid.Row="2"
                                                  Padding="20"
                                                  Content="{TemplateBinding Footer}"
                                                  IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                  HorizontalContentAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|ModalDialog /template/ Panel#PART_Dialog">
        <Setter Property="MaxWidth" Value="1048" />
        <Setter Property="MaxHeight" Value="865" />
        <Setter Property="Margin" Value="24,48,24,24" />
    </Style>
    <Style Selector="controls|ModalDialog.fit /template/ Panel#PART_Dialog">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- .narrow: a short dialog (Jump to Time, About), 480 wide. -->
    <Style Selector="controls|ModalDialog.narrow /template/ Panel#PART_Dialog">
        <Setter Property="MaxWidth" Value="480" />
    </Style>
    <Style Selector="controls|ModalDialog /template/ Border#PART_Surface">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="0 8 15 0 #75000000" />
    </Style>
    <Style Selector="controls|ModalDialog /template/ Border#PART_Frame">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="controls|ModalDialog /template/ Border#PART_Header">
        <Setter Property="Height" Value="50" />
        <Setter Property="CornerRadius" Value="14,14,0,0" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
    </Style>
    <Style Selector="controls|ModalDialog:compact /template/ Panel#PART_Dialog">
        <Setter Property="MaxWidth" Value="Infinity" />
        <Setter Property="MaxHeight" Value="Infinity" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="controls|ModalDialog:compact /template/ Border#PART_Surface">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="controls|ModalDialog:compact /template/ Border#PART_Frame, controls|ModalDialog:compact /template/ Border#PART_Header">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <!-- Header: the title (14 FG/A1) and the 32x32 close button. -->
    <Style Selector="TextBlock.dialogTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A1}" />
    </Style>
    <Style Selector="Button.icon.dialogClose">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Body: sections padded 20 (22 at the top), a 16 Medium FG/2 heading,
         a 14 FG/A2 hint, BG/B2 fields and Divider/Dim lines between
         sections. -->
    <Style Selector="StackPanel.dialogBody">
        <Setter Property="Margin" Value="20,22,20,8" />
        <Setter Property="Spacing" Value="20" />
    </Style>
    <Style Selector="TextBlock.dialogHeading">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="TextBlock.dialogHint">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="TextBox.dialogField">
        <Setter Property="MinHeight" Value="37" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.dialogField /template/ Border#PART_BorderElement, TextBox.dialogField:pointerover /template/ Border#PART_BorderElement, TextBox.dialogField:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
    </Style>
    <Style Selector="Border.dialogDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Dim}" />
    </Style>
    <!-- Footer: 100x32 actions, Cancel at the start and the action at the
         end. -->
    <Style Selector="Button.dialogAction">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Bar panels .......................................................... -->

    <!-- Design: the panels the control bar's tools open (queue, tracks,
         playback settings) and the library drawer. A solid BG/B1 surface with
         a Divider/Dim rim; .docked (right-anchored) keeps only the left
         corners round. -->
    <Style Selector="Border.barPanel">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Dim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 8 15 0 #75000000" />
    </Style>
    <Style Selector="Border.barPanel.docked">
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <!-- Tab row: icon + label tabs sharing the width, a Divider/Dim line
         below; the selected tab is accent with a 2 px accent underline. -->
    <Style Selector="Border.panelTabs">
        <Setter Property="Padding" Value="8,0,6,0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Dim}" />
    </Style>
    <Style Selector="Button.panelTab">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="Button.panelTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Bright}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="Button.panelTab.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentText}" />
    </Style>
    <Style Selector="Button.panelTab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.panelTab.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentTextHover}" />
    </Style>
    <Style Selector="Button.panelTab:focus-visible">
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="StackPanel.panelTab">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.panelTab > controls|VlcIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.panelTab > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Content: pages padded 16,12; FG/A3 section captions, FG/A2 labels,
         hints and dividers between sections. -->
    <Style Selector="StackPanel.panelPage">
        <Setter Property="Margin" Value="16,12,12,12" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.panelCaption">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,2,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="TextBlock.panelLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="TextBlock.panelHint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="TextBlock.rowDetail">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="Border.panelDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Dim}" />
    </Style>
    <!-- 30-tall rows (queue items, tracks, chapters, library entries). The
         selected track shows the accent check; the current queue item is
         accent. -->
    <Style Selector="Button.panelRow">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="Button.panelRow.selected">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="Button.panelRow.current">
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentText}" />
    </Style>
    <Style Selector="Button.panelRow.current:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentTextHover}" />
    </Style>
    <Style Selector="controls|VlcIcon.rowCheck">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
    </Style>
    <Style Selector="Path.dragHandle">
        <Setter Property="Width" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{DynamicResource Vlc.Fg.A3}" />
        <Setter Property="StrokeThickness" Value="1.25" />
    </Style>
    <!-- A row with actions (queue, library): the whole row highlights and
         the actions show on hover or keyboard focus, like Home's cards. -->
    <Style Selector="Border.panelItem">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.panelItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
    </Style>
    <Style Selector="Border.panelItem Button.panelRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel.rowActions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.panelItem:pointerover StackPanel.rowActions, Border.panelItem:focus-within StackPanel.rowActions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.icon.rowAction">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <!-- Repeat one: a small "1" on the repeat icon. -->
    <Style Selector="TextBlock.repeatOne">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Delay steps, the value field and the full-width footer button. -->
    <Style Selector="Button.panelStep">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.panelValue">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
    </Style>
    <Style Selector="Border.panelValue > TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="Button.panelFooter">
        <Setter Property="Margin" Value="12,0,12,12" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A5}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="TextBlock.tickLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>


    <!-- Control bar (design: 54 tall, BG/A3, padding 11 vertical; the
         horizontal padding and the group gap follow PlayerLayoutPolicy). -->
    <Style Selector="Border.playerBar">
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A3}" />
    </Style>
    <!-- Elapsed and duration: 15 px FG/A2 in a 76 wide box. -->
    <Style Selector="TextBlock.barTime">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>

    <!-- Title bar (design: 40 tall, padding 6, items centered). The bar's
         background differs per screen and is set where it is used. -->
    <Style Selector="Border.titleBar">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <!-- Title bar buttons: 28x28 with a 24 icon. -->
    <Style Selector="Button.titleBar">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>
    <Style Selector="TextBlock.windowTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>
    <!-- 1x16 separator between title bar groups (design "divider" icon). -->
    <Style Selector="Border.titleDivider">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Bright}" />
    </Style>

    <!-- Window caption buttons (Windows/Linux): 36x24, a 24 icon in FG/A2. -->
    <Style Selector="Button.caption">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
    </Style>
    <!-- Close adopts the standard red hover so the affordance stays familiar. -->
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PlayerDanger}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Keyboard focus: an accent ring on every button (on top of Fluent's
         focus adorner); accent-filled buttons keep their fill and take a light
         ring instead. -->
    <Style Selector="Button:focus-visible">
        <Setter Property="Background" Value="{DynamicResource PlayerSelection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.primary:focus-visible, Button.openMedia:focus-visible, Button.play:focus-visible">
        <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="ToggleButton.icon:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Text input ......................................................... -->

    <Style Selector="TextBox, NumericUpDown">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <controls:VlcIcon Width="20" Height="20" Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Foreground="{DynamicResource Vlc.Fg.A3}"
                                  Icon="{DynamicResource Icon.Search}" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- CheckBox as the design's toggle: label on the left, a 68x32 BG/B2
         switch on the right with an ON/OFF label and a knob that turns accent
         when on. Still a CheckBox for input and automation. -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}" ColumnDefinitions="*,Auto">
                    <ContentPresenter x:Name="ToggleContent"
                                      Margin="0,0,12,0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Border x:Name="ToggleTrack"
                            Grid.Column="1"
                            Width="68"
                            Height="32"
                            Padding="3"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="{DynamicResource Vlc.Bg.B2}"
                            VerticalAlignment="Center">
                        <Panel>
                            <TextBlock x:Name="ToggleOffLabel"
                                       Text="OFF"
                                       Margin="0,0,6,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Vlc.Fg.A3}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ToggleOnLabel"
                                       Text="ON"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsVisible="False"
                                       Foreground="{DynamicResource PlayerAccentText}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <Border x:Name="ToggleKnob"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource Vlc.Fg.A4}" />
                        </Panel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#ToggleKnob">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
    </Style>
    <Style Selector="CheckBox:indeterminate /template/ Border#ToggleKnob">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox:checked /template/ TextBlock#ToggleOffLabel, CheckBox:indeterminate /template/ TextBlock#ToggleOffLabel">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="CheckBox:checked /template/ TextBlock#ToggleOnLabel">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#ToggleTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Bright}" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#ToggleKnob">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#ToggleKnob">
        <Setter Property="Background" Value="{DynamicResource PlayerAccentHover}" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ Border#ToggleKnob">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.A2}" />
    </Style>
    <Style Selector="CheckBox:checked:pressed /template/ Border#ToggleKnob">
        <Setter Property="Background" Value="{DynamicResource PlayerAccentPressed}" />
    </Style>
    <Style Selector="CheckBox:focus-visible /template/ Border#ToggleTrack">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <Style Selector="CheckBox:disabled /template/ Border#ToggleTrack">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Lists, progress, menus ............................................. -->

    <!-- Selected rows: BG/A1 with FG/1. -->
    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A1}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Bright}" />
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A4}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource PlayerAccent}" />
        <Setter Property="Background" Value="{DynamicResource PlayerTrack}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Reduce motion (MainWindow's reduced-motion class): no scaling and no
         sliding bar. Theming/ReducedMotion turns off every transition; the
         pressed scale is a theme setter, and the indeterminate bar a keyframe
         animation, so they go here. The "Opening …" text stays. -->
    <Style Selector=":is(Window).reduced-motion :is(Button):pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector=":is(Window).reduced-motion ProgressBar.openingIndicator">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Sliders ............................................................ -->

    <!-- Timeline per the design: a 28-tall BG/B2 track (radius 6), the played
         part inset 2 in BG/Accent Bright (radius 4), an 8x24 accent handle at
         its end. The control's Background is the track. Every state is set
         here because Fluent's Slider theme styles the same named parts. -->
    <Style Selector="Slider.timeline">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="{TemplateBinding Padding}">
                    <Border x:Name="TrackBackground"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="{TemplateBinding Background}" />
                    <Track Name="PART_Track" Orientation="Horizontal" Margin="2,0"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlayerSliderFill}" Padding="0,2" CornerRadius="4" />
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Theme="{StaticResource PlayerSliderThumb}" Width="8" Height="24" CornerRadius="4" />
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlayerSliderFill}" />
                        </Track.IncreaseButton>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider.timeline /template/ RepeatButton#PART_DecreaseButton, Slider.timeline:pointerover /template/ RepeatButton#PART_DecreaseButton, Slider.timeline:pressed /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.AccentBright}" />
    </Style>
    <Style Selector="Slider.timeline /template/ RepeatButton#PART_IncreaseButton, Slider.timeline:pointerover /template/ RepeatButton#PART_IncreaseButton, Slider.timeline:pressed /template/ RepeatButton#PART_IncreaseButton, Slider.timeline:disabled /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Slider.timeline /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
    </Style>
    <Style Selector="Slider.timeline:pointerover /template/ Thumb, Slider.timeline:pressed /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PlayerAccentHover}" />
    </Style>
    <Style Selector="Slider.timeline:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A1}" />
    </Style>
    <Style Selector="Slider.timeline:disabled /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.A4}" />
    </Style>

    <!-- Volume (design: 88x28): the same dark track at 20 tall with an accent
         fill (bright above 100 %) and a light 6-wide handle that stays visible
         on both. -->
    <Style Selector="Slider.volume">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="{TemplateBinding Padding}">
                    <Border x:Name="TrackBackground"
                            Height="20"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="{TemplateBinding Background}" />
                    <Track Name="PART_Track" Orientation="Horizontal" Margin="2,0"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlayerSliderFill}" Height="28" VerticalAlignment="Center"
                                          Padding="0,6" CornerRadius="3" />
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Theme="{StaticResource PlayerSliderThumb}" Width="6" Height="20" CornerRadius="3" />
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlayerSliderFill}" Height="28" VerticalAlignment="Center" />
                        </Track.IncreaseButton>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider.volume /template/ RepeatButton#PART_DecreaseButton, Slider.volume:pointerover /template/ RepeatButton#PART_DecreaseButton, Slider.volume:pressed /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
    </Style>
    <Style Selector="Slider.volume:amplified /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource PlayerAmplified}" />
    </Style>
    <Style Selector="Slider.volume /template/ RepeatButton#PART_IncreaseButton, Slider.volume:pointerover /template/ RepeatButton#PART_IncreaseButton, Slider.volume:pressed /template/ RepeatButton#PART_IncreaseButton, Slider.volume:disabled /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Slider.volume /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.2}" />
    </Style>
    <Style Selector="Slider.volume:pointerover /template/ Thumb, Slider.volume:pressed /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.1}" />
    </Style>
    <Style Selector="Slider.volume:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.A4}" />
    </Style>
    <Style Selector="Slider.volume:disabled /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.A3}" />
    </Style>
    <!-- Playback speed (design: Playback panel): an 8-tall BG/B2 track with a
         tick every 0.25, the part up to the value in BG/Accent Bright and an
         8x20 accent handle. The TickPanel inset is the Track margin plus half
         the handle, so the ticks sit under the handle's stops. -->
    <Style Selector="Slider.speed">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="{TemplateBinding Padding}">
                    <Border x:Name="TrackBackground"
                            Height="8"
                            VerticalAlignment="Center"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Background="{TemplateBinding Background}" />
                    <controls:TickPanel Inset="6" Height="4" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                        <Border Classes="speedTick" />
                    </controls:TickPanel>
                    <Track Name="PART_Track" Orientation="Horizontal" Margin="2,0"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlayerSliderFill}" Padding="0,8" CornerRadius="4" />
                        </Track.DecreaseButton>
                        <Track.Thumb>
                            <Thumb Theme="{StaticResource PlayerSliderThumb}" Width="8" Height="20" CornerRadius="3" />
                        </Track.Thumb>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlayerSliderFill}" />
                        </Track.IncreaseButton>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider.speed /template/ Border.speedTick">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Vlc.Fg.A4}" />
    </Style>
    <Style Selector="Slider.speed /template/ RepeatButton#PART_DecreaseButton, Slider.speed:pointerover /template/ RepeatButton#PART_DecreaseButton, Slider.speed:pressed /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Vlc.Bg.AccentBright}" />
    </Style>
    <Style Selector="Slider.speed /template/ RepeatButton#PART_IncreaseButton, Slider.speed:pointerover /template/ RepeatButton#PART_IncreaseButton, Slider.speed:pressed /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Slider.speed /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
    </Style>
    <Style Selector="Slider.speed:pointerover /template/ Thumb, Slider.speed:pressed /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource PlayerAccentHover}" />
    </Style>
    <!-- Keyboard focus outlines the track in accent. -->
    <Style Selector="Slider.timeline:focus-visible /template/ Border#TrackBackground, Slider.volume:focus-visible /template/ Border#TrackBackground, Slider.speed:focus-visible /template/ Border#TrackBackground">
        <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
    </Style>

    <!-- Layout density and text ............................................ -->

    <Style Selector="TextBlock.settingHint">
        <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</Styles>
