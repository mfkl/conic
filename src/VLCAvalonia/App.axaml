<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VLCAvalonia.App"
             Name="VLC Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://VLCAvalonia/Styles/PlayerPalette.axaml" />
                <ResourceInclude Source="avares://VLCAvalonia/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Accent/Main from Styles/PlayerPalette.axaml (Vlc.Accent.Main). -->
                <ColorPaletteResources x:Key="Dark" Accent="#D37918" />
                <ColorPaletteResources x:Key="Light" Accent="#D37918" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://VLCAvalonia/Styles/PlayerChrome.axaml" />
    </Application.Styles>
</Application>
