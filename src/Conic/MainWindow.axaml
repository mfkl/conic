<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Conic.Controls"
        xmlns:viewModels="clr-namespace:Conic.ViewModels"
        xmlns:application="clr-namespace:Player.Application;assembly=Player.Application"
        xmlns:input="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
        xmlns:views="clr-namespace:Conic.Views"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="720"
        x:Class="Conic.MainWindow"
        x:DataType="viewModels:PlayerPresentationViewModel"
        Title="Conic"
        Icon="avares://Conic/Assets/conic.ico"
        MinWidth="480"
        MinHeight="360"
        Background="{DynamicResource PlayerCanvas}"
        RequestedThemeVariant="Dark"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

    <Grid x:Name="VideoArea"
          Background="{DynamicResource PlayerCanvas}"
          PointerMoved="OnPlayerInteraction"
          PointerPressed="OnVideoPointerPressed"
          KeyDown="OnPlayerKeyDown"
          input:DragDrop.AllowDrop="True"
          input:DragDrop.DragOver="OnMediaDragOver"
          input:DragDrop.Drop="OnMediaDrop">

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{Binding PlayPauseName}"
                          Command="{Binding TogglePauseCommand}" />
                <MenuItem Header="{Binding SkipBackwardLabel, StringFormat='Skip back {0} seconds'}"
                          Command="{Binding SkipBackwardCommand}" />
                <MenuItem Header="{Binding SkipForwardLabel, StringFormat='Skip forward {0} seconds'}"
                          Command="{Binding SkipForwardCommand}" />
                <Separator />
                <MenuItem Header="Mute" Command="{Binding ToggleMuteCommand}" />
                <MenuItem Header="Stop" Command="{Binding StopCommand}" />
                <MenuItem Header="Playback speed">
                    <MenuItem Header="0.5×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="0.5" />
                    <MenuItem Header="1×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="1" />
                    <MenuItem Header="1.5×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="1.5" />
                    <MenuItem Header="2×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="2" />
                </MenuItem>
                <MenuItem Header="Fullscreen" Command="{Binding ToggleFullscreenCommand}" />
                <MenuItem Header="{Binding PictureInPictureLabel}"
                          Command="{Binding TogglePictureInPictureCommand}" />
                <MenuItem Header="Playback queue" Command="{Binding ToggleQueueCommand}" />
                <MenuItem Header="{Binding RepeatLabel}" Command="{Binding CycleRepeatCommand}" />
                <MenuItem Header="{Binding ShuffleLabel}" Command="{Binding ToggleShuffleCommand}" />
                <Separator />
                <MenuItem Header="Audio tracks"
                          Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Audio" />
                <MenuItem Header="Subtitle tracks"
                          Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Subtitles" />
                <MenuItem Header="Chapters"
                          Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Chapters" />
                <MenuItem Header="Media information"
                          Command="{Binding MediaInformationCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <controls:CompositionVideoSurface x:Name="VideoSurface" />

        <views:HomeView x:Name="HomeScreen"
                        ZIndex="1"
                        IsVisible="{Binding IsHomeOpen}" />

        <Grid x:Name="PictureInPictureChrome"
              ZIndex="2"
              IsVisible="False"
              Focusable="True"
              AutomationProperties.Name="Picture in picture controls">
            <Border x:Name="PictureInPictureHeader"
                    VerticalAlignment="Top"
                    Background="#B0000000"
                    PointerPressed="OnPictureInPictureDrag"
                    Padding="8,4">
                <Grid ColumnDefinitions="40,*,40">
                    <Button x:Name="PictureInPictureReturn"
                            Classes="iconChrome"
                            Command="{Binding TogglePictureInPictureCommand}"
                            ToolTip.Tip="Return to main window (Escape)"
                            AutomationProperties.Name="Return from picture in picture">
                        <PathIcon Width="20" Height="20"
                                  Data="M3,3 H12 V5 H6 L13,12 L11,14 L4,7 V13 H2 V3 Z M15,4 H22 V22 H4 V16 H6 V20 H20 V6 H15 Z" />
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{Binding MediaTitle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="8,0"
                               Foreground="White" />
                    <Button Grid.Column="2"
                            Classes="iconChrome"
                            Click="OnPictureInPictureClose"
                            ToolTip.Tip="Close VLC"
                            AutomationProperties.Name="Close VLC">
                        <PathIcon Width="18" Height="18"
                                  Data="M5,3 L12,10 L19,3 L21,5 L14,12 L21,19 L19,21 L12,14 L5,21 L3,19 L10,12 L3,5 Z" />
                    </Button>
                </Grid>
            </Border>
            <Button x:Name="PictureInPicturePlay"
                    Classes="iconChrome"
                    Width="52"
                    Height="52"
                    CornerRadius="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#B0000000"
                    Command="{Binding TogglePauseCommand}"
                    ToolTip.Tip="{Binding PlayPauseToolTip}"
                    AutomationProperties.Name="{Binding PlayPauseName}">
                <Grid>
                    <PathIcon Width="24" Height="24"
                              IsVisible="{Binding !IsPlaying}"
                              Data="M8,5 L19,12 L8,19 Z" />
                    <PathIcon Width="24" Height="24"
                              IsVisible="{Binding IsPlaying}"
                              Data="M7,5 H11 V19 H7 Z M14,5 H18 V19 H14 Z" />
                </Grid>
            </Button>
            <Border VerticalAlignment="Bottom"
                    Background="#B0000000"
                    Padding="12,4,12,6">
                <Grid RowDefinitions="Auto,24" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ElapsedText}"
                               FontSize="11"
                               FontFeatures="tnum"
                               Foreground="White" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DurationText}"
                               FontSize="11"
                               FontFeatures="tnum"
                               Foreground="#CCCCCC" />
                    <controls:PlayerTimeline x:Name="PictureInPictureTimeline"
                                             Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Classes="timeline monochrome"
                                             Minimum="0"
                                             Maximum="1"
                                             SmallChange="{Binding SeekStep}"
                                             Value="{Binding Position, Mode=TwoWay}"
                                             IsEnabled="{Binding CanSeek}"
                                             AutomationProperties.Name="Picture in picture position"
                                             AutomationProperties.HelpText="Use left and right arrow keys to seek."
                                             SeekStarted="OnSeekStarted"
                                             SeekCommitted="OnSeekCommitted" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel x:Name="NoMediaSurface"
                    IsVisible="{Binding IsNoMedia}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
            <Border Width="72"
                    Height="72"
                    CornerRadius="36"
                    Background="#16FFFFFF"
                    BorderBrush="#32FFFFFF"
                    BorderThickness="1">
                <PathIcon Width="32" Height="32"
                          Foreground="#AEB3BD"
                          Data="M7,5 L19,12 L7,19 Z" />
            </Border>
            <TextBlock Text="Ready to play"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <Button Classes="openMedia"
                    Content="Open media"
                    Command="{Binding OpenMediaCommand}"
                    AutomationProperties.Name="Open media"
                    ToolTip.Tip="Open a media file (Ctrl+O)" />
            <TextBlock Text="or drop media anywhere"
                       Foreground="{DynamicResource PlayerSecondaryText}"
                       FontSize="12"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsOpening}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <ProgressBar Width="220"
                         Height="4"
                         IsIndeterminate="True" />
            <TextBlock Text="{Binding MediaTitle, StringFormat='Opening {0}…'}"
                       Foreground="#D7DBE2" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsFaulted}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="Media could not be played"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFD6CE" />
            <Button Classes="openMedia"
                    Content="Open another file"
                    Command="{Binding OpenMediaCommand}" />
        </StackPanel>

        <!-- The top chrome doubles as the caption: with the client area
             extended over the decorations, dragging it moves the window and
             the in-app buttons replace the light system caption. -->
        <Border x:Name="TopChrome"
                Height="124"
                VerticalAlignment="Top"
                Padding="26,8,8,0"
                PointerPressed="OnCaptionPointerPressed">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,100%" EndPoint="50%,0%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#D2000000" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="44">
                <!-- VLC cone vector from VideoLAN's vlc/modules/gui/qt/pixmaps/misc/cone.svg. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="HomeButton"
                            Classes="iconChrome"
                            Command="{Binding ShowHomeCommand}"
                            ToolTip.Tip="Home (Alt+Home)"
                            AutomationProperties.Name="Home">
                        <PathIcon Width="18" Height="18"
                                  Data="M10,3 L1,12 L10,21 L12,19 L6,13 H23 V11 H6 L12,5 Z" />
                    </Button>
                    <Viewbox x:Name="ProductMark"
                             Width="34"
                             Height="34"
                             HorizontalAlignment="Left">
                        <Canvas Width="130" Height="130">
                            <Path Fill="{DynamicResource PlayerAccent}"
                                  Data="M65 8.76c-1.511 0-3.023.369-4.219 1.108-2.675 1.654-4.219 8.438-4.219 8.438L54.031 25.9c7.312
                                          4.599 14.625 4.647 21.938 0l-2.532-7.594s-1.543-6.784-4.218-8.438C68.022 9.129 66.511 8.761 65
                                          8.761zM47.281 46.15l-8.437 25.312c17.304 11.16 34.739 11.376 52.312 0L82.72 46.15c-11.912
                                          8.86-23.725 8.888-35.438 0zM22.812 81.587 11 121.243h108l-11.813-39.656H94.531l1.688 5.063s1.401
                                          4.523 0 5.906c-14.817 14.618-47.82 13.973-62.438-.844-1.185-1.201 0-5.062 0-5.062l1.688-5.063z" />
                            <Path Fill="White"
                                  Data="m35.469 81.585-1.688 5.063s-1.185 3.86 0 5.062c14.618 14.817 47.62 15.462 62.438.844 1.401-1.383
                                          0-5.906 0-5.906l-1.688-5.063-3.375-10.125c-17.573 11.376-35.008 11.159-52.312
                                          0zm11.812-35.437c11.713 8.888 23.526 8.86 35.438 0l-6.75-20.25c-7.313 4.647-14.625 4.599-21.938
                                          0z" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>
                <TextBlock x:Name="TopChromeTitle"
                           Grid.Column="1"
                           Text="{Binding MediaTitle}"
                           Foreground="{DynamicResource PlayerText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           MaxWidth="1100"
                           Margin="12,0,16,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding MediaTitle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="QueueButton"
                            Classes="iconChrome"
                            Command="{Binding ToggleQueueCommand}"
                            CommandParameter="Queue"
                            ToolTip.Tip="Playback queue (Ctrl+J)"
                            AutomationProperties.Name="Open playback queue">
                        <PathIcon Width="20" Height="20"
                                  Data="M4,5 H20 V7 H4 Z M4,11 H20 V13 H4 Z M4,17 H16 V19 H4 Z" />
                    </Button>
                    <Button x:Name="OpenOptionsButton"
                            Classes="iconChrome"
                            Click="OnOpenOptions"
                            ToolTip.Tip="More playback controls"
                            AutomationProperties.Name="More playback controls">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="3" Fill="{DynamicResource PlayerSecondaryText}" />
                                <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="10.5" Fill="{DynamicResource PlayerSecondaryText}" />
                                <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="18" Fill="{DynamicResource PlayerSecondaryText}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <controls:WindowCaptionButtons Margin="12,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="LibraryButton"
                        IsVisible="False"
                        Command="{Binding OpenLibraryCommand}" />
            </Grid>
        </Border>

        <Border x:Name="OpenMenu"
                ZIndex="20"
                IsVisible="False"
                Focusable="True"
                Width="360"
                MaxWidth="420"
                MaxHeight="380"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="20,60,20,0"
                Padding="8"
                CornerRadius="6"
                Background="{DynamicResource PlayerSurface}"
                BorderBrush="{DynamicResource PlayerBorder}"
                BorderThickness="1"
                BoxShadow="0 8 24 0 #60000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <TextBlock Text="More"
                               FontWeight="SemiBold"
                               FontSize="15" />
                    <Button Classes="menuAction"
                            Content="Open file"
                            Click="OnOpenFile"
                            ToolTip.Tip="Open a local media file (Ctrl+O)"
                            AutomationProperties.Name="Open media file from menu" />
                    <Button Classes="menuAction"
                            Content="Open network URL"
                            Command="{Binding OpenUrlCommand}"
                            ToolTip.Tip="Open a network URL (Ctrl+L)" />
                    <StackPanel Spacing="2">
                        <Button x:Name="OpenFolderAction"
                                Classes="menuAction"
                                Content="Open folder"
                                Command="{Binding OpenFolderCommand}"
                                ToolTip.Tip="Open every supported file in a folder"
                                AutomationProperties.Name="Open media folder" />
                        <TextBlock Text="Files are added as a flat playback queue."
                                   Classes="settingHint"
                                   Margin="12,0" />
                    </StackPanel>
                    <Button Classes="menuAction"
                            Content="Load playlist…"
                            Command="{Binding LoadPlaylistCommand}"
                            ToolTip.Tip="Load a flat M3U or M3U8 playback queue" />
                    <Button Classes="menuAction"
                            Content="Stop"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding CanStop}" />
                    <Button Classes="menuAction"
                            Content="Tracks and synchronization"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Audio" />
                    <Button Classes="menuAction"
                            Content="Video adjustments"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Video" />
                    <Button Classes="menuAction"
                            Content="Media information"
                            Command="{Binding MediaInformationCommand}" />
                    <Button Classes="menuAction"
                            Content="Picture in picture"
                            Command="{Binding TogglePictureInPictureCommand}"
                            ToolTip.Tip="Keep video above other windows (Ctrl+Shift+P)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,2">
                        <TextBlock Text="Speed" VerticalAlignment="Center" />
                        <ComboBox x:Name="SpeedSelector"
                                  Width="88"
                                  PlaceholderText="{Binding PlaybackRate, StringFormat='{}{0:0.##}×'}"
                                  SelectionChanged="OnSpeedChanged"
                                  AutomationProperties.Name="Playback speed">
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="1×" Tag="1" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="2×" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                    <Border x:Name="AlwaysOnTopChrome" Padding="12,4">
                        <CheckBox Classes="monochrome"
                                  Content="Always on top"
                                  IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                                  Command="{Binding SetAlwaysOnTopCommand}"
                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                    </Border>
                    <Button x:Name="OpenSettingsButton"
                            Classes="menuAction"
                            Content="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Settings (Ctrl+,)"
                            AutomationProperties.Name="Open settings" />
                    <Border Height="1"
                            Background="{DynamicResource PlayerBorder}"
                            Margin="4,4" />
                    <TextBlock Text="Recent" FontWeight="SemiBold" />
                    <ScrollViewer x:Name="RecentScroll"
                                  MaxHeight="260"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding HasRecentItems}">
                        <ItemsControl ItemsSource="{Binding RecentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="application:RecentMediaEntry">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                        <Button Classes="recentItem"
                                                ToolTip.Tip="{Binding Source}"
                                                Click="OnOpenRecent"
                                                AutomationProperties.Name="Open recent media">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="recentRemove"
                                                ToolTip.Tip="Remove from recent media"
                                                AutomationProperties.Name="Remove recent media"
                                                Command="{Binding DataContext.RemoveRecentCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Source}">
                                            <PathIcon Width="12" Height="12"
                                                      Data="M2,1 L5.9,5 L9.8,1 L11,2.2 L7.1,6.1 L11,10 L9.8,11.2 L5.9,7.3 L2,11.2 L0.8,10 L4.7,6.1 L0.8,2.2 Z" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="RecentEmptyState"
                               IsVisible="{Binding HasNoRecentItems}"
                               Text="No recent media yet."
                               Classes="settingHint"
                               Margin="12,2" />
                    <TextBlock IsVisible="{Binding HasHistoryError}"
                               Text="{Binding HistoryError}"
                               Foreground="#FFD6CE"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Recent history error" />
                    <StackPanel x:Name="ClearRecentPrompt"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="6"
                                IsVisible="False">
                        <TextBlock Text="Clear recent media?"
                                   VerticalAlignment="Center"
                                   Classes="settingHint" />
                        <Button Content="Cancel" Click="OnCancelClearRecent" />
                        <Button Content="Clear" Command="{Binding ClearRecentCommand}" Click="OnConfirmClearRecent" />
                    </StackPanel>
                    <Button x:Name="ClearRecentButton"
                            HorizontalAlignment="Right"
                            Content="Clear recent"
                            IsVisible="{Binding HasRecentItems}"
                            Click="OnClearRecent"
                            ToolTip.Tip="Clear recent media" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="LibraryPanel"
                ZIndex="30"
                IsVisible="{Binding IsLibraryOpen}"
                Focusable="True"
                Width="430"
                MaxWidth="430"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,76,16,18"
                Padding="16"
                CornerRadius="6"
                Background="{DynamicResource PlayerSurface}"
                BorderBrush="{DynamicResource PlayerBorder}"
                BorderThickness="1"
                BoxShadow="0 12 32 0 #80000000"
                AutomationProperties.Name="{Binding LibraryPanelAutomationName}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding LibraryTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LibraryDescription}"
                                   Classes="settingHint"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="CloseLibraryButton"
                            Grid.Column="1"
                            Classes="iconChrome"
                            Click="OnCloseLibrary"
                            ToolTip.Tip="{Binding LibraryCloseToolTip}"
                            AutomationProperties.Name="{Binding LibraryCloseAutomationName}">
                        <PathIcon Width="14" Height="14"
                                  Data="M5,3 L12,10 L19,3 L21,5 L14,12 L21,19 L19,21 L12,14 L5,21 L3,19 L10,12 L3,5 Z" />
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5">
                    <Button x:Name="LibraryRecentTab"
                            Classes="drawerTab"
                            Content="{Binding LibraryRecentTabText}"
                            Click="OnLibraryTab"
                            Tag="Recent"
                            AutomationProperties.Name="{Binding LibraryRecentTabAutomationName}" />
                    <Button Classes="drawerTab"
                            Content="{Binding LibraryFavoritesTabText}"
                            Click="OnLibraryTab"
                            Tag="Favorites"
                            AutomationProperties.Name="{Binding LibraryFavoritesTabAutomationName}" />
                    <Button Classes="drawerTab"
                            Content="{Binding LibraryResumeTabText}"
                            Click="OnLibraryTab"
                            Tag="Resume"
                            AutomationProperties.Name="{Binding LibraryResumeTabAutomationName}" />
                    <Button Classes="drawerTab"
                            Content="{Binding LibraryFavoriteCurrent}"
                            Command="{Binding AddFavoriteCommand}"
                            IsVisible="{Binding !IsCurrentFavorite}"
                            ToolTip.Tip="{Binding LibraryFavoriteCurrentToolTip}"
                            AutomationProperties.Name="{Binding LibraryFavoriteCurrentAutomationName}" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <StackPanel IsVisible="{Binding IsLibraryRecentTab}" Spacing="6">
                        <TextBlock Text="{Binding LibraryRecentTitle}" FontWeight="SemiBold" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:RecentMediaEntry">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <Button Classes="recentItem"
                                                    Click="OnOpenLibraryEntry"
                                                    ToolTip.Tip="{Binding DataContext.LibraryOpenRecentToolTip, ElementName=VideoArea}"
                                                    AutomationProperties.Name="{Binding DataContext.LibraryOpenRecentAutomationName, ElementName=VideoArea}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="recentRemove"
                                                    Command="{Binding DataContext.RemoveRecentCommand, ElementName=VideoArea}"
                                                    CommandParameter="{Binding Source}"
                                                    AutomationProperties.Name="{Binding DataContext.LibraryRemoveRecentAutomationName, ElementName=VideoArea}">
                                                <PathIcon Width="12" Height="12"
                                                          Data="M2,1 L5.9,5 L9.8,1 L11,2.2 L7.1,6.1 L11,10 L9.8,11.2 L5.9,7.3 L2,11.2 L0.8,10 L4.7,6.1 L0.8,2.2 Z" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding LibraryNoRecent}"
                                   IsVisible="{Binding HasNoRecentItems}"
                                   Classes="settingHint" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsLibraryFavoritesTab}" Spacing="6">
                        <TextBlock Text="{Binding LibraryFavoritesTitle}" FontWeight="SemiBold" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FavoriteItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:FavoriteMediaEntry">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <Button Classes="recentItem"
                                                    Click="OnOpenLibraryEntry"
                                                    ToolTip.Tip="{Binding DataContext.LibraryOpenFavoriteToolTip, ElementName=VideoArea}"
                                                    AutomationProperties.Name="{Binding DataContext.LibraryOpenFavoriteAutomationName, ElementName=VideoArea}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="recentRemove"
                                                    Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=VideoArea}"
                                                    CommandParameter="{Binding Source}"
                                                    AutomationProperties.Name="{Binding DataContext.LibraryRemoveFavoriteAutomationName, ElementName=VideoArea}">
                                                <PathIcon Width="12" Height="12"
                                                          Data="M2,1 L5.9,5 L9.8,1 L11,2.2 L7.1,6.1 L11,10 L9.8,11.2 L5.9,7.3 L2,11.2 L0.8,10 L4.7,6.1 L0.8,2.2 Z" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding LibraryNoFavorites}"
                                   IsVisible="{Binding !HasFavoriteItems}"
                                   Classes="settingHint" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsLibraryResumeTab}" Spacing="6">
                        <TextBlock Text="{Binding LibraryResumeTitle}" FontWeight="SemiBold" />
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ResumeItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:ResumeEntry">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <Button Classes="recentItem"
                                                    Click="OnOpenLibraryEntry"
                                                    ToolTip.Tip="{Binding DataContext.LibraryOpenResumeToolTip, ElementName=VideoArea}"
                                                    AutomationProperties.Name="{Binding DataContext.LibraryOpenResumeAutomationName, ElementName=VideoArea}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Source}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Position}"
                                                               Classes="settingHint" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="recentRemove"
                                                    Command="{Binding DataContext.RemoveResumeCommand, ElementName=VideoArea}"
                                                    CommandParameter="{Binding Source}"
                                                    AutomationProperties.Name="{Binding DataContext.LibraryRemoveResumeAutomationName, ElementName=VideoArea}">
                                                <PathIcon Width="12" Height="12"
                                                          Data="M2,1 L5.9,5 L9.8,1 L11,2.2 L7.1,6.1 L11,10 L9.8,11.2 L5.9,7.3 L2,11.2 L0.8,10 L4.7,6.1 L0.8,2.2 Z" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding LibraryNoResume}"
                                   IsVisible="{Binding !HasResumeItems}"
                                   Classes="settingHint" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Spacing="6">
                    <TextBlock Text="{Binding LibraryPrivacy}"
                               Classes="settingHint"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="ClearLibraryPrompt"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                IsVisible="False">
                        <TextBlock Text="{Binding LibraryClearPrompt}"
                                   VerticalAlignment="Center"
                                   Classes="settingHint" />
                        <Button x:Name="CancelClearLibraryButton"
                                Content="{Binding LibraryCancel}"
                                Click="OnCancelClearLibrary" />
                        <Button Content="{Binding LibraryClearAll}"
                                Command="{Binding ClearLibraryCommand}"
                                Click="OnConfirmClearLibrary"
                                AutomationProperties.Name="{Binding LibraryClearAllAutomationName}" />
                    </StackPanel>
                    <Button x:Name="ClearLibraryButton"
                            Content="{Binding LibraryClear}"
                            HorizontalAlignment="Right"
                            Click="OnClearLibrary"
                            IsEnabled="{Binding HasLibraryItems}"
                            AutomationProperties.Name="{Binding LibraryClearAutomationName}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="UrlPanel"
                ZIndex="30"
                IsVisible="False"
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="24,82,24,0"
                Padding="16"
                CornerRadius="16"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="#45FF9A55"
                BorderThickness="1"
                BoxShadow="0 12 32 0 #80000000">
            <StackPanel Spacing="10">
                <TextBlock Text="Open network URL"
                           FontWeight="SemiBold"
                           FontSize="16" />
                <TextBlock Text="Paste an http or https media address."
                           Classes="settingHint"
                           TextWrapping="Wrap" />
                <TextBox x:Name="UrlTextBox"
                         Text="{Binding UrlText, Mode=TwoWay}"
                         KeyDown="OnUrlTextKeyDown"
                         PlaceholderText="https://example.com/media.mp4"
                         AutomationProperties.Name="Media URL"
                         ToolTip.Tip="Only http and https URLs are supported" />
                <TextBlock x:Name="UrlOpenError"
                           IsVisible="{Binding HasOpenError}"
                           Text="{Binding OpenError}"
                           Foreground="#FFD6CE"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="URL open error" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="UrlCancelButton"
                            Content="Cancel"
                            Click="OnUrlCancel"
                            AutomationProperties.Name="Cancel opening URL" />
                    <Button x:Name="UrlSubmitButton"
                            Content="Open"
                            Click="OnUrlSubmit"
                            AutomationProperties.Name="Open network URL" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ResumePanel"
                ZIndex="30"
                IsVisible="{Binding HasPendingResume}"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24"
                Padding="20"
                CornerRadius="18"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="#FFFF9A55"
                BorderThickness="1"
                BoxShadow="0 16 42 0 #90000000">
            <StackPanel Spacing="10">
                <TextBlock Text="Resume playback"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding PendingResumeText}" FontSize="16" />
                <TextBlock Text="The saved position is available for this media."
                           Classes="settingHint"
                           TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HasHistoryError}"
                           Text="{Binding HistoryError}"
                           Foreground="#FFD6CE"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Resume history error" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="DeclineResumeAction"
                            Content="Start over"
                            Click="OnDeclineResume"
                            ToolTip.Tip="Start this media from the beginning"
                            AutomationProperties.Name="Start media over" />
                    <Button x:Name="ResumeAction"
                            Content="Resume"
                            Click="OnAcceptResume"
                            ToolTip.Tip="Resume from the saved position"
                            AutomationProperties.Name="Resume media" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="OpenErrorToast"
                ZIndex="30"
                IsVisible="False"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="24,90,24,0"
                Padding="10"
                Background="#E02B1717"
                CornerRadius="10">
            <TextBlock Text="{Binding OpenError}"
                       Foreground="#FFD6CE"
                       TextWrapping="Wrap" />
        </Border>

        <Border x:Name="QueueDrawer"
                ZIndex="10"
                IsVisible="{Binding IsQueueOpen}"
                Focusable="True"
                KeyboardNavigation.TabNavigation="Cycle"
                LayoutUpdated="OnQueueDrawerLayoutUpdated"
                Width="390"
                MaxWidth="390"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,76,16,18"
                Padding="16"
                CornerRadius="6"
                Background="{DynamicResource PlayerSurface}"
                BorderBrush="{DynamicResource PlayerBorder}"
                BorderThickness="1"
                BoxShadow="0 12 32 0 #80000000"
                AutomationProperties.Name="Playback queue and media controls">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Playback"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <Button x:Name="CloseQueueButton"
                            Classes="iconChrome"
                            Grid.Column="1"
                            Command="{Binding ToggleQueueCommand}"
                            ToolTip.Tip="Close playback drawer"
                            AutomationProperties.Name="Close playback drawer">
                        <PathIcon Width="14" Height="14"
                                  Data="M5,3 L12,10 L19,3 L21,5 L14,12 L21,19 L19,21 L12,14 L5,21 L3,19 L10,12 L3,5 Z" />
                    </Button>
                </Grid>
                <WrapPanel x:Name="DrawerTabs"
                           Grid.Row="1"
                           Orientation="Horizontal"
                           KeyDown="OnDrawerTabsKeyDown">
                    <Button Classes="drawerTab"
                            Classes.selected="{Binding IsQueueTab}"
                            Content="Queue"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Queue" />
                    <Button Classes="drawerTab"
                            Classes.selected="{Binding IsAudioTab}"
                            Content="Audio"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Audio" />
                    <Button Classes="drawerTab"
                            Classes.selected="{Binding IsVideoTab}"
                            Content="Video"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Video" />
                    <Button Classes="drawerTab"
                            Classes.selected="{Binding IsSubtitleTab}"
                            Content="Subtitles"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Subtitles" />
                    <Button Classes="drawerTab"
                            Classes.selected="{Binding IsChapterTab}"
                            Content="Chapters"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Chapters" />
                    <Button Classes="drawerTab"
                            Classes.selected="{Binding IsInformationTab}"
                            Content="Info"
                            Command="{Binding MediaInformationCommand}" />
                </WrapPanel>
                <Grid Grid.Row="2">
                    <ScrollViewer IsVisible="{Binding IsVideoTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <views:VideoAdjustmentsView DataContext="{Binding VideoAdjustments}" />
                    </ScrollViewer>
                    <Grid IsVisible="{Binding IsQueueTab}" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <WrapPanel>
                            <Button Margin="0,0,8,4"
                                    Content="{Binding RepeatLabel}"
                                    Command="{Binding CycleRepeatCommand}" />
                            <Button Margin="0,0,8,4"
                                    Content="{Binding ShuffleLabel}"
                                    Command="{Binding ToggleShuffleCommand}" />
                            <Button Margin="0,0,8,4"
                                    Content="Save…"
                                    Command="{Binding SavePlaylistCommand}"
                                    AutomationProperties.Name="Save playlist" />
                            <Button Margin="0,0,0,4"
                                    Content="Clear"
                                    Command="{Binding ClearQueueCommand}"
                                    AutomationProperties.Name="Clear queue" />
                        </WrapPanel>
                        <Grid Grid.Row="1">
                            <TextBlock IsVisible="{Binding IsQueueLoading}"
                                       Text="Loading queue…"
                                       Classes="settingHint"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <ScrollViewer x:Name="QueueScroll"
                                          IsVisible="{Binding HasQueueItems}"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding QueueItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="application:QueueItem">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                                                <Button Classes="recentItem"
                                                        Classes.selected="{Binding IsCurrent}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectQueueItemCommand, ElementName=VideoArea}"
                                                        CommandParameter="{Binding Token}"
                                                        ToolTip.Tip="{Binding Name}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding Index}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Classes="transport"
                                                        Width="34"
                                                        Height="30"
                                                        Padding="7"
                                                        Click="OnMoveQueueItemUp"
                                                        ToolTip.Tip="Move earlier"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Move {0} earlier in queue'}">
                                                    <PathIcon Width="14" Height="14"
                                                              Data="M4,12 L12,4 L20,12 L16,12 L16,20 L8,20 L8,12 Z" />
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Classes="transport"
                                                        Width="34"
                                                        Height="30"
                                                        Padding="7"
                                                        Click="OnMoveQueueItemDown"
                                                        ToolTip.Tip="Move later"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Move {0} later in queue'}">
                                                    <PathIcon Width="14" Height="14"
                                                              Data="M12,20 L4,12 L8,12 L8,4 L16,4 L16,12 L20,12 Z" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        Classes="transport"
                                                        Width="34"
                                                        Height="30"
                                                        Padding="7"
                                                        Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=VideoArea}"
                                                        CommandParameter="{Binding Token}"
                                                        ToolTip.Tip="Remove from queue"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from queue'}">
                                                    <PathIcon Width="11" Height="11"
                                                              Data="M2,1 L5.9,5 L9.8,1 L11,2.2 L7.1,6.1 L11,10 L9.8,11.2 L5.9,7.3 L2,11.2 L0.8,10 L4.7,6.1 L0.8,2.2 Z" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <TextBlock IsVisible="{Binding HasEmptyQueue}"
                                       Text="Your queue is empty. Open or drop media to start playing."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasQueueError}"
                                       Text="{Binding QueueError}"
                                       Foreground="#FFD6CE"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="AudioScroll"
                                  IsVisible="{Binding IsAudioTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="9">
                            <TextBlock Text="Audio tracks" FontWeight="SemiBold" />
                            <TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}"
                                       Text="Loading media controls…"
                                       Classes="settingHint" />
                            <TextBlock IsVisible="{Binding AreMediaControlsUnavailable}"
                                       Text="Open media to select audio tracks."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}"
                                       Text="No audio tracks are available."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AudioTracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaTrack">
                                        <Button Classes="menuAction"
                                                Classes.selected="{Binding IsSelected}"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectAudioTrackCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add external audio…"
                                    Command="{Binding AttachExternalAudioCommand}"
                                    ToolTip.Tip="Adds a track only for the next media open" />
                            <TextBlock Text="Audio delay (ms)" FontWeight="SemiBold" />
                            <WrapPanel>
                                <Button Margin="0,0,6,6"
                                        Content="−100"
                                        Command="{Binding AdjustAudioDelayCommand}"
                                        CommandParameter="-100"
                                        AutomationProperties.Name="Decrease audio delay by 100 milliseconds" />
                                <NumericUpDown x:Name="AudioDelayInput"
                                               Margin="0,0,6,6"
                                               Minimum="-10000"
                                               Maximum="10000"
                                               Increment="100"
                                               Width="112"
                                               Value="{Binding AudioDelayMilliseconds, Mode=TwoWay}"
                                               AutomationProperties.Name="Audio delay milliseconds" />
                                <Button Margin="0,0,6,6"
                                        Content="+100"
                                        Command="{Binding AdjustAudioDelayCommand}"
                                        CommandParameter="100"
                                        AutomationProperties.Name="Increase audio delay by 100 milliseconds" />
                                <Button Margin="0,0,0,6"
                                        Content="Reset"
                                        Command="{Binding ResetAudioDelayCommand}"
                                        AutomationProperties.Name="Reset audio delay" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SubtitleScroll"
                                  IsVisible="{Binding IsSubtitleTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="9">
                            <TextBlock Text="Subtitle tracks" FontWeight="SemiBold" />
                            <TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}"
                                       Text="Loading media controls…"
                                       Classes="settingHint" />
                            <TextBlock IsVisible="{Binding AreMediaControlsUnavailable}"
                                       Text="Open media to select subtitle tracks."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}"
                                       Text="No subtitle tracks are available."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Track selection is available; visual subtitle presentation is not yet qualified on this custom video path."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaTrack">
                                        <Button Classes="menuAction"
                                                Classes.selected="{Binding IsSelected}"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectSubtitleTrackCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add external subtitle…"
                                    Command="{Binding AttachExternalSubtitleCommand}"
                                    ToolTip.Tip="Adds a track only for the next media open" />
                            <TextBlock Text="Subtitle delay (ms)" FontWeight="SemiBold" />
                            <WrapPanel>
                                <Button Margin="0,0,6,6"
                                        Content="−100"
                                        Command="{Binding AdjustSubtitleDelayCommand}"
                                        CommandParameter="-100"
                                        AutomationProperties.Name="Decrease subtitle delay by 100 milliseconds" />
                                <NumericUpDown x:Name="SubtitleDelayInput"
                                               Margin="0,0,6,6"
                                               Minimum="-10000"
                                               Maximum="10000"
                                               Increment="100"
                                               Width="112"
                                               Value="{Binding SubtitleDelayMilliseconds, Mode=TwoWay}"
                                               AutomationProperties.Name="Subtitle delay milliseconds" />
                                <Button Margin="0,0,6,6"
                                        Content="+100"
                                        Command="{Binding AdjustSubtitleDelayCommand}"
                                        CommandParameter="100"
                                        AutomationProperties.Name="Increase subtitle delay by 100 milliseconds" />
                                <Button Margin="0,0,0,6"
                                        Content="Reset"
                                        Command="{Binding ResetSubtitleDelayCommand}"
                                        AutomationProperties.Name="Reset subtitle delay" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ChapterScroll"
                                  IsVisible="{Binding IsChapterTab}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="9">
                            <TextBlock Text="Titles and chapters" FontWeight="SemiBold" />
                            <TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}"
                                       Text="Loading media controls…"
                                       Classes="settingHint" />
                            <TextBlock IsVisible="{Binding AreMediaControlsUnavailable}"
                                       Text="Open media to select titles and chapters."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}"
                                       Text="This media has no titles or chapters."
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Titles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaTitle">
                                        <Button Classes="menuAction"
                                                Classes.selected="{Binding IsSelected}"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectTitleCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Chapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="application:MediaChapter">
                                        <Button Classes="menuAction"
                                                Classes.selected="{Binding IsSelected}"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectChapterCommand, ElementName=VideoArea}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip.Tip="{Binding Label}"
                                                AutomationProperties.Name="{Binding Label}">
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid IsVisible="{Binding IsInformationTab}" RowDefinitions="*,Auto" RowSpacing="10">
                        <ScrollViewer x:Name="InformationScroll"
                                      HorizontalScrollBarVisibility="Disabled">
                            <views:MediaInformationView DataContext="{Binding MediaInformation}" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <WrapPanel>
                                <Button Margin="0,0,8,0"
                                        Content="Refresh"
                                        Command="{Binding MediaInformationCommand}" />
                                <Button Content="Copy diagnostics"
                                        Command="{Binding CopyDiagnosticsCommand}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding CopyStatus}"
                                       IsVisible="{Binding HasCopyStatus}"
                                       Classes="settingHint"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <ScrollViewer Grid.Row="3"
                              MaxHeight="80"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4">
                        <TextBlock IsVisible="{Binding HasMediaCapabilitiesError}"
                                   Text="{Binding MediaCapabilitiesError}"
                                   Foreground="#FFD6CE"
                                   TextWrapping="Wrap" />
                        <TextBlock IsVisible="{Binding HasMediaControlsNotice}"
                                   Text="{Binding MediaControlsNotice}"
                                   Foreground="#FFFF9A55"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Edge-to-edge playback chrome, kept above both GPU and CPU video
             paths. The scrim runs darker than the original capture so the
             controls stay legible over bright video. -->
        <Border x:Name="PlayerDock"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Padding="20,20,20,8"
                BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.45" Color="#CC000000" />
                    <GradientStop Offset="1" Color="#FA000000" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid x:Name="DockGrid"
                  RowDefinitions="48,68,Auto"
                  ColumnDefinitions="*,Auto,*"
                  RowSpacing="0">
                <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="*,*" RowDefinitions="20,28">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ElapsedText}"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource PlayerSecondaryText}"
                               FontSize="12"
                               FontFeatures="tnum"
                               VerticalAlignment="Center" />
                    <controls:PlayerTimeline x:Name="PlayerTimeline"
                                             Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Classes="timeline monochrome"
                                             Minimum="0"
                                             Maximum="1"
                                             SmallChange="{Binding SeekStep}"
                                             Value="{Binding Position, Mode=TwoWay}"
                                             IsEnabled="{Binding CanSeek}"
                                             AutomationProperties.Name="Playback position"
                                             AutomationProperties.HelpText="Use left and right arrow keys to seek."
                                             SeekStarted="OnSeekStarted"
                                             SeekCommitted="OnSeekCommitted" />
                    <Border Grid.Row="1"
                            Grid.ColumnSpan="2"
                            IsVisible="{Binding IsSeeking}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,-24,0,0"
                            Padding="7,3"
                            CornerRadius="6"
                            Background="#E5121418">
                        <TextBlock Text="{Binding SeekPreviewText}"
                                   FontSize="11"
                                   FontFeatures="tnum" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Text="{Binding DurationText}"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource PlayerSecondaryText}"
                               FontSize="12"
                               FontFeatures="tnum"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel x:Name="LeftTransport"
                            Grid.Row="1"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Button Classes="playbackAction"
                            Command="{Binding ToggleMediaControlsCommand}"
                            CommandParameter="Audio"
                            Content="Audio / subtitles"
                            ToolTip.Tip="Audio tracks, subtitles, and chapters"
                            AutomationProperties.Name="Audio, subtitles, and chapters" />
                </StackPanel>

                <StackPanel x:Name="CenterTransport"
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Classes="transport"
                            Command="{Binding SkipBackwardCommand}"
                            AutomationProperties.Name="Skip backward"
                            ToolTip.Tip="{Binding SkipBackwardLabel, StringFormat='Back {0} seconds (Alt+Left)'}">
                        <Grid Width="26" Height="30">
                            <Path Stroke="{DynamicResource PlayerSecondaryText}"
                                  StrokeThickness="1.5"
                                  Data="M4,12 A10,10 0 0 1 23,12 M4,5 V12 H11" />
                            <TextBlock Text="{Binding SkipBackwardLabel}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>
                    <Button x:Name="PreviousButton"
                            Classes="transport"
                            Command="{Binding PreviousCommand}"
                            AutomationProperties.Name="Previous queue item"
                            ToolTip.Tip="Previous queue item">
                        <PathIcon Width="19" Height="19"
                                  Data="M5,5 L8,5 L8,19 L5,19 Z M19,5 L19,19 L9,12 Z" />
                    </Button>
                    <Button Classes="play"
                            Command="{Binding TogglePauseCommand}"
                            AutomationProperties.Name="{Binding PlayPauseName}"
                            ToolTip.Tip="{Binding PlayPauseToolTip}">
                        <Grid>
                            <PathIcon Width="22" Height="22"
                                      IsVisible="{Binding !IsPlaying}"
                                      Data="M8,5 L19,12 L8,19 Z" />
                            <PathIcon Width="22" Height="22"
                                      IsVisible="{Binding IsPlaying}"
                                      Data="M7,5 L11,5 L11,19 L7,19 Z M14,5 L18,5 L18,19 L14,19 Z" />
                        </Grid>
                    </Button>
                    <Button x:Name="StopButton"
                            Classes="transport"
                            Command="{Binding StopCommand}"
                            AutomationProperties.Name="Stop playback"
                            ToolTip.Tip="Stop playback">
                        <PathIcon Width="17" Height="17"
                                  Data="M4,4 H20 V20 H4 Z" />
                    </Button>
                    <Button x:Name="NextButton"
                            Classes="transport"
                            Command="{Binding NextCommand}"
                            AutomationProperties.Name="Next queue item"
                            ToolTip.Tip="Next queue item">
                        <PathIcon Width="19" Height="19"
                                  Data="M5,5 L5,19 L15,12 Z M16,5 L19,5 L19,19 L16,19 Z" />
                    </Button>
                    <Button Classes="transport"
                            Command="{Binding SkipForwardCommand}"
                            AutomationProperties.Name="Skip forward"
                            ToolTip.Tip="{Binding SkipForwardLabel, StringFormat='Forward {0} seconds (Alt+Right)'}">
                        <Grid Width="26" Height="30">
                            <Path Stroke="{DynamicResource PlayerSecondaryText}"
                                  StrokeThickness="1.5"
                                  Data="M3,12 A10,10 0 0 1 22,12 M22,5 V12 H15" />
                            <TextBlock Text="{Binding SkipForwardLabel}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="RightTransport"
                            Grid.Row="1"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Height="44"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="MuteButton"
                            Classes="mute"
                            Command="{Binding ToggleMuteCommand}"
                            AutomationProperties.Name="{Binding MuteName}"
                            ToolTip.Tip="{Binding MuteName}">
                        <Grid>
                            <PathIcon Width="20" Height="20"
                                      Data="M3,9 H7 L12,5 V19 L7,15 H3 Z M15,8 Q20,12 15,16 L14,14.5 Q17,12 14,9.5 Z M18,5 Q26,12 18,19 L17,17.5 Q23,12 17,6.5 Z"
                                      IsVisible="{Binding !IsMuted}" />
                            <PathIcon Width="20" Height="20"
                                      Data="M3,9 H7 L12,5 V19 L7,15 H3 Z M15,8 L18,11 L21,8 L22,9 L19,12 L22,15 L21,16 L18,13 L15,16 L14,15 L17,12 L14,9 Z"
                                      IsVisible="{Binding IsMuted}" />
                        </Grid>
                    </Button>
                    <controls:PlayerVolumeSlider x:Name="PlayerVolume"
                                                 Width="120"
                                                 Classes="volume monochrome"
                                                 Minimum="0"
                                                 Maximum="200"
                                                 IsEnabled="{Binding HasPlayableMedia}"
                                                 TickFrequency="100"
                                                 SmallChange="2"
                                                 LargeChange="10"
                                                 Value="{Binding Volume, Mode=TwoWay}"
                                                 AutomationProperties.Name="Volume"
                                                 AutomationProperties.HelpText="0 to 200 percent. Values above 100 percent are amplified."
                                                 ToolTip.Tip="{Binding VolumeText}"
                                                 DragStarted="OnVolumeDragStarted"
                                                 DragCompleted="OnVolumeDragCompleted" />
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}"
                               MinWidth="38"
                               FontSize="12"
                               Foreground="#DDE0E5"
                               VerticalAlignment="Center"
                               ToolTip.Tip="{Binding VolumeText}" />
                    <Button x:Name="FullscreenButton"
                            Classes="transport"
                            ToolTip.Tip="{Binding FullscreenName}"
                            Command="{Binding ToggleFullscreenCommand}"
                            AutomationProperties.Name="{Binding FullscreenName}">
                        <Grid>
                            <PathIcon Width="18" Height="18"
                                      IsVisible="{Binding !IsFullscreen}"
                                      Data="M3,3 H9 V5 H5 V9 H3 Z M15,3 H21 V9 H19 V5 H15 Z M19,15 H21 V21 H15 V19 H19 Z M3,15 H5 V19 H9 V21 H3 Z" />
                            <PathIcon Width="18" Height="18"
                                      IsVisible="{Binding IsFullscreen}"
                                      Data="M7,3 H9 V9 H3 V7 H7 Z M15,3 H17 V7 H21 V9 H15 Z M15,15 H21 V17 H17 V21 H15 Z M3,15 H9 V21 H7 V17 H3 Z" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:SettingsView x:Name="SettingsPanel"
                            ZIndex="30"
                            IsVisible="False" />
    </Grid>
</Window>
