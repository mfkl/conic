<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Conic.Controls"
        xmlns:viewModels="clr-namespace:Conic.ViewModels"
        xmlns:application="clr-namespace:Player.Application;assembly=Player.Application"
        xmlns:input="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="720"
        x:Class="Conic.MainWindow"
        x:DataType="viewModels:PlayerPresentationViewModel"
        Title="Conic"
        MinWidth="480"
        Background="#08090B"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowState="Maximized">

    <Grid x:Name="VideoArea" Background="#08090B" PointerMoved="OnPlayerInteraction" KeyDown="OnPlayerKeyDown" input:DragDrop.AllowDrop="True" input:DragDrop.DragOver="OnMediaDragOver" input:DragDrop.Drop="OnMediaDrop">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Play or pause" Command="{Binding TogglePauseCommand}" />
                <MenuItem Header="{Binding SkipBackwardLabel, StringFormat='Skip back {0} seconds'}" Command="{Binding SkipBackwardCommand}" />
                <MenuItem Header="{Binding SkipForwardLabel, StringFormat='Skip forward {0} seconds'}" Command="{Binding SkipForwardCommand}" />
                <Separator />
                <MenuItem Header="Mute" Command="{Binding ToggleMuteCommand}" />
                <MenuItem Header="Playback speed">
                    <MenuItem Header="0.5×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="0.5" />
                    <MenuItem Header="1×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="1" />
                    <MenuItem Header="1.5×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="1.5" />
                    <MenuItem Header="2×" Command="{Binding SetPlaybackRateCommand}" CommandParameter="2" />
                </MenuItem>
                <MenuItem Header="Fullscreen" Command="{Binding ToggleFullscreenCommand}" />
                <MenuItem Header="{Binding LibraryMenu}" Command="{Binding OpenLibraryCommand}" />
                <Separator />
                <MenuItem Header="Playback queue" Command="{Binding ToggleQueueCommand}" />
                <MenuItem Header="{Binding RepeatLabel}" Command="{Binding CycleRepeatCommand}" />
                <MenuItem Header="{Binding ShuffleLabel}" Command="{Binding ToggleShuffleCommand}" />
                <Separator />
                <MenuItem Header="Audio tracks" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Audio" />
                <MenuItem Header="Subtitle tracks" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Subtitles" />
                <MenuItem Header="Chapters" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Chapters" />
                <MenuItem Header="Media information" Command="{Binding MediaInformationCommand}" />
                <MenuItem Header="Take snapshot (unavailable)" Command="{Binding SnapshotCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <controls:CompositionVideoSurface x:Name="VideoSurface" />

        <!-- Lightweight top chrome; all controls stay in Avalonia composition. -->
        <Grid x:Name="TopChrome" Margin="24,20,24,0"
              VerticalAlignment="Top"
              ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0"
                    Padding="6"
                    CornerRadius="16"
                    Background="#B8131519"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    BoxShadow="0 8 24 0 #70000000">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button Classes="chrome openPrimary"
                            Command="{Binding OpenMediaCommand}"
                            ToolTip.Tip="Open a media file (Ctrl+O)"
                            AutomationProperties.Name="Open media file">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="17" Height="17" Foreground="#FFFF9A55"
                                      Data="M2,5 L9,5 L11,7 L22,7 L20,19 L2,19 Z" />
                            <TextBlock Text="Open" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenOptionsButton" Classes="chrome openOptions"
                            Content="⌄" Click="OnOpenOptions"
                            ToolTip.Tip="More ways to open media"
                            AutomationProperties.Name="Open media options" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TopChromeTitle" Grid.Column="1" Text="{Binding MediaTitle}" Foreground="#D7DBE2"
                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="24,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="QueueButton" Classes="chrome" Content="Queue" Command="{Binding ToggleQueueCommand}" CommandParameter="Queue" ToolTip.Tip="Playback queue (Ctrl+J)" AutomationProperties.Name="Open playback queue" />
            <Button x:Name="LibraryButton" Classes="chrome" Content="{Binding LibraryButtonText}" Command="{Binding OpenLibraryCommand}" ToolTip.Tip="{Binding LibraryButtonToolTip}" AutomationProperties.Name="{Binding LibraryButtonAutomationName}" />
            <Button x:Name="OpenSettingsButton" Classes="chrome" Content="Settings" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)" AutomationProperties.Name="Open settings" />
            <Border x:Name="AlwaysOnTopChrome"
                    Padding="14,8"
                    CornerRadius="14"
                    Background="#9E131519"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1">
                <CheckBox Classes="monochrome"
                          Content="Always on top"
                          Foreground="#D7DBE2"
                          FontSize="12"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                          Command="{Binding SetAlwaysOnTopCommand}"
                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
            </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="OpenMenu" IsVisible="False" Width="360" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,76,24,0"
                Padding="12" CornerRadius="16" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="#45FF9A55" BorderThickness="1" BoxShadow="0 12 32 0 #80000000">
            <StackPanel Spacing="8">
                <TextBlock Text="Open media" FontWeight="SemiBold" FontSize="15" />
                <Button Classes="menuAction" Content="Open file" Click="OnOpenFile" ToolTip.Tip="Open a local media file (Ctrl+O)" AutomationProperties.Name="Open media file from menu" />
                <Button Classes="menuAction" Content="Open network URL" Command="{Binding OpenUrlCommand}" ToolTip.Tip="Open a network URL (Ctrl+L)" />
                <StackPanel Spacing="2">
                    <Button x:Name="OpenFolderAction" Classes="menuAction" Content="Open folder" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open every supported file in a folder" AutomationProperties.Name="Open media folder" />
                    <TextBlock Text="Files are added as a flat playback queue." Classes="settingHint" Margin="12,0" />
                </StackPanel>
                <Button Classes="menuAction" Content="Load playlist…" Command="{Binding LoadPlaylistCommand}" ToolTip.Tip="Load a flat M3U or M3U8 playback queue" />
                <Border Height="1" Background="#2CFFFFFF" Margin="4,4" />
                <TextBlock Text="Recent" FontWeight="SemiBold" />
                <ScrollViewer x:Name="RecentScroll" MaxHeight="260" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasRecentItems}">
                    <ItemsControl ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="application:RecentMediaEntry">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                    <Button Classes="recentItem" ToolTip.Tip="{Binding Source}" Click="OnOpenRecent" AutomationProperties.Name="Open recent media">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </Button>
                                    <Button Grid.Column="1" Classes="recentRemove" Content="×" ToolTip.Tip="Remove from recent media"
                                            AutomationProperties.Name="Remove recent media" Command="{Binding DataContext.RemoveRecentCommand, ElementName=VideoArea}" CommandParameter="{Binding Source}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="RecentEmptyState" IsVisible="{Binding HasNoRecentItems}" Text="No recent media yet." Classes="settingHint" Margin="12,2" />
                <TextBlock IsVisible="{Binding HasHistoryError}" Text="{Binding HistoryError}" Foreground="#FFD6CE" TextWrapping="Wrap" AutomationProperties.Name="Recent history error" />
                <StackPanel x:Name="ClearRecentPrompt" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" IsVisible="False">
                    <TextBlock Text="Clear recent media?" VerticalAlignment="Center" Classes="settingHint" />
                    <Button Content="Cancel" Click="OnCancelClearRecent" />
                    <Button Content="Clear" Command="{Binding ClearRecentCommand}" Click="OnConfirmClearRecent" />
                </StackPanel>
                <Button x:Name="ClearRecentButton" HorizontalAlignment="Right" Content="Clear recent" IsVisible="{Binding HasRecentItems}" Click="OnClearRecent" ToolTip.Tip="Clear recent media" />
            </StackPanel>
        </Border>
        <Border x:Name="LibraryPanel" IsVisible="{Binding IsLibraryOpen}" Focusable="True" Width="430" MaxWidth="430" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,76,16,18" Padding="16" CornerRadius="18" Background="#EF131519" BorderBrush="#45FF9A55" BorderThickness="1" BoxShadow="0 12 32 0 #80000000" AutomationProperties.Name="Media library">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding LibraryTitle}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding LibraryDescription}" Classes="settingHint" TextWrapping="Wrap" /></StackPanel><Button x:Name="CloseLibraryButton" Grid.Column="1" Content="×" Click="OnCloseLibrary" ToolTip.Tip="{Binding LibraryCloseToolTip}" AutomationProperties.Name="{Binding LibraryCloseAutomationName}" /></Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5"><Button x:Name="LibraryRecentTab" Content="{Binding LibraryRecentTabText}" Click="OnLibraryTab" Tag="Recent" AutomationProperties.Name="{Binding LibraryRecentTabAutomationName}" /><Button Content="{Binding LibraryFavoritesTabText}" Click="OnLibraryTab" Tag="Favorites" AutomationProperties.Name="{Binding LibraryFavoritesTabAutomationName}" /><Button Content="{Binding LibraryResumeTabText}" Click="OnLibraryTab" Tag="Resume" AutomationProperties.Name="{Binding LibraryResumeTabAutomationName}" /><Button Content="{Binding LibraryFavoriteCurrent}" Command="{Binding AddFavoriteCommand}" IsVisible="{Binding !IsCurrentFavorite}" ToolTip.Tip="{Binding LibraryFavoriteCurrentToolTip}" AutomationProperties.Name="{Binding LibraryFavoriteCurrentAutomationName}" /></StackPanel>
                <Grid Grid.Row="2">
                    <StackPanel IsVisible="{Binding IsLibraryRecentTab}" Spacing="6"><TextBlock Text="{Binding LibraryRecentTitle}" FontWeight="SemiBold" /><ScrollViewer HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding RecentItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:RecentMediaEntry"><Grid ColumnDefinitions="*,Auto" Margin="0,2"><Button Classes="recentItem" Click="OnOpenLibraryEntry" ToolTip.Tip="{Binding DataContext.LibraryOpenRecentToolTip, ElementName=VideoArea}" AutomationProperties.Name="{Binding DataContext.LibraryOpenRecentAutomationName, ElementName=VideoArea}"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></Button><Button Grid.Column="1" Classes="recentRemove" Content="×" Command="{Binding DataContext.RemoveRecentCommand, ElementName=VideoArea}" CommandParameter="{Binding Source}" AutomationProperties.Name="{Binding DataContext.LibraryRemoveRecentAutomationName, ElementName=VideoArea}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{Binding LibraryNoRecent}" IsVisible="{Binding HasNoRecentItems}" Classes="settingHint" /></StackPanel>
                    <StackPanel IsVisible="{Binding IsLibraryFavoritesTab}" Spacing="6"><TextBlock Text="{Binding LibraryFavoritesTitle}" FontWeight="SemiBold" /><ScrollViewer HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding FavoriteItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:FavoriteMediaEntry"><Grid ColumnDefinitions="*,Auto" Margin="0,2"><Button Classes="recentItem" Click="OnOpenLibraryEntry" ToolTip.Tip="{Binding DataContext.LibraryOpenFavoriteToolTip, ElementName=VideoArea}" AutomationProperties.Name="{Binding DataContext.LibraryOpenFavoriteAutomationName, ElementName=VideoArea}"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></Button><Button Grid.Column="1" Classes="recentRemove" Content="×" Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=VideoArea}" CommandParameter="{Binding Source}" AutomationProperties.Name="{Binding DataContext.LibraryRemoveFavoriteAutomationName, ElementName=VideoArea}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{Binding LibraryNoFavorites}" IsVisible="{Binding !HasFavoriteItems}" Classes="settingHint" /></StackPanel>
                    <StackPanel IsVisible="{Binding IsLibraryResumeTab}" Spacing="6"><TextBlock Text="{Binding LibraryResumeTitle}" FontWeight="SemiBold" /><ScrollViewer HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ResumeItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:ResumeEntry"><Grid ColumnDefinitions="*,Auto" Margin="0,2"><Button Classes="recentItem" Click="OnOpenLibraryEntry" ToolTip.Tip="{Binding DataContext.LibraryOpenResumeToolTip, ElementName=VideoArea}" AutomationProperties.Name="{Binding DataContext.LibraryOpenResumeAutomationName, ElementName=VideoArea}"><StackPanel><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Position}" Classes="settingHint" /></StackPanel></Button><Button Grid.Column="1" Classes="recentRemove" Content="×" Command="{Binding DataContext.RemoveResumeCommand, ElementName=VideoArea}" CommandParameter="{Binding Source}" AutomationProperties.Name="{Binding DataContext.LibraryRemoveResumeAutomationName, ElementName=VideoArea}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{Binding LibraryNoResume}" IsVisible="{Binding !HasResumeItems}" Classes="settingHint" /></StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Spacing="6"><TextBlock Text="{Binding LibraryPrivacy}" Classes="settingHint" TextWrapping="Wrap" /><StackPanel x:Name="ClearLibraryPrompt" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsVisible="False"><TextBlock Text="{Binding LibraryClearPrompt}" VerticalAlignment="Center" Classes="settingHint" /><Button x:Name="CancelClearLibraryButton" Content="{Binding LibraryCancel}" Click="OnCancelClearLibrary" /><Button Content="{Binding LibraryClearAll}" Command="{Binding ClearLibraryCommand}" Click="OnConfirmClearLibrary" AutomationProperties.Name="{Binding LibraryClearAllAutomationName}" /></StackPanel><Button x:Name="ClearLibraryButton" Content="{Binding LibraryClear}" HorizontalAlignment="Right" Click="OnClearLibrary" IsEnabled="{Binding HasLibraryItems}" AutomationProperties.Name="{Binding LibraryClearAutomationName}" /></StackPanel>
            </Grid>
        </Border>
        <Border x:Name="UrlPanel" IsVisible="False" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,82,24,0"
                Padding="16" CornerRadius="16" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="#45FF9A55" BorderThickness="1" BoxShadow="0 12 32 0 #80000000">
            <StackPanel Spacing="10">
                <TextBlock Text="Open network URL" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="Paste an http or https media address." Classes="settingHint" TextWrapping="Wrap" />
                <TextBox x:Name="UrlTextBox" Text="{Binding UrlText, Mode=TwoWay}" KeyDown="OnUrlTextKeyDown" PlaceholderText="https://example.com/media.mp4" AutomationProperties.Name="Media URL" ToolTip.Tip="Only http and https URLs are supported" />
                <TextBlock x:Name="UrlOpenError" IsVisible="{Binding HasOpenError}" Text="{Binding OpenError}" Foreground="#FFD6CE" TextWrapping="Wrap" AutomationProperties.Name="URL open error" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="UrlCancelButton" Content="Cancel" Click="OnUrlCancel" AutomationProperties.Name="Cancel opening URL" /><Button x:Name="UrlSubmitButton" Content="Open" Click="OnUrlSubmit" AutomationProperties.Name="Open network URL" /></StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="ResumePanel" IsVisible="{Binding HasPendingResume}" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="20" CornerRadius="18" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="#FFFF9A55" BorderThickness="1" BoxShadow="0 16 42 0 #90000000">
            <StackPanel Spacing="10"><TextBlock Text="Resume playback" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding PendingResumeText}" FontSize="16" /><TextBlock Text="The saved position is available for this media." Classes="settingHint" TextWrapping="Wrap" /><TextBlock IsVisible="{Binding HasHistoryError}" Text="{Binding HistoryError}" Foreground="#FFD6CE" TextWrapping="Wrap" AutomationProperties.Name="Resume history error" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="DeclineResumeAction" Content="Start over" Click="OnDeclineResume" ToolTip.Tip="Start this media from the beginning" AutomationProperties.Name="Start media over" /><Button x:Name="ResumeAction" Content="Resume" Click="OnAcceptResume" ToolTip.Tip="Resume from the saved position" AutomationProperties.Name="Resume media" /></StackPanel></StackPanel>
        </Border>
        <Border x:Name="OpenErrorToast" IsVisible="False" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,90,24,0" Padding="10" Background="#E02B1717" CornerRadius="10"><TextBlock Text="{Binding OpenError}" Foreground="#FFD6CE" TextWrapping="Wrap" /></Border>

        <Border x:Name="QueueDrawer" IsVisible="{Binding IsQueueOpen}" Focusable="True" Width="390" MaxWidth="390" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,76,16,18" Padding="16" CornerRadius="18" Background="#EF131519" BorderBrush="#45FF9A55" BorderThickness="1" BoxShadow="0 12 32 0 #80000000" AutomationProperties.Name="Playback queue and media controls">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Playback" FontSize="17" FontWeight="SemiBold" /><Button x:Name="CloseQueueButton" Grid.Column="1" Content="×" Command="{Binding ToggleQueueCommand}" ToolTip.Tip="Close playback drawer" AutomationProperties.Name="Close playback drawer" /></Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4"><Button Content="Queue" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Queue" /><Button Content="Audio" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Audio" /><Button Content="Subtitles" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Subtitles" /><Button Content="Chapters" Command="{Binding ToggleMediaControlsCommand}" CommandParameter="Chapters" /><Button Content="Info" Command="{Binding MediaInformationCommand}" /></StackPanel>
                <Grid Grid.Row="2">
                    <Grid IsVisible="{Binding IsQueueTab}" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding RepeatLabel}" Command="{Binding CycleRepeatCommand}" /><Button Content="{Binding ShuffleLabel}" Command="{Binding ToggleShuffleCommand}" /><Button Content="Save…" Command="{Binding SavePlaylistCommand}" /><Button Content="Clear" Command="{Binding ClearQueueCommand}" /></StackPanel>
                        <Grid Grid.Row="1"><TextBlock IsVisible="{Binding IsQueueLoading}" Text="Loading queue…" Classes="settingHint" HorizontalAlignment="Center" VerticalAlignment="Center" /><ScrollViewer IsVisible="{Binding HasQueueItems}" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding QueueItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:QueueItem"><Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2"><Button Classes="recentItem" Command="{Binding DataContext.SelectQueueItemCommand, ElementName=VideoArea}" CommandParameter="{Binding Token}" ToolTip.Tip="Play this item"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Index}" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></StackPanel></Button><Button Grid.Column="1" Content="↑" Click="OnMoveQueueItemUp" ToolTip.Tip="Move earlier" /><Button Grid.Column="2" Content="↓" Click="OnMoveQueueItemDown" ToolTip.Tip="Move later" /><Button Grid.Column="3" Content="×" Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=VideoArea}" CommandParameter="{Binding Token}" ToolTip.Tip="Remove from queue" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock IsVisible="{Binding HasQueueError}" Text="{Binding QueueError}" Foreground="#FFD6CE" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        <TextBlock Grid.Row="2" IsVisible="{Binding HasEmptyQueue}" Text="Your queue is empty. Open or drop media to start playing." Classes="settingHint" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel IsVisible="{Binding IsAudioTab}" Spacing="9"><TextBlock Text="Audio tracks" FontWeight="SemiBold" /><TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}" Text="Loading media controls…" Classes="settingHint" /><TextBlock IsVisible="{Binding AreMediaControlsUnavailable}" Text="Audio tracks are unavailable until media is ready." Classes="settingHint" TextWrapping="Wrap" /><TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}" Text="This media has no audio tracks or chapters to select." Classes="settingHint" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding AudioTracks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:MediaTrack"><Button Content="{Binding Label}" Command="{Binding DataContext.SelectAudioTrackCommand, ElementName=VideoArea}" CommandParameter="{Binding Id}" IsEnabled="{Binding !IsDisabled}" ToolTip.Tip="Select audio track" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Add external audio…" Command="{Binding AttachExternalAudioCommand}" ToolTip.Tip="Adds audio only for the next media open" /><TextBlock Text="Audio delay (ms)" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="−100" Command="{Binding AdjustAudioDelayCommand}" CommandParameter="-100" /><NumericUpDown x:Name="AudioDelayInput" Minimum="-10000" Maximum="10000" Increment="100" Width="112" Value="{Binding AudioDelayMilliseconds, Mode=TwoWay}" AutomationProperties.Name="Audio delay milliseconds" /><Button Content="+100" Command="{Binding AdjustAudioDelayCommand}" CommandParameter="100" /><Button Content="Reset" Command="{Binding ResetAudioDelayCommand}" /></StackPanel></StackPanel>
                    <StackPanel IsVisible="{Binding IsSubtitleTab}" Spacing="9"><TextBlock Text="Subtitle tracks" FontWeight="SemiBold" /><TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}" Text="Loading media controls…" Classes="settingHint" /><TextBlock Text="Track selection is available; visual subtitle presentation is not yet qualified on this custom video path." Classes="settingHint" TextWrapping="Wrap" /><TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}" Text="This media has no subtitle tracks." Classes="settingHint" /><ItemsControl ItemsSource="{Binding SubtitleTracks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:MediaTrack"><Button Content="{Binding Label}" Command="{Binding DataContext.SelectSubtitleTrackCommand, ElementName=VideoArea}" CommandParameter="{Binding Id}" IsEnabled="{Binding !IsDisabled}" ToolTip.Tip="Select subtitle track; rendering is not qualified" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Add external subtitle…" Command="{Binding AttachExternalSubtitleCommand}" ToolTip.Tip="Adds a subtitle file only for the next media open" /><TextBlock Text="Subtitle delay (ms)" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="−100" Command="{Binding AdjustSubtitleDelayCommand}" CommandParameter="-100" /><NumericUpDown x:Name="SubtitleDelayInput" Minimum="-10000" Maximum="10000" Increment="100" Width="112" Value="{Binding SubtitleDelayMilliseconds, Mode=TwoWay}" AutomationProperties.Name="Subtitle delay milliseconds" /><Button Content="+100" Command="{Binding AdjustSubtitleDelayCommand}" CommandParameter="100" /><Button Content="Reset" Command="{Binding ResetSubtitleDelayCommand}" /></StackPanel></StackPanel>
                    <StackPanel IsVisible="{Binding IsChapterTab}" Spacing="9"><TextBlock Text="Titles and chapters" FontWeight="SemiBold" /><TextBlock IsVisible="{Binding IsMediaCapabilitiesLoading}" Text="Loading media controls…" Classes="settingHint" /><TextBlock IsVisible="{Binding HasMediaCapabilitiesEmpty}" Text="This media has no titles or chapters." Classes="settingHint" /><ItemsControl ItemsSource="{Binding Titles}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:MediaTitle"><Button Content="{Binding Label}" Command="{Binding DataContext.SelectTitleCommand, ElementName=VideoArea}" CommandParameter="{Binding Id}" ToolTip.Tip="Select title" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding Chapters}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="application:MediaChapter"><Button Content="{Binding Label}" Command="{Binding DataContext.SelectChapterCommand, ElementName=VideoArea}" CommandParameter="{Binding Id}" ToolTip.Tip="Select chapter" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <StackPanel IsVisible="{Binding IsInformationTab}" Spacing="9"><TextBlock Text="Media information" FontWeight="SemiBold" /><TextBlock Text="{Binding MediaInformation.Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding MediaInformation.Status}" Classes="settingHint" /><ItemsControl ItemsSource="{Binding MediaInformation.Metadata}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Codec stream details are unavailable through this engine ABI." Classes="settingHint" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel IsVisible="{Binding IsInformationTab}" Spacing="6"><Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}" /><TextBlock Text="{Binding CopyStatus}" IsVisible="{Binding HasCopyStatus}" Classes="settingHint" /></StackPanel>
                    <TextBlock IsVisible="{Binding HasMediaCapabilitiesError}" Text="{Binding MediaCapabilitiesError}" Foreground="#FFD6CE" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                    <TextBlock IsVisible="{Binding HasMediaControlsNotice}" Text="{Binding MediaControlsNotice}" Foreground="#FFFF9A55" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Border>

        <!-- Floating playback dock. -->
        <Border x:Name="PlayerDock" VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                MaxWidth="1080"
                Margin="24,0,24,26"
                Padding="22,16,22,14"
                CornerRadius="22"
                Background="#E5121418"
                BorderBrush="#2FFFFFFF"
                BorderThickness="1"
                BoxShadow="0 18 48 0 #A8000000">
            <Grid x:Name="DockGrid" RowDefinitions="36,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="12">
                <Grid Grid.Row="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ElapsedText}"
                               Margin="0,0,12,0"
                               Foreground="#AEB3BD"
                               FontSize="12"
                               FontFeatures="tnum"
                               VerticalAlignment="Center" />
                    <controls:PlayerTimeline Grid.Column="1"
                                              x:Name="PlayerTimeline"
                                              Classes="timeline monochrome"
                                              Minimum="0"
                                              Maximum="1"
                                               Value="{Binding Position, Mode=TwoWay}"
                                               IsEnabled="{Binding CanSeek}"
                                               AutomationProperties.Name="Playback position"
                                               AutomationProperties.HelpText="Use left and right arrow keys to seek."
                                              SeekStarted="OnSeekStarted"
                                              SeekCommitted="OnSeekCommitted" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationText}"
                               Margin="12,0,0,0"
                               Foreground="#AEB3BD"
                               FontSize="12"
                               FontFeatures="tnum"
                               VerticalAlignment="Center" />
                </Grid>

                    <StackPanel x:Name="CenterTransport" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                         <Button Classes="transport"
                                 Command="{Binding SkipBackwardCommand}"
                                 AutomationProperties.Name="Skip backward"
                                ToolTip.Tip="{Binding SkipBackwardLabel, StringFormat='Back {0} seconds (Alt+Left)'}"
                                Content="{Binding SkipBackwardLabel}" />
                         <Button Classes="transport"
                                  Command="{Binding PreviousCommand}"
                                  AutomationProperties.Name="Previous queue item"
                                 ToolTip.Tip="Previous queue item">
                            <PathIcon Width="19" Height="19"
                                      Data="M5,5 L8,5 L8,19 L5,19 Z M19,5 L19,19 L9,12 Z" />
                        </Button>
                         <Button Classes="play"
                                 Command="{Binding TogglePauseCommand}"
                                 AutomationProperties.Name="Play or pause"
                                ToolTip.Tip="Play or pause">
                            <Grid>
                                <PathIcon Width="22" Height="22"
                                          IsVisible="{Binding !IsPlaying}"
                                          Data="M8,5 L19,12 L8,19 Z" />
                                <PathIcon Width="22" Height="22"
                                          IsVisible="{Binding IsPlaying}"
                                          Data="M7,5 L11,5 L11,19 L7,19 Z M14,5 L18,5 L18,19 L14,19 Z" />
                            </Grid>
                        </Button>
                         <Button Classes="transport"
                                 Command="{Binding StopCommand}"
                                 AutomationProperties.Name="Stop playback"
                                ToolTip.Tip="Stop">
                            <PathIcon Width="17" Height="17"
                                      Data="M6,6 L18,6 L18,18 L6,18 Z" />
                        </Button>
                         <Button Classes="transport"
                                 Command="{Binding SkipForwardCommand}"
                                 AutomationProperties.Name="Skip forward"
                                ToolTip.Tip="{Binding SkipForwardLabel, StringFormat='Forward {0} seconds (Alt+Right)'}"
                                Content="{Binding SkipForwardLabel}" />
                         <Button Classes="transport"
                                  Command="{Binding NextCommand}"
                                  AutomationProperties.Name="Next queue item"
                                 ToolTip.Tip="Next queue item">
                            <PathIcon Width="19" Height="19"
                                      Data="M5,5 L5,19 L15,12 Z M16,5 L19,5 L19,19 L16,19 Z" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="RightTransport" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                          Height="52"
                          Margin="0,0,4,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          >
                         <Button x:Name="MuteButton" Classes="mute" Command="{Binding ToggleMuteCommand}"
                                 AutomationProperties.Name="Mute or unmute"
                                ToolTip.Tip="Mute (M)">
                            <Grid>
                                <PathIcon Width="18" Height="18" Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M15,9 L18,12 L15,15 Z" IsVisible="{Binding !IsMuted}" />
                                <PathIcon Width="18" Height="18" Data="M3,9 L7,9 L12,5 L12,19 L7,15 L3,15 Z M15,9 L21,15 M21,9 L15,15" IsVisible="{Binding IsMuted}" />
                            </Grid>
                        </Button>
                        <controls:PlayerVolumeSlider
                                                     x:Name="PlayerVolume"
                                                     Width="112"
                                                     Classes="volume monochrome"
                                                     Minimum="0"
                                                     Maximum="100"
                                                      Value="{Binding Volume, Mode=TwoWay}"
                                                      AutomationProperties.Name="Volume"
                                                      AutomationProperties.HelpText="Use arrow keys to adjust volume."
                                                     DragStarted="OnVolumeDragStarted"
                                                     DragCompleted="OnVolumeDragCompleted" />
                         <ComboBox x:Name="SpeedSelector" Width="72" SelectionChanged="OnSpeedChanged" AutomationProperties.Name="Playback speed">
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="1×" Tag="1" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="2×" Tag="2" />
                        </ComboBox>
                         <Button x:Name="FullscreenButton" Classes="transport" ToolTip.Tip="Fullscreen (F11)" Command="{Binding ToggleFullscreenCommand}" AutomationProperties.Name="Toggle fullscreen">
                            <Grid>
                                <PathIcon Width="18" Height="18" IsVisible="{Binding !IsFullscreen}" Data="M5,9 L5,5 L9,5 M15,5 L19,5 L19,9 M19,15 L19,19 L15,19 M9,19 L5,19 L5,15" />
                                <PathIcon Width="18" Height="18" IsVisible="{Binding IsFullscreen}" Data="M9,5 L9,9 L5,9 M15,5 L15,9 L19,9 M19,15 L15,15 L15,19 M5,15 L9,15 L9,19" />
                            </Grid>
                        </Button>
                    </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel" x:DataType="viewModels:SettingsViewModel" IsVisible="False" MaxWidth="760" MaxHeight="580" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" CornerRadius="18"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" BoxShadow="0 24 60 0 #B0000000">
            <Grid x:Name="SettingsGrid" ColumnDefinitions="190,*" RowDefinitions="Auto,*" RowSpacing="18" ColumnSpacing="22">
                <TextBox x:Name="SettingsSearch" Grid.ColumnSpan="2" PlaceholderText="Search settings" TextChanged="OnSettingsSearchChanged" AutomationProperties.Name="Search settings" />
                <ListBox x:Name="SettingsPages" Grid.Row="1" ItemsSource="{Binding FilteredPages}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="Settings pages">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="8" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <ComboBox x:Name="CompactSettingsPages" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="False" ItemsSource="{Binding FilteredPages}" SelectedItem="{Binding SelectedPage}" AutomationProperties.Name="Settings pages">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ScrollViewer x:Name="SettingsContent" Grid.Row="1" Grid.Column="1">
                    <StackPanel Spacing="14">
                        <DockPanel><TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" /><Button DockPanel.Dock="Right" Content="Close" Click="OnSettingsClose" AutomationProperties.Name="Close settings" /></DockPanel>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9A55" TextWrapping="Wrap" />
                        <TextBlock Text="General" IsVisible="{Binding IsGeneral}" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel IsVisible="{Binding IsGeneral}" Spacing="10">
                        <CheckBox Content="Resume playback" IsChecked="{Binding ResumePlayback, Mode=TwoWay}" AutomationProperties.Name="Resume playback" ToolTip.Tip="Ask to resume eligible media next time it opens" />
                        <TextBlock Text="Next open" Classes="settingHint" />
                        <CheckBox Content="Remember volume" IsChecked="{Binding RememberVolume, Mode=TwoWay}" AutomationProperties.Name="Remember volume" />
                        <TextBlock Text="Takes effect next time media is opened" Classes="settingHint" />
                        <CheckBox Content="Remember recent media" IsChecked="{Binding RememberRecentMedia, Mode=TwoWay}" AutomationProperties.Name="Remember recent media" ToolTip.Tip="Turning this off clears recent media immediately" />
                        <TextBlock Text="Live · turning this off immediately clears existing recent history." Classes="settingHint" TextWrapping="Wrap" />
                        <StackPanel Spacing="5"><Button x:Name="SettingsClearRecentButton" Content="Clear recent history…" Click="OnSettingsClearRecent" HorizontalAlignment="Left" AutomationProperties.Name="Clear recent history" ToolTip.Tip="Clear recently opened media" /><StackPanel x:Name="SettingsClearRecentPrompt" IsVisible="False" Spacing="5"><TextBlock Text="Clear recent history?" Classes="settingHint" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SettingsCancelClearRecentButton" Content="Cancel" Click="OnSettingsCancelClearRecent" /><Button x:Name="SettingsConfirmClearRecentButton" Content="Clear" Click="OnSettingsConfirmClearRecent" AutomationProperties.Name="Confirm clear recent history" /></StackPanel></StackPanel></StackPanel>
                        <CheckBox Content="Remember resume history" IsChecked="{Binding RememberResumeHistory, Mode=TwoWay}" AutomationProperties.Name="Remember resume history" ToolTip.Tip="Turning this off clears saved positions immediately" />
                        <TextBlock Text="Live · turning this off immediately clears saved positions and any pending prompt." Classes="settingHint" TextWrapping="Wrap" />
                        <StackPanel Spacing="5"><Button x:Name="SettingsClearResumeButton" Content="Clear resume positions…" Click="OnSettingsClearResume" HorizontalAlignment="Left" AutomationProperties.Name="Clear resume positions" ToolTip.Tip="Clear saved media positions" /><StackPanel x:Name="SettingsClearResumePrompt" IsVisible="False" Spacing="5"><TextBlock Text="Clear saved resume positions?" Classes="settingHint" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SettingsCancelClearResumeButton" Content="Cancel" Click="OnSettingsCancelClearResume" /><Button x:Name="SettingsConfirmClearResumeButton" Content="Clear" Click="OnSettingsConfirmClearResume" AutomationProperties.Name="Confirm clear resume positions" /></StackPanel></StackPanel></StackPanel>
                        <TextBlock x:Name="SettingsHistoryError" IsVisible="False" Foreground="#FFD6CE" TextWrapping="Wrap" AutomationProperties.Name="Media history error" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Resume after (seconds)" Width="155" VerticalAlignment="Center" /><NumericUpDown Minimum="0" Maximum="3600" Value="{Binding ResumeMinimumElapsedSeconds, Mode=TwoWay}" /><TextBlock Text="Next open" Classes="settingBadge" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Do not resume within (seconds)" Width="155" VerticalAlignment="Center" /><NumericUpDown Minimum="0" Maximum="3600" Value="{Binding ResumeMaximumRemainingSeconds, Mode=TwoWay}" /><TextBlock Text="Next open" Classes="settingBadge" /></StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsAppearance}" Spacing="10"><TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Theme" Width="155" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" AutomationProperties.Name="Theme" /><TextBlock x:Name="SettingsBadge" Text="Live" Classes="settingBadge" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Density" Width="155" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding DensityOptions}" SelectedItem="{Binding Density, Mode=TwoWay}" /><TextBlock Text="Live" Classes="settingBadge" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Controls hide after" Width="155" VerticalAlignment="Center" /><NumericUpDown Minimum="1" Maximum="15" Value="{Binding ControlTimeoutSeconds, Mode=TwoWay}" /><TextBlock Text="Live" Classes="settingBadge" /></StackPanel>
                        <CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" AutomationProperties.Name="Reduce motion" ToolTip.Tip="Keeps playback controls visible and disables nonessential motion" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsPlayback}" Spacing="10"><TextBlock Text="Playback" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Default speed" Width="155" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding DefaultSpeed, Mode=TwoWay}" /><TextBlock Text="Next open" Classes="settingBadge" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Skip backward (seconds)" Width="155" VerticalAlignment="Center" /><NumericUpDown Minimum="1" Maximum="120" Value="{Binding SkipBackwardSeconds, Mode=TwoWay}" /><TextBlock Text="Live" Classes="settingBadge" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Skip forward (seconds)" Width="155" VerticalAlignment="Center" /><NumericUpDown Minimum="1" Maximum="120" Value="{Binding SkipForwardSeconds, Mode=TwoWay}" /><TextBlock Text="Live" Classes="settingBadge" /></StackPanel></StackPanel>
                        <StackPanel IsVisible="{Binding IsAudio}" Spacing="10"><TextBlock Text="Audio" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Output module" Width="155" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding AudioOutputOptions}" SelectedItem="{Binding AudioOutputModule, Mode=TwoWay}" /><TextBlock Text="Restart" Classes="settingBadge" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Normvol max level" Width="155" VerticalAlignment="Center" /><NumericUpDown Minimum="0.5" Maximum="10" Increment="0.5" Value="{Binding NormalizationMaximumLevel, Mode=TwoWay}" /><TextBlock Text="Restart" Classes="settingBadge" /></StackPanel>
                        <CheckBox Content="S/PDIF passthrough" IsChecked="{Binding AudioPassthrough, Mode=TwoWay}" /><TextBlock Text="Audio device enumeration and selection are unavailable through this engine ABI." Classes="settingHint" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel IsVisible="{Binding IsVideo}" Spacing="8"><TextBlock Text="Video" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Aspect ratio, crop, zoom, deinterlace, and snapshots are unavailable: the internal engine has no safe fixed held-vout binding." TextWrapping="Wrap" Classes="settingHint" /><Button Content="Take snapshot (unavailable)" IsEnabled="False" /></StackPanel>
                        <StackPanel IsVisible="{Binding IsSubtitles}" Spacing="8"><TextBlock Text="Subtitles" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Track selection and delay are in the media drawer. Full subtitle rendering remains unqualified on this custom video path." TextWrapping="Wrap" Classes="settingHint" /></StackPanel>
                        <StackPanel IsVisible="{Binding IsHotkeys}" Spacing="8"><TextBlock Text="Hotkeys" FontSize="16" FontWeight="SemiBold" /><TextBox PlaceholderText="Search shortcuts" Text="{Binding ShortcutSearch, Mode=TwoWay}" AutomationProperties.Name="Search shortcuts" /><TextBlock Text="Shortcuts are normalized and the complete command map is checked before any save." TextWrapping="Wrap" Classes="settingHint" /><ItemsControl ItemsSource="{Binding EditableShortcutRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:ShortcutRow"><Grid ColumnDefinitions="*,120,Auto,Auto" ColumnSpacing="6" Margin="0,3"><StackPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding Category}" Classes="settingHint" /></StackPanel><TextBox Grid.Column="1" Text="{Binding PendingGesture, Mode=TwoWay}" AutomationProperties.Name="Shortcut gesture" /><Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" /><Button Grid.Column="3" Content="Reset" Command="{Binding ResetCommand}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Reset all shortcuts" Command="{Binding ResetAllShortcutsCommand}" /><TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage}" Foreground="#FFD6CE" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel IsVisible="{Binding IsAdvanced}" Spacing="8"><TextBlock Text="Advanced" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Only typed, allowlisted startup options are passed to VLC. Codec stream details are unavailable through this engine ABI." TextWrapping="Wrap" Classes="settingHint" /></StackPanel>
                        <TextBlock Text="Live applies now · Next open applies to media opened next · Restart applies after restarting Conic." Classes="settingHint" TextWrapping="Wrap" />
                        <StackPanel x:Name="SettingsResetRow" Orientation="Horizontal" Spacing="8"><Button Content="Reset page" Command="{Binding ResetPageCommand}" AutomationProperties.Name="Reset current settings page" /><Button Content="Reset all" Command="{Binding ResetAllCommand}" AutomationProperties.Name="Reset all settings" /><Button Content="Cancel" Command="{Binding CancelResetCommand}" IsVisible="{Binding ConfirmReset}" AutomationProperties.Name="Cancel settings reset" /><TextBlock Text="Click Reset all again to confirm" IsVisible="{Binding ConfirmReset}" Classes="settingHint" /></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
