<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Conic.ViewModels"
             xmlns:controls="clr-namespace:Conic.Controls"
             x:Class="Conic.Views.HomeView"
             x:Name="HomeRoot"
             Background="{DynamicResource Vlc.Bg.B1}"
             x:DataType="vm:PlayerPresentationViewModel"
             Classes.list="{Binding HomeListLayout}">
    <UserControl.Styles>
        <!-- Sidebar (design: rail container BG/B1 around a BG/A4 panel). Items
             are 32 tall: a 30x32 icon box and a 14 px label. The selected item
             has an FG/2 label and the accent icon; the others stay FG/A2. -->
        <Style Selector="Border#SidebarRail">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B1}" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Border#SidebarPanel">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A4}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Button.navigation">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        </Style>
        <Style Selector="Button.navigation.selected">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
        </Style>
        <Style Selector="Button.navigation.selected controls|VlcIcon">
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
        </Style>
        <!-- Items with a design "state=active" icon swap to it when selected. -->
        <Style Selector="Button.navigation controls|VlcIcon.active">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.navigation.selected controls|VlcIcon.active">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.navigation.selected controls|VlcIcon.inactive">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Icon rail: below 720 DIPs, or when the title bar toggle collapses
             the sidebar. One BG/A4 strip, icons only (tooltips name them). -->
        <Style Selector=":is(UserControl).rail Border#SidebarRail">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A4}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector=":is(UserControl).rail Border#SidebarPanel">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,12" />
        </Style>
        <Style Selector=":is(UserControl).rail TextBlock.navLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).rail Button.navigation">
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- Narrow window: the sidebar is always a rail, so its toggle goes,
             and the title bar and content header drop what does not fit. -->
        <Style Selector=":is(UserControl).compact Button#SidebarToggle, :is(UserControl).compact TextBlock#HomeTitle, :is(UserControl).compact TextBlock#HomeItemCount">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid#ContentHeader">
            <Setter Property="ColumnSpacing" Value="20" />
        </Style>
        <Style Selector="TextBox#HomeSearchBox">
            <Setter Property="Width" Value="240" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBox#HomeSearchBox">
            <Setter Property="Width" Value="140" />
        </Style>
        <Style Selector=":is(UserControl).compact Grid#ContentHeader">
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <!-- Home sections (design 6261:15078): a 20 px FG/A1 title with a
             chevron that opens the section's route, then one row of cards. -->
        <Style Selector="StackPanel.homeSection">
            <Setter Property="Spacing" Value="20" />
            <Setter Property="Margin" Value="0,20" />
        </Style>
        <Style Selector="Button.sectionTitle">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A1}" />
        </Style>
        <Style Selector="Button.sectionTitle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sectionTitle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>
        <Style Selector="Button.sectionTitle:focus-visible">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Media cards (design 970:4028): a 16:9 thumbnail (radius 6) with
             the title (14, FG/A2) and detail (12, FG/A3) below, no chrome.
             Saved progress is a thin accent line along the thumbnail's
             bottom. The actions (queue, favorite, remove) appear over the
             thumbnail on hover or keyboard focus, and in the context menu. -->
        <Style Selector="ItemsControl.mediaItems">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <controls:MediaGridPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.mediaTile">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        </Style>
        <Style Selector="Button.mediaTile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.mediaTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.mediaTile:focus-visible">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.mediaTile:pointerover TextBlock.cardTitle, Button.mediaTile:focus-visible TextBlock.cardTitle">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>
        <Style Selector="controls|AspectRatioDecorator.thumbnailBox">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.artwork">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PlayerCardArtwork}" />
        </Style>
        <Style Selector="ProgressBar.cardProgress">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.cardDetail">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <Style Selector="StackPanel.cardActions">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Panel.mediaCard:pointerover StackPanel.cardActions, Panel.mediaCard:focus-within StackPanel.cardActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Over the thumbnail the actions are light on a dark scrim in both
             themes (Vlc.OnMedia.*); in the list they follow the theme. -->
        <Style Selector="Button.cardAction">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Scrim}" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.OnMedia.FgDim}" />
        </Style>
        <Style Selector="Button.cardAction.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Scrim}" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccent}" />
        </Style>
        <Style Selector="Button.cardAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.OnMedia.Fg}" />
        </Style>
        <Style Selector="Button.cardAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.OnMedia.Fg}" />
        </Style>
        <Style Selector="Button.cardAction:focus-visible">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Scrim}" />
        </Style>
        <!-- List view (design 970:3792): rows in columns, a 32 px thumbnail and
             the title; hover shows a background. -->
        <Style Selector=":is(UserControl).list controls|MediaGridPanel">
            <Setter Property="ItemMinWidth" Value="{x:Static controls:MediaGridPanel.RowMinWidth}" />
            <Setter Property="ItemMaxWidth" Value="{x:Static controls:MediaGridPanel.RowMaxWidth}" />
            <Setter Property="RowSpacing" Value="2" />
        </Style>
        <Style Selector=":is(UserControl).list Button.mediaTile">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="2,2,8,2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector=":is(UserControl).list Button.mediaTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
        </Style>
        <Style Selector=":is(UserControl).list Button.mediaTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Pressed}" />
        </Style>
        <Style Selector=":is(UserControl).list controls|AspectRatioDecorator.thumbnailBox">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Ratio" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector=":is(UserControl).list Border.artwork">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector=":is(UserControl).list controls|MediaThumbnail">
            <Setter Property="PlaceholderSize" Value="18" />
        </Style>
        <Style Selector=":is(UserControl).list ProgressBar.cardProgress">
            <Setter Property="Height" Value="2" />
        </Style>
        <Style Selector=":is(UserControl).list TextBlock.cardTitle">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(UserControl).list TextBlock.cardDetail">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(UserControl).list Panel.mediaCard:pointerover TextBlock.cardDetail, :is(UserControl).list Panel.mediaCard:focus-within TextBlock.cardDetail">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector=":is(UserControl).list StackPanel.cardActions">
            <Setter Property="Spacing" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector=":is(UserControl).list Button.cardAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        </Style>
        <Style Selector=":is(UserControl).list Button.cardAction.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
        </Style>
        <Style Selector=":is(UserControl).list Button.cardAction:pointerover /template/ ContentPresenter#PART_ContentPresenter, :is(UserControl).list Button.cardAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.Overlay.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>
        <Style Selector=":is(UserControl).list Button.cardAction:focus-visible">
            <Setter Property="Background" Value="{DynamicResource PlayerSelection}" />
        </Style>
        <!-- Mini player card (design 970:3091): BG/A3 with the design's
             "bg blur + shadow" effect approximated by its drop shadow. There
             is no backdrop blur, so the surface is opaque (at the design's
             0.95 the cards behind showed through). Radius 8, padding 10.
             The surface and shadow sit on a childless Border behind the
             content: offscreen captures (RenderTargetBitmap, smoke reviews)
             misplace the children of a shadowed Border above 100 % scale. HomeView.axaml.cs sets the
             width (391 as in the design, less when the content is narrower)
             and the .compact class. -->
        <Style Selector="Panel.miniPlayer">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector="Border.miniSurface">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Dim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 15 0 #75000000" />
        </Style>
        <Style Selector="Grid#MiniPlayerLayout">
            <Setter Property="Margin" Value="11" />
        </Style>
        <Style Selector="Border.miniArtwork">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource PlayerCardArtwork}" />
        </Style>
        <Style Selector="Border.miniScrim">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Scrim}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Cells of the card's grid (columns Auto,*,Auto,Auto,Auto; rows
             preview, progress, info) are set here, not on the elements, so
             the compact styles below can move them. -->
        <Style Selector="StackPanel#MiniPlayerTransport">
            <Setter Property="Grid.ColumnSpan" Value="5" />
        </Style>
        <Style Selector="Button#MiniPlayerPipButton">
            <Setter Property="Grid.Column" Value="4" />
        </Style>
        <Style Selector="StackPanel#MiniPlayerInfo">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.ColumnSpan" Value="4" />
        </Style>
        <Style Selector="StackPanel#MiniPlayerActions">
            <Setter Property="Grid.Row" Value="2" />
            <Setter Property="Grid.Column" Value="4" />
        </Style>
        <Style Selector="StackPanel.miniTransport">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.miniCorner">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <!-- Over the preview the controls are light on a dark scrim; they
             appear with the scrim on hover, keyboard focus or pause (opacity
             only, so Tab still reaches them). -->
        <Style Selector="Button.miniControl">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.OnMedia.Fg}" />
        </Style>
        <Style Selector="Panel.miniPlayer:not(.compact) Button.miniControl:pointerover /template/ ContentPresenter#PART_ContentPresenter, Panel.miniPlayer:not(.compact) Button.miniControl:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.OnMedia.Fg}" />
        </Style>
        <Style Selector="Panel.miniPlayer:not(.compact) Button.miniControl:focus-visible">
            <Setter Property="Background" Value="{DynamicResource Vlc.OnMedia.Scrim}" />
        </Style>
        <Style Selector="Button.miniPlay">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.miniPlay controls|VlcIcon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector=":is(Control).miniOverlay">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Panel.miniPlayer:pointerover :is(Control).miniOverlay, Panel.miniPlayer:focus-within :is(Control).miniOverlay, Panel.miniPlayer:not(.playing) :is(Control).miniOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.miniPlayer:pointerover Border.miniScrim, Panel.miniPlayer:focus-within Border.miniScrim, Panel.miniPlayer:not(.playing) Border.miniScrim">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="ProgressBar.miniProgress">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
        </Style>
        <Style Selector="StackPanel.miniInfo">
            <Setter Property="Margin" Value="0,10,8,0" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.miniTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        </Style>
        <Style Selector="Panel.miniPlayer:pointerover TextBlock.miniTitle">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>
        <Style Selector="StackPanel.miniFolder">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector="StackPanel.miniFolder controls|VlcIcon">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <Style Selector="StackPanel.miniFolder TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <Style Selector="StackPanel.miniActions">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <!-- Compact card (narrow or short windows): one row, no preview:
             transport, title and folder, stop, picture in picture, return,
             queue; the progress line below. Controls stay visible. -->
        <Style Selector="Panel.miniPlayer.compact">
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Grid#MiniPlayerLayout">
            <Setter Property="Margin" Value="7,7,9,9" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact controls|AspectRatioDecorator#MiniPlayerPreview">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact :is(Control).miniOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact StackPanel#MiniPlayerTransport">
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Spacing" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Button.miniControl">
            <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Button.miniPlay">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="3,4" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Button.miniPlay controls|VlcIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Button.miniCorner">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Button#HomeStopButton">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact Button#MiniPlayerPipButton">
            <Setter Property="Grid.Column" Value="3" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact StackPanel#MiniPlayerInfo">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="1" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Spacing" Value="0" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact TextBlock.miniTitle">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact StackPanel.miniFolder controls|VlcIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact StackPanel.miniFolder TextBlock">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact StackPanel#MiniPlayerActions">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Spacing" Value="0" />
        </Style>
        <Style Selector="Panel.miniPlayer.compact ProgressBar.miniProgress">
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <!-- One template for grid and list; the .list styles above rearrange it,
             so switching layouts keeps each card and its loaded thumbnail. -->
        <DataTemplate x:Key="MediaCardTemplate" x:DataType="vm:HomeMediaItem">
            <Panel Classes="mediaCard">
                <Panel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play"
                                  Command="{Binding DataContext.OpenRecentCommand, ElementName=HomeRoot}"
                                  CommandParameter="{Binding Source}" />
                        <MenuItem Header="Add to queue"
                                  Command="{Binding DataContext.EnqueueHomeItemCommand, ElementName=HomeRoot}"
                                  CommandParameter="{Binding Source}" />
                        <MenuItem Header="Add to favorites"
                                  IsVisible="{Binding !IsFavorite}"
                                  Command="{Binding DataContext.AddFavoriteCommand, ElementName=HomeRoot}"
                                  CommandParameter="{Binding Source}" />
                        <MenuItem Header="Remove from favorites"
                                  IsVisible="{Binding IsFavorite}"
                                  Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=HomeRoot}"
                                  CommandParameter="{Binding Source}" />
                        <Separator />
                        <MenuItem Header="Remove from this section"
                                  Command="{Binding DataContext.RemoveHomeItemCommand, ElementName=HomeRoot}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Panel.ContextMenu>
                <Button Classes="mediaTile"
                        Command="{Binding DataContext.OpenRecentCommand, ElementName=HomeRoot}"
                        CommandParameter="{Binding Source}"
                        ToolTip.Tip="{Binding Title}"
                        AutomationProperties.Name="{Binding Title}">
                    <DockPanel>
                        <controls:AspectRatioDecorator Classes="thumbnailBox">
                            <Border Classes="artwork">
                                <Panel>
                                    <controls:MediaThumbnail Source="{Binding Source}" />
                                    <ProgressBar Classes="cardProgress"
                                                 IsVisible="{Binding HasProgress}"
                                                 Value="{Binding Progress}" />
                                </Panel>
                            </Border>
                        </controls:AspectRatioDecorator>
                        <DockPanel>
                            <TextBlock Classes="cardDetail" Text="{Binding Detail}" />
                            <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                        </DockPanel>
                    </DockPanel>
                </Button>
                <StackPanel Classes="cardActions">
                    <Button Classes="icon cardAction"
                            Command="{Binding DataContext.EnqueueHomeItemCommand, ElementName=HomeRoot}"
                            CommandParameter="{Binding Source}"
                            ToolTip.Tip="Add to queue"
                            AutomationProperties.Name="{Binding Title, StringFormat='Add {0} to queue'}">
                        <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Add}" />
                    </Button>
                    <Button Classes="icon cardAction"
                            IsVisible="{Binding !IsFavorite}"
                            Command="{Binding DataContext.AddFavoriteCommand, ElementName=HomeRoot}"
                            CommandParameter="{Binding Source}"
                            ToolTip.Tip="Add to favorites"
                            AutomationProperties.Name="{Binding Title, StringFormat='Add {0} to favorites'}">
                        <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Favorite}" />
                    </Button>
                    <Button Classes="icon cardAction active"
                            IsVisible="{Binding IsFavorite}"
                            Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=HomeRoot}"
                            CommandParameter="{Binding Source}"
                            ToolTip.Tip="Remove from favorites"
                            AutomationProperties.Name="{Binding Title, StringFormat='Remove {0} from favorites'}">
                        <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.FavoriteActive}" />
                    </Button>
                    <Button Classes="icon cardAction"
                            Command="{Binding DataContext.RemoveHomeItemCommand, ElementName=HomeRoot}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Remove from this section"
                            AutomationProperties.Name="{Binding Title, StringFormat='Remove {0} from this section'}">
                        <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Close}" />
                    </Button>
                </StackPanel>
            </Panel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowDefinitions="40,*">
        <!-- The design's title bar; it doubles as the window caption on Home. -->
        <Border x:Name="HomeHeader"
                Classes="titleBar"
                Background="{DynamicResource Vlc.Bg.A3Transparent}"
                PointerPressed="OnHeaderPointerPressed">
            <controls:TitleBarPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <controls:VlcCone Width="24"
                                      Height="24"
                                      Margin="7,2"
                                      VerticalAlignment="Center" />
                    <Button Classes="titleBar"
                            Click="OnMore"
                            ToolTip.Tip="Open options"
                            AutomationProperties.Name="Open options">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.More}" />
                    </Button>
                    <Button x:Name="SidebarToggle"
                            Classes="titleBar"
                            Click="OnToggleSidebar"
                            ToolTip.Tip="Collapse sidebar"
                            AutomationProperties.Name="Collapse sidebar">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Sidebar}" />
                    </Button>
                    <Border Classes="titleDivider" />
                    <!-- Shown with the mini player, while something is playing or paused. -->
                    <Button Classes="titleBar"
                            Command="{Binding ShowPlayerCommand}"
                            IsVisible="{Binding ShowMiniPlayer}"
                            ToolTip.Tip="Return to player"
                            AutomationProperties.Name="Return to player">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.ArrowLeft}" />
                    </Button>
                    <StackPanel x:Name="HomeLocation"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <controls:VlcIcon Width="24" Height="24"
                                          Foreground="{DynamicResource PlayerSecondaryText}"
                                          Icon="{StaticResource Icon.Folder}" />
                        <TextBlock Text="{Binding HomeSection}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PlayerSecondaryText}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="HomeTitle"
                           Classes="windowTitle"
                           Text="VLC Media Player" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="titleBar"
                            Command="{Binding ToggleQueueCommand}"
                            ToolTip.Tip="Playback queue"
                            AutomationProperties.Name="Playback queue">
                        <controls:VlcIcon Width="24" Height="24"
                                          Icon="{StaticResource Icon.Lists}" />
                    </Button>
                    <controls:WindowCaptionButtons />
                </StackPanel>
            </controls:TitleBarPanel>
        </Border>
        <Grid Grid.Row="1"
             x:Name="HomeColumns"
             ColumnDefinitions="217,*">
            <Border x:Name="SidebarRail">
                <Border x:Name="SidebarPanel">
                    <Grid RowDefinitions="*,Auto">
                        <StackPanel Spacing="14">
                            <Button Classes="navigation"
                                    Classes.selected="{Binding IsHomeSection}"
                                    Command="{Binding SelectHomeSectionCommand}"
                                    CommandParameter="Home"
                                    ToolTip.Tip="Home"
                                    AutomationProperties.Name="Home">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="30" Height="32">
                                        <controls:VlcIcon Classes="inactive" Width="24" Height="24"
                                                          Icon="{StaticResource Icon.Home}" />
                                        <controls:VlcIcon Classes="active" Width="24" Height="24"
                                                          Icon="{StaticResource Icon.HomeActive}" />
                                    </Panel>
                                    <TextBlock Classes="navLabel" Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="navigation"
                                    Classes.selected="{Binding IsRecentSection}"
                                    Command="{Binding SelectHomeSectionCommand}"
                                    CommandParameter="Recent"
                                    ToolTip.Tip="Recent"
                                    AutomationProperties.Name="Recent">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="30" Height="32">
                                        <controls:VlcIcon Width="24" Height="24"
                                                          Icon="{StaticResource Icon.Recent}" />
                                    </Panel>
                                    <TextBlock Classes="navLabel" Text="Recent" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="navigation"
                                    Classes.selected="{Binding IsFavoritesSection}"
                                    Command="{Binding SelectHomeSectionCommand}"
                                    CommandParameter="Favorites"
                                    ToolTip.Tip="Favorites"
                                    AutomationProperties.Name="Favorites">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="30" Height="32">
                                        <controls:VlcIcon Classes="inactive" Width="24" Height="24"
                                                          Icon="{StaticResource Icon.Favorite}" />
                                        <controls:VlcIcon Classes="active" Width="24" Height="24"
                                                          Icon="{StaticResource Icon.FavoriteActive}" />
                                    </Panel>
                                    <TextBlock Classes="navLabel" Text="Favorites" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="navigation"
                                    Classes.selected="{Binding IsContinueSection}"
                                    Command="{Binding SelectHomeSectionCommand}"
                                    CommandParameter="Continue watching"
                                    ToolTip.Tip="Continue watching"
                                    AutomationProperties.Name="Continue watching">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel Width="30" Height="32">
                                        <controls:VlcIcon Width="24" Height="24"
                                                          Icon="{StaticResource Icon.Playback}" />
                                    </Panel>
                                    <TextBlock Classes="navLabel" Text="Continue" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1"
                                Classes="navigation"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Preferences"
                                AutomationProperties.Name="Preferences">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Panel Width="30" Height="32">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Settings}" />
                                </Panel>
                                <TextBlock Classes="navLabel" Text="Preferences" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Border>
            <!-- Content area (design: BG/B1, padding 20): a 34 tall header with
                 the section, item count, layout toggle, search and more, then a
                 Divider/Dim line. No back/forward or sort (not supported). -->
            <Border x:Name="ContentPanel"
                    Grid.Column="1"
                    Background="{DynamicResource Vlc.Bg.B1}"
                    Padding="20">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel IsVisible="{Binding !ShowHomeWelcome}" Margin="0,0,0,17">
                        <Grid x:Name="ContentHeader"
                              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                              MinHeight="34">
                            <TextBlock Text="{Binding HomeSection}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PlayerSecondaryText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HomeItemCount"
                                       Grid.Column="1"
                                       Text="{Binding HomeItemCountText}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Vlc.Fg.A3}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button Classes="icon"
                                        Classes.active="{Binding !HomeListLayout}"
                                        Click="OnGridLayout"
                                        ToolTip.Tip="Grid view"
                                        AutomationProperties.Name="Grid view">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.Grid}" />
                                </Button>
                                <Button Classes="icon"
                                        Classes.active="{Binding HomeListLayout}"
                                        Click="OnListLayout"
                                        ToolTip.Tip="List view"
                                        AutomationProperties.Name="List view">
                                    <controls:VlcIcon Width="24" Height="24"
                                                      Icon="{StaticResource Icon.List}" />
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="HomeSearchBox"
                                     Grid.Column="3"
                                     Classes="search"
                                     VerticalAlignment="Center"
                                     Text="{Binding HomeSearch}"
                                     PlaceholderText="Search your media"
                                     AutomationProperties.Name="Search your media" />
                            <Button Grid.Column="4"
                                    Classes="icon"
                                    ToolTip.Tip="Library options"
                                    AutomationProperties.Name="Library options">
                                <controls:VlcIcon Width="24" Height="24"
                                                  Icon="{StaticResource Icon.More}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Open file…" Command="{Binding OpenMediaCommand}" />
                                        <MenuItem Header="Open folder…" Command="{Binding OpenFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Manage library…" Command="{Binding OpenLibraryCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Border Height="1"
                                Margin="0,17,0,0"
                                Background="{DynamicResource Vlc.Divider.Dim}" />
                        <TextBlock IsVisible="{Binding HomeHistoryPrivate}"
                                   Margin="0,12,0,0"
                                   Text="Some history is turned off in Preferences."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Vlc.Fg.A3}"
                                   FontSize="12" />
                    </StackPanel>
                    <Grid Grid.RowSpan="2" IsVisible="{Binding ShowHomeWelcome}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                            <controls:VlcCone Width="108" Height="108" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                <Button x:Name="HomeOpenFile"
                                        Classes="openMedia"
                                        MinWidth="100"
                                        Height="40"
                                        CornerRadius="4"
                                        Content="Open file"
                                        Command="{Binding OpenMediaCommand}" />
                                <Button Classes="openMedia"
                                        MinWidth="100"
                                        Height="40"
                                        CornerRadius="4"
                                        Content="Open folder"
                                        Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                            <TextBlock Text="or drop media anywhere"
                                       FontSize="12"
                                       Foreground="{DynamicResource PlayerSecondaryText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               IsVisible="{Binding ShowHomeEmpty}"
                               Text="{Binding HomeEmptyMessage}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PlayerSecondaryText}" />
                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding HomeHasItems}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- Its bottom margin is the mini player's height while that shows, so the last row scrolls clear of it. -->
                        <Panel x:Name="HomeScrollContent">
                            <!-- Home: one row per section (history-only library, D1);
                                 empty sections are hidden. -->
                            <StackPanel x:Name="HomeSections" IsVisible="{Binding ShowHomeSections}">
                                <StackPanel Classes="homeSection" IsVisible="{Binding HasHomeContinueItems}">
                                    <Button Classes="sectionTitle"
                                            Command="{Binding SelectHomeSectionCommand}"
                                            CommandParameter="Continue watching"
                                            ToolTip.Tip="Show all"
                                            AutomationProperties.Name="Continue watching, show all">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Continue Watching" FontSize="20" VerticalAlignment="Center" />
                                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.ChevronRight}" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl Classes="mediaItems"
                                                  ItemsSource="{Binding HomeContinueItems}"
                                                  ItemTemplate="{StaticResource MediaCardTemplate}" />
                                </StackPanel>
                                <StackPanel Classes="homeSection" IsVisible="{Binding HasHomeRecentItems}">
                                    <Button Classes="sectionTitle"
                                            Command="{Binding SelectHomeSectionCommand}"
                                            CommandParameter="Recent"
                                            ToolTip.Tip="Show all"
                                            AutomationProperties.Name="Recently played, show all">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Recently Played" FontSize="20" VerticalAlignment="Center" />
                                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.ChevronRight}" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl Classes="mediaItems"
                                                  ItemsSource="{Binding HomeRecentItems}"
                                                  ItemTemplate="{StaticResource MediaCardTemplate}" />
                                </StackPanel>
                                <StackPanel Classes="homeSection" IsVisible="{Binding HasHomeFavoriteItems}">
                                    <Button Classes="sectionTitle"
                                            Command="{Binding SelectHomeSectionCommand}"
                                            CommandParameter="Favorites"
                                            ToolTip.Tip="Show all"
                                            AutomationProperties.Name="Favorites, show all">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Favorites" FontSize="20" VerticalAlignment="Center" />
                                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.ChevronRight}" />
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl Classes="mediaItems"
                                                  ItemsSource="{Binding HomeFavoriteItems}"
                                                  ItemTemplate="{StaticResource MediaCardTemplate}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Section routes and search results: every card in one grid or list. -->
                            <ItemsControl x:Name="HomeGrid"
                                          Classes="mediaItems"
                                          Margin="0,0,0,20"
                                          IsVisible="{Binding ShowHomeGrid}"
                                          ItemsSource="{Binding HomeGridItems}"
                                          ItemTemplate="{StaticResource MediaCardTemplate}" />
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <!-- Floating mini player (design 970:3091), over the end of the
                 content while something plays or is paused. The preview is
                 the media's thumbnail (never the video surface); clicking it
                 returns to the player. Transport, stop and picture in picture
                 overlay the preview on hover or keyboard focus, and stay shown
                 while paused. The .compact card (HomeView.axaml.cs: narrow or
                 short windows) drops the preview and lines everything up in
                 one row. Tab order: previous, play, next, stop, picture in
                 picture, return to player, queue. -->
            <Panel x:Name="MiniPlayer"
                   Grid.Column="1"
                   Classes="miniPlayer"
                   Classes.playing="{Binding IsPlaying}"
                   IsVisible="{Binding ShowMiniPlayer}">
                <Border Classes="miniSurface" />
                <Grid x:Name="MiniPlayerLayout" ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <controls:AspectRatioDecorator x:Name="MiniPlayerPreview" Grid.ColumnSpan="5">
                        <Border Classes="miniArtwork"
                                Cursor="Hand"
                                Tapped="OnMiniPlayerPreviewTapped"
                                ToolTip.Tip="Return to player">
                            <Panel>
                                <controls:MediaThumbnail x:Name="MiniPlayerThumbnail"
                                                         Source="{Binding NowPlayingSource}" />
                                <Border Classes="miniScrim" />
                            </Panel>
                        </Border>
                    </controls:AspectRatioDecorator>
                    <StackPanel x:Name="MiniPlayerTransport"
                                Classes="miniOverlay miniTransport">
                        <Button Classes="icon miniControl"
                                IsVisible="{Binding HasQueueNavigation}"
                                Command="{Binding PreviousCommand}"
                                ToolTip.Tip="Previous queue item"
                                AutomationProperties.Name="Previous queue item">
                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Previous}" />
                        </Button>
                        <Button Classes="icon miniControl miniPlay"
                                Command="{Binding TogglePauseCommand}"
                                ToolTip.Tip="{Binding PlayPauseToolTip}"
                                AutomationProperties.Name="{Binding PlayPauseName}">
                            <Panel>
                                <controls:VlcIcon IsVisible="{Binding !IsPlaying}" Icon="{StaticResource Icon.Play}" />
                                <controls:VlcIcon IsVisible="{Binding IsPlaying}" Icon="{StaticResource Icon.Pause}" />
                            </Panel>
                        </Button>
                        <Button Classes="icon miniControl"
                                IsVisible="{Binding HasQueueNavigation}"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="Next queue item"
                                AutomationProperties.Name="Next queue item">
                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Next}" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="HomeStopButton"
                            Classes="icon miniControl miniOverlay miniCorner"
                            HorizontalAlignment="Left"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="Stop playback"
                            AutomationProperties.Name="Stop playback">
                        <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Stop}" />
                    </Button>
                    <Button x:Name="MiniPlayerPipButton"
                            Classes="icon miniControl miniOverlay miniCorner"
                            HorizontalAlignment="Right"
                            Command="{Binding TogglePictureInPictureCommand}"
                            ToolTip.Tip="Picture in picture"
                            AutomationProperties.Name="Picture in picture">
                        <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Pip}" />
                    </Button>
                    <ProgressBar x:Name="MiniPlayerProgress"
                                 Grid.Row="1"
                                 Grid.ColumnSpan="5"
                                 Classes="miniProgress"
                                 Value="{Binding Position}" />
                    <StackPanel x:Name="MiniPlayerInfo"
                                Classes="miniInfo">
                        <TextBlock Classes="miniTitle"
                                   Text="{Binding MediaTitle}"
                                   ToolTip.Tip="{Binding MediaTitle}" />
                        <StackPanel Classes="miniFolder" IsVisible="{Binding HasNowPlayingFolder}">
                            <controls:VlcIcon Width="20" Height="20" Icon="{StaticResource Icon.Folder}" />
                            <TextBlock Text="{Binding NowPlayingFolder}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="MiniPlayerActions"
                                Classes="miniActions">
                        <Button Classes="icon"
                                Command="{Binding ShowPlayerCommand}"
                                ToolTip.Tip="Return to player"
                                AutomationProperties.Name="Return to player">
                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Open}" />
                        </Button>
                        <Button Classes="icon"
                                Classes.active="{Binding IsQueuePanelOpen}"
                                Command="{Binding ToggleQueueCommand}"
                                ToolTip.Tip="Playback queue (Ctrl+J)"
                                AutomationProperties.Name="Open playback queue">
                            <controls:VlcIcon Width="24" Height="24" Icon="{StaticResource Icon.Lists}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
