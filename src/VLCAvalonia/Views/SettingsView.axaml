<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VLCAvalonia.Controls"
             xmlns:viewModels="clr-namespace:VLCAvalonia.ViewModels"
             x:Class="VLCAvalonia.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel"
             Classes.dense="{Binding IsCompactDensity}"
             Background="Transparent">
    <!-- The design's Settings dialog (spec.md "Settings dialog", frames
         999:5047 to 6542:15251): a 1048x865 (at most) modal over a dimmed
         backdrop, a 50 px header (search, title, close), the category pane
         (App / Media / System) and the selected category's sections. Below
         720 DIPs (.compact, SettingsView.axaml.cs) the dialog fills the
         window and a ComboBox replaces the category pane. -->
    <UserControl.Styles>
        <!-- Dialog: the shell (backdrop, surface, header, compact layout) is
             Controls/ModalDialog; these are the header's own parts. -->
        <Style Selector="TextBox#SettingsSearch">
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock#SettingsTitle">
            <Setter Property="Margin" Value="32,0,12,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A1}" />
        </Style>
        <Style Selector="Button#SettingsCloseButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBox#SettingsSearch">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBlock#SettingsTitle">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Category pane: 216 wide, a BG/A4 inner panel (radius 6, padding
             6); group headers 14 FG/A3, categories 40 tall with a 24 icon
             and a 14 label; selected BG/A1 with FG/1 and the active icon. -->
        <Style Selector="Border.categoryPanel">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A4}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="ListBox#SettingsPages">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#SettingsPages ListBoxItem" x:DataType="viewModels:SettingsPage">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="8" x:DataType="viewModels:SettingsPage">
                        <TextBlock Classes="categoryGroup"
                                   Text="{Binding Group}"
                                   IsVisible="{Binding ShowsGroupHeader}" />
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Height="40"
                                          CornerRadius="2"
                                          Padding="{TemplateBinding Padding}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalContentAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#SettingsPages ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.categoryGroup">
            <Setter Property="Padding" Value="10,10,10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <Style Selector="controls|VlcIcon.categoryIconActive">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentIcon}" />
        </Style>
        <Style Selector="ListBox#SettingsPages ListBoxItem:selected controls|VlcIcon.categoryIconActive">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox#SettingsPages ListBoxItem:selected controls|VlcIcon.categoryIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Content: padding 20,24 (top, sides), 20 between sections; section
             titles Inter Medium 16 FG/2; rows 46 tall with the label in 14
             FG/A2 and the control in a 320 column. -->
        <Style Selector="StackPanel.settingsSection">
            <Setter Property="Spacing" Value="0" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
        </Style>
        <Style Selector="controls|SettingRow">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <controls:SettingRowPanel Margin="{TemplateBinding Padding}"
                                              ControlWidth="{TemplateBinding ControlWidth}"
                                              MinHeight="36"
                                              VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Classes="settingLabel"
                                       Text="{TemplateBinding Label}" />
                            <Border Classes="settingInfo"
                                    IsVisible="{TemplateBinding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="{TemplateBinding Help}">
                                <controls:VlcIcon Width="16" Height="16"
                                                  Icon="{StaticResource Icon.Info}" />
                            </Border>
                            <Border Classes="settingBadge"
                                    IsVisible="{TemplateBinding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{TemplateBinding Badge}" />
                            </Border>
                        </WrapPanel>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </controls:SettingRowPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.settingLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
        </Style>
        <Style Selector="Border.settingInfo">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ToolTip.ShowDelay" Value="200" />
        </Style>
        <Style Selector="Border.settingInfo controls|VlcIcon">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <Style Selector="Border.settingInfo:pointerover controls|VlcIcon">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A1}" />
        </Style>
        <!-- Apply-mode tag: quiet text in a thin outline. -->
        <Style Selector="Border.settingBadge">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Divider.Bright}" />
        </Style>
        <Style Selector="Border.settingBadge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <Style Selector="TextBlock.settingNote">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A3}" />
        </Style>
        <!-- Controls in the 320 column: 36 tall, full width. -->
        <Style Selector="controls|SettingRow ComboBox, controls|SettingRow NumericUpDown, controls|SettingRow Button.settingAction, controls|SettingRow TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="controls|SettingRow TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="controls|SettingRow NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Picture sliders (design: Video › Picture): the speed slider's
             8-tall BG/B2 track, BG/Accent Bright fill and 8x20 accent handle,
             without ticks; the value is shown at the right. -->
        <Style Selector="Slider.setting">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Margin="{TemplateBinding Padding}">
                        <Border x:Name="TrackBackground"
                                Height="8"
                                VerticalAlignment="Center"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Background="{TemplateBinding Background}" />
                        <Track Name="PART_Track" Orientation="Horizontal" Margin="2,0"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlayerSliderFill}" Padding="0,8" CornerRadius="4" />
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb Theme="{StaticResource PlayerSliderThumb}" Width="8" Height="20" CornerRadius="3" />
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlayerSliderFill}" />
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.setting /template/ RepeatButton#PART_DecreaseButton, Slider.setting:pointerover /template/ RepeatButton#PART_DecreaseButton, Slider.setting:pressed /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.AccentBright}" />
        </Style>
        <Style Selector="Slider.setting /template/ RepeatButton#PART_IncreaseButton, Slider.setting:pointerover /template/ RepeatButton#PART_IncreaseButton, Slider.setting:pressed /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.setting /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
        </Style>
        <Style Selector="Slider.setting:pointerover /template/ Thumb, Slider.setting:pressed /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource PlayerAccentHover}" />
        </Style>
        <Style Selector="Slider.setting:focus-visible /template/ Border#TrackBackground">
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
        </Style>
        <Style Selector="Slider.setting:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.settingValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
        </Style>
        <Style Selector="Button.settingAction">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="Button.settingsSmall">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Segmented control (Theme): 320x36 BG/B2 container (radius 6,
             padding 2, gap 2), segments radius 4 in BG/A4, the selected one
             in BG/Accent Bright with an accent label. -->
        <Style Selector="Border.segmented">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
        </Style>
        <Style Selector="RadioButton.segment">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.A4}" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.AccentBright}" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccentText}" />
        </Style>
        <Style Selector="RadioButton.segment:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource PlayerAccent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <!-- Accent swatches: 32x32 cells (radius 4, padding 6) with the
             color in a 20x20 square; unselected swatches are dimmed as in the
             design, the selected one has BG/Accent Bright behind it. -->
        <Style Selector="RadioButton.swatch">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Border x:Name="SwatchColor"
                                Width="20"
                                Height="20"
                                CornerRadius="3"
                                Opacity="0.7"
                                Background="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.swatch:pointerover /template/ Border#SwatchColor, RadioButton.swatch:checked /template/ Border#SwatchColor">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="RadioButton.swatch:checked">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.AccentBright}" />
        </Style>
        <Style Selector="RadioButton.swatch:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource Vlc.Fg.1}" />
        </Style>

        <!-- Keyboard shortcuts editor (2437:14832): column labels 14 FG/A2
             (FG/A3 is below 4.5:1), Divider/Dim lines between groups, group
             headings 16 FG/2, rows of the action in 14 FG/A2 and a 270x33
             BG/B2 hotkey field (140 in the compact dialog) with the key
             centered and the edit icon. -->
        <Style Selector="Grid.shortcutColumns">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Grid.shortcutColumns > TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
        </Style>
        <Style Selector="TextBlock.hotkeyColumn">
            <Setter Property="Width" Value="338" />
            <Setter Property="Padding" Value="0,0,68,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.shortcutDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Background" Value="{DynamicResource Vlc.Divider.Dim}" />
        </Style>
        <Style Selector="TextBlock.shortcutGroup">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.2}" />
        </Style>
        <Style Selector="Grid.shortcutRow">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.shortcutName">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Vlc.Fg.A2}" />
        </Style>
        <Style Selector="TextBox.shortcutField">
            <Setter Property="Width" Value="270" />
            <Setter Property="Height" Value="33" />
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="32,0,6,0" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="InnerRightContent">
                <Template>
                    <controls:VlcIcon Width="20" Height="20" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Foreground="{DynamicResource Vlc.Fg.A3}"
                                      Icon="{DynamicResource Icon.Edit}" />
                </Template>
            </Setter>
        </Style>
        <Style Selector="TextBox.shortcutField /template/ Border#PART_BorderElement, TextBox.shortcutField:pointerover /template/ Border#PART_BorderElement, TextBox.shortcutField:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Vlc.Bg.B2}" />
        </Style>
        <Style Selector="Button.icon.shortcutAction">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBox.shortcutField">
            <Setter Property="Width" Value="140" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBlock.hotkeyColumn">
            <Setter Property="Width" Value="208" />
        </Style>

        <!-- Compact density: tighter rows. -->
        <Style Selector=":is(UserControl).dense controls|SettingRow">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0,2" />
        </Style>
        <Style Selector=":is(UserControl).dense StackPanel#SettingsPageContent">
            <Setter Property="Spacing" Value="12" />
        </Style>
    </UserControl.Styles>

    <controls:ModalDialog x:Name="SettingsShell"
                          HeaderPadding="8,0,14,0"
                          CloseRequested="OnShellCloseRequested"
                          AutomationProperties.Name="Settings">
        <controls:ModalDialog.Header>
            <Grid x:Name="SettingsHeader" ColumnDefinitions="Auto,*,Auto" x:FieldModifier="internal">
                <TextBox x:Name="SettingsSearch"
                         Classes="search"
                         Text="{Binding Search, Mode=TwoWay}"
                         PlaceholderText="Search"
                         AutomationProperties.Name="Search settings"
                         x:FieldModifier="internal" />
                <TextBlock x:Name="SettingsTitle"
                           Grid.Column="1"
                           Text="{Binding DialogTitle}" />
                <Button x:Name="SettingsCloseButton"
                        Grid.Column="2"
                        Classes="icon"
                        Click="OnSettingsClose"
                        AutomationProperties.Name="Close settings"
                        ToolTip.Tip="Close (Escape)">
                    <controls:VlcIcon Width="24" Height="24"
                                      Icon="{StaticResource Icon.Close}" />
                </Button>
            </Grid>
        </controls:ModalDialog.Header>
                    <Grid x:Name="SettingsColumns"
                          ColumnDefinitions="216,*"
                          x:FieldModifier="internal">
                        <Border x:Name="SettingsCategoryPane" Padding="8" x:FieldModifier="internal">
                            <Border Classes="categoryPanel">
                                <ListBox x:Name="SettingsPages"
                                         ItemsSource="{Binding FilteredPages}"
                                         SelectedItem="{Binding SelectedPage}"
                                         AutomationProperties.Name="Settings pages"
                                         x:FieldModifier="internal">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SettingsPage">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Panel Width="32" Height="32">
                                                    <controls:VlcIcon Classes="categoryIcon"
                                                                      Width="24" Height="24"
                                                                      Icon="{Binding Icon, Converter={x:Static controls:IconKeyConverter.Instance}}" />
                                                    <controls:VlcIcon Classes="categoryIconActive"
                                                                      Width="24" Height="24"
                                                                      Icon="{Binding Icon, Converter={x:Static controls:IconKeyConverter.Instance}, ConverterParameter=Active}" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Border>
                        <Grid x:Name="SettingsBody"
                              Grid.Column="1"
                              RowDefinitions="Auto,Auto,*"
                              x:FieldModifier="internal">
                            <ComboBox x:Name="CompactSettingsPages"
                                      Margin="16,12,16,0"
                                      IsVisible="False"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding FilteredPages}"
                                      SelectedItem="{Binding SelectedPage}"
                                      AutomationProperties.Name="Settings pages"
                                      x:FieldModifier="internal">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:SettingsPage">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="1"
                                       Margin="24,12,24,0"
                                       Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding HasError}"
                                       Foreground="{DynamicResource PlayerErrorText}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Settings error" />
                            <TextBlock Grid.Row="2"
                                       IsVisible="{Binding !HasSettingsResults}"
                                       Text="No settings match your search."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PlayerSecondaryText}" />
                            <ScrollViewer x:Name="SettingsContent"
                                          Grid.Row="2"
                                          IsVisible="{Binding HasSettingsResults}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          x:FieldModifier="internal">
                                <StackPanel x:Name="SettingsPageContent"
                                            Margin="24,20,24,32"
                                            Spacing="20">
                                    <!-- App › General -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsGeneral}">
                                        <TextBlock Classes="sectionTitle" Text="Appearance" />
                                        <controls:SettingRow Label="Theme" Help="Dark, light, or the same as your system">
                                            <Border Classes="segmented">
                                                <ItemsControl x:Name="ThemeSegments"
                                                              ItemsSource="{Binding ThemeChoices}"
                                                              controls:RadioGroupNavigation.IsEnabled="True"
                                                              AutomationProperties.Name="Theme"
                                                              x:FieldModifier="internal">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:SettingChoice">
                                                            <RadioButton Classes="segment"
                                                                         GroupName="SettingsTheme"
                                                                         Content="{Binding Label}"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         IsTabStop="{Binding IsSelected}"
                                                                         AutomationProperties.Name="{Binding AutomationName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Accent color" Help="The color of buttons, sliders and selections">
                                            <Border Classes="segmented" HorizontalAlignment="Left">
                                                <ItemsControl x:Name="AccentSwatches"
                                                              ItemsSource="{Binding AccentChoices}"
                                                              controls:RadioGroupNavigation.IsEnabled="True"
                                                              AutomationProperties.Name="Accent color"
                                                              x:FieldModifier="internal">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:SettingChoice">
                                                            <RadioButton Classes="swatch"
                                                                         GroupName="SettingsAccent"
                                                                         Foreground="{Binding Swatch}"
                                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                         IsTabStop="{Binding IsSelected}"
                                                                         ToolTip.Tip="{Binding Label}"
                                                                         AutomationProperties.Name="{Binding AutomationName}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- App › Interface -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsInterface}">
                                        <TextBlock Classes="sectionTitle" Text="Layout" />
                                        <controls:SettingRow Label="Density" Help="Compact narrows the gaps in the control bar and tightens the rows in Settings">
                                            <ComboBox ItemsSource="{Binding DensityOptions}"
                                                      SelectedItem="{Binding Density, Mode=TwoWay}"
                                                      AutomationProperties.Name="Density"
                                                      AutomationProperties.HelpText="Compact narrows the gaps in the control bar and tightens the rows in Settings" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsInterface}">
                                        <TextBlock Classes="sectionTitle" Text="Playback Controls" />
                                        <controls:SettingRow Label="Controls hide after (seconds)" Help="How long the bars stay up over fullscreen video without input">
                                            <NumericUpDown Minimum="1"
                                                           Maximum="15"
                                                           Value="{Binding ControlTimeoutSeconds, Mode=TwoWay}"
                                                           AutomationProperties.Name="Controls hide after" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Reduce motion" Help="Turns off animation (fades, button press scaling, the sliding loading bar) and keeps the playback controls from hiding" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                                      AutomationProperties.Name="Reduce motion"
                                                      AutomationProperties.HelpText="Turns off animation (fades, button press scaling, the sliding loading bar) and keeps the playback controls from hiding" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- App › Privacy -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPrivacy}">
                                        <TextBlock Classes="sectionTitle" Text="History" />
                                        <controls:SettingRow Label="Remember recent media" Help="Turning this off clears recent media immediately" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding RememberRecentMedia, Mode=TwoWay}"
                                                      AutomationProperties.Name="Remember recent media"
                                                      AutomationProperties.HelpText="Turning this off clears recent media immediately" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Recent history">
                                            <StackPanel Spacing="6">
                                                <Button x:Name="SettingsClearRecentButton"
                                                        Classes="secondary settingAction"
                                                        Content="Clear recent history…"
                                                        Click="OnSettingsClearRecent"
                                                        AutomationProperties.Name="Clear recent history"
                                                        ToolTip.Tip="Clear recently opened media"
                                                        x:FieldModifier="internal" />
                                                <StackPanel x:Name="SettingsClearRecentPrompt" IsVisible="False" Spacing="6" x:FieldModifier="internal">
                                                    <TextBlock Text="Clear recent history?" Classes="settingNote" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button x:Name="SettingsCancelClearRecentButton" Classes="secondary settingsSmall" Content="Cancel" Click="OnSettingsCancelClearRecent" x:FieldModifier="internal" />
                                                        <Button x:Name="SettingsConfirmClearRecentButton" Classes="secondary settingsSmall" Content="Clear" Click="OnSettingsConfirmClearRecent" AutomationProperties.Name="Confirm clear recent history" x:FieldModifier="internal" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Remember resume history" Help="Turning this off clears saved positions and any pending prompt immediately" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding RememberResumeHistory, Mode=TwoWay}"
                                                      AutomationProperties.Name="Remember resume history"
                                                      AutomationProperties.HelpText="Turning this off clears saved positions immediately" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Resume positions">
                                            <StackPanel Spacing="6">
                                                <Button x:Name="SettingsClearResumeButton"
                                                        Classes="secondary settingAction"
                                                        Content="Clear resume positions…"
                                                        Click="OnSettingsClearResume"
                                                        AutomationProperties.Name="Clear resume positions"
                                                        ToolTip.Tip="Clear saved media positions"
                                                        x:FieldModifier="internal" />
                                                <StackPanel x:Name="SettingsClearResumePrompt" IsVisible="False" Spacing="6" x:FieldModifier="internal">
                                                    <TextBlock Text="Clear saved resume positions?" Classes="settingNote" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button x:Name="SettingsCancelClearResumeButton" Classes="secondary settingsSmall" Content="Cancel" Click="OnSettingsCancelClearResume" x:FieldModifier="internal" />
                                                        <Button x:Name="SettingsConfirmClearResumeButton" Classes="secondary settingsSmall" Content="Clear" Click="OnSettingsConfirmClearResume" AutomationProperties.Name="Confirm clear resume positions" x:FieldModifier="internal" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </controls:SettingRow>
                                        <TextBlock x:Name="SettingsHistoryError"
                                                   IsVisible="False"
                                                   Foreground="{DynamicResource PlayerErrorText}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Media history error"
                                                   x:FieldModifier="internal" />
                                    </StackPanel>

                                    <!-- App › Controls -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsControls}">
                                        <TextBlock Classes="sectionTitle" Text="Skip Amounts" />
                                        <controls:SettingRow Label="Skip backward (seconds)">
                                            <NumericUpDown Minimum="1"
                                                           Maximum="120"
                                                           Value="{Binding SkipBackwardSeconds, Mode=TwoWay}"
                                                           AutomationProperties.Name="Skip backward (seconds)" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Skip forward (seconds)">
                                            <NumericUpDown Minimum="1"
                                                           Maximum="120"
                                                           Value="{Binding SkipForwardSeconds, Mode=TwoWay}"
                                                           AutomationProperties.Name="Skip forward (seconds)" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <!-- The design's Keyboard Shortcuts editor (2437:14832) as
                                         this page's section: search (with Reset all in place of
                                         the design's field filter), Action / Hotkey columns, a
                                         heading per group and 270-wide BG/B2 hotkey fields with
                                         the edit icon. Each row keeps its Save (also Enter) and
                                         Reset; the design's Global Hotkey column and dialog-wide
                                         Cancel / Save are left out (no global hotkeys; edits are
                                         saved per shortcut, with conflict checks). -->
                                    <StackPanel x:Name="ShortcutsSection" Classes="settingsSection" IsVisible="{Binding IsControls}" Spacing="8" x:FieldModifier="internal">
                                        <TextBlock Classes="sectionTitle" Text="Keyboard Shortcuts" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBox x:Name="ShortcutSearchBox"
                                                     Classes="search"
                                                     MinHeight="34"
                                                     VerticalContentAlignment="Center"
                                                     PlaceholderText="Search keyboard shortcuts…"
                                                     Text="{Binding ShortcutSearch, Mode=TwoWay}"
                                                     AutomationProperties.Name="Search shortcuts"
                                                     x:FieldModifier="internal" />
                                            <Button Grid.Column="1"
                                                    Classes="secondary settingsSmall"
                                                    Height="34"
                                                    Content="Reset All"
                                                    Command="{Binding ResetAllShortcutsCommand}"
                                                    ToolTip.Tip="Restore every default shortcut"
                                                    AutomationProperties.Name="Reset all shortcuts" />
                                        </Grid>
                                        <TextBlock Text="Type a shortcut such as Ctrl+O, then press Enter or Save. Conflicting shortcuts must be resolved before saving."
                                                   Classes="settingNote" />
                                        <Grid Classes="shortcutColumns" ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Action" />
                                            <TextBlock Grid.Column="1" Classes="hotkeyColumn" Text="Hotkey" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding EditableShortcutGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:ShortcutGroup">
                                                    <StackPanel>
                                                        <Border Classes="shortcutDivider" />
                                                        <TextBlock Classes="shortcutGroup" Text="{Binding Category}" />
                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="viewModels:ShortcutRow">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Classes="shortcutRow">
                                                                        <TextBlock Classes="shortcutName" Text="{Binding Name}" />
                                                                        <TextBox Grid.Column="1"
                                                                                 Classes="shortcutField"
                                                                                 Text="{Binding PendingGesture, Mode=TwoWay}"
                                                                                 KeyDown="OnShortcutFieldKeyDown"
                                                                                 AutomationProperties.Name="{Binding Name, StringFormat='{}{0} shortcut'}" />
                                                                        <Button Grid.Column="2"
                                                                                Classes="icon shortcutAction"
                                                                                Command="{Binding SaveCommand}"
                                                                                ToolTip.Tip="Save"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat='Save {0} shortcut'}">
                                                                            <controls:VlcIcon Width="20" Height="20" Icon="{StaticResource Icon.Save}" />
                                                                        </Button>
                                                                        <Button Grid.Column="3"
                                                                                Classes="icon shortcutAction"
                                                                                Command="{Binding ResetCommand}"
                                                                                ToolTip.Tip="{Binding DefaultGesture, StringFormat='Reset to the default ({0})'}"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat='Reset {0} shortcut'}">
                                                                            <controls:VlcIcon Width="20" Height="20" Icon="{StaticResource Icon.Refresh}" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No shortcuts match your search." IsVisible="{Binding !HasShortcutResults}" Classes="settingNote" />
                                    </StackPanel>

                                    <!-- Media › Playback (design 3062:12552): Startup, Tracks, Order,
                                         Seeking and Files. Not built: pause when another app uses audio,
                                         video quality, menu language, optical drive, scrub thumbnails,
                                         matching .mkv files (see the phase 9b log). -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPlayback}">
                                        <TextBlock Classes="sectionTitle" Text="Startup" />
                                        <controls:SettingRow Label="Continue where you left off" Badge="Next open" Help="Ask shows a prompt to resume; Always resumes without asking; Never starts from the beginning">
                                            <ComboBox ItemsSource="{Binding ResumeModes}" SelectedItem="{Binding ResumeMode, Mode=TwoWay}" AutomationProperties.Name="Continue where you left off" AutomationProperties.HelpText="Ask shows a prompt to resume; Always resumes without asking; Never starts from the beginning" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Resume after (seconds)" Badge="Next open" Help="Positions earlier than this are not saved">
                                            <NumericUpDown Minimum="0" Maximum="3600" Increment="1" FormatString="0" Value="{Binding ResumeMinimumElapsedSeconds, Mode=TwoWay}" AutomationProperties.Name="Resume after (seconds)" AutomationProperties.HelpText="Positions earlier than this are not saved" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Skip resume near end (seconds)" Badge="Next open" Help="Media this close to its end starts from the beginning">
                                            <NumericUpDown Minimum="0" Maximum="3600" Increment="1" FormatString="0" Value="{Binding ResumeMaximumRemainingSeconds, Mode=TwoWay}" AutomationProperties.Name="Do not resume within (seconds)" AutomationProperties.HelpText="Media this close to its end starts from the beginning" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Start playing as soon as a file opens" Badge="Next open" Help="When off, media opens paused" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding AutoPlay, Mode=TwoWay}" AutomationProperties.Name="Start playing as soon as a file opens" AutomationProperties.HelpText="When off, media opens paused" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Default playback speed" Badge="Next open" Help="Each media item starts at this speed; the speed menu changes only the item that is playing">
                                            <ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding DefaultSpeed, Mode=TwoWay}" AutomationProperties.Name="Default speed" AutomationProperties.HelpText="Each media item starts at this speed; the speed menu changes only the item that is playing" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPlayback}">
                                        <TextBlock Classes="sectionTitle" Text="Tracks" />
                                        <controls:SettingRow Label="Preferred audio language" Badge="Next open" Help="Language codes in order of preference, such as en, fr; empty plays the default track">
                                            <TextBox Text="{Binding AudioLanguage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PlaceholderText="Media default (e.g. en, fr)" AutomationProperties.Name="Preferred audio language" AutomationProperties.HelpText="Language codes in order of preference, such as en, fr; empty plays the default track" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Preferred subtitle language" Badge="Next open" Help="Language codes in order of preference, such as en, fr; none turns subtitles off">
                                            <TextBox Text="{Binding SubtitleLanguage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PlaceholderText="Media default (e.g. en, fr)" AutomationProperties.Name="Preferred subtitle language" AutomationProperties.HelpText="Language codes in order of preference, such as en, fr; none turns subtitles off" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPlayback}">
                                        <TextBlock Classes="sectionTitle" Text="Order" />
                                        <controls:SettingRow Label="Repeat" Help="The mode queues start in; changing it in the player is remembered">
                                            <ComboBox ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding QueueRepeat, Mode=TwoWay}" AutomationProperties.Name="Repeat" AutomationProperties.HelpText="The mode queues start in; changing it in the player is remembered" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Shuffle" Help="Plays queues in random order; changing it in the player is remembered" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding QueueShuffle, Mode=TwoWay}" AutomationProperties.Name="Shuffle" AutomationProperties.HelpText="Plays queues in random order; changing it in the player is remembered" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Stop after each item" Badge="Next open" Help="Stops when an item ends instead of playing the next one" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding StopAfterEachItem, Mode=TwoWay}" AutomationProperties.Name="Stop after each item" AutomationProperties.HelpText="Stops when an item ends instead of playing the next one" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="When playback finishes" Help="What happens when the queue ends (or each item, with Stop after each item)">
                                            <ComboBox ItemsSource="{Binding PlaybackFinishedActions}" SelectedItem="{Binding PlaybackFinished, Mode=TwoWay}" AutomationProperties.Name="When playback finishes" AutomationProperties.HelpText="What happens when the queue ends (or each item, with Stop after each item)" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPlayback}">
                                        <TextBlock Classes="sectionTitle" Text="Seeking" />
                                        <controls:SettingRow Label="Seek precisely" Badge="Next open" Help="Seeks to the exact time; when off, seeking jumps to the nearest key frame, which is faster" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding SeekPrecisely, Mode=TwoWay}" AutomationProperties.Name="Seek precisely" AutomationProperties.HelpText="Seeks to the exact time; when off, seeking jumps to the nearest key frame, which is faster" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPlayback}">
                                        <TextBlock Classes="sectionTitle" Text="Files" />
                                        <controls:SettingRow Label="Repair damaged AVI files" Badge="Next open" Help="Builds an index in memory for AVI files with a missing or broken index, so seeking works">
                                            <ComboBox ItemsSource="{Binding AviRepairModes}" SelectedItem="{Binding AviRepair, Mode=TwoWay}" AutomationProperties.Name="Repair damaged AVI files" AutomationProperties.HelpText="Builds an index in memory for AVI files with a missing or broken index, so seeking works" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- Media › Video (design 3073:14187): Output, Picture, Deinterlacing
                                         and Framing; defaults for new media. Not built: wallpaper mode,
                                         position in the window, snapshots, custom ratios. -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsVideo}">
                                        <TextBlock Classes="sectionTitle" Text="Output" />
                                        <controls:SettingRow Label="Enable video" Badge="Next open" Help="When off, media plays its audio only" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding VideoEnabled, Mode=TwoWay}" AutomationProperties.Name="Enable video" AutomationProperties.HelpText="When off, media plays its audio only" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Start videos in fullscreen" Badge="Next open" Help="Switches to fullscreen when a video starts" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding StartFullscreen, Mode=TwoWay}" AutomationProperties.Name="Start videos in fullscreen" AutomationProperties.HelpText="Switches to fullscreen when a video starts" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Stop the screensaver during playback" Help="Keeps the display on while video plays" ControlWidth="68" IsVisible="{Binding ShowsScreensaver}">
                                            <CheckBox IsChecked="{Binding StopScreensaver, Mode=TwoWay}" AutomationProperties.Name="Stop the screensaver during playback" AutomationProperties.HelpText="Keeps the display on while video plays" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsVideo}">
                                        <TextBlock Classes="sectionTitle" Text="Picture" />
                                        <controls:SettingRow Label="Hue" Badge="Next open" Help="Turns the colors around the color wheel, in degrees; 0 leaves them unchanged">
                                            <Grid ColumnDefinitions="*,52" ColumnSpacing="8">
                                                <Slider Classes="setting" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="10" Value="{Binding Hue, Mode=TwoWay}" AutomationProperties.Name="Hue" AutomationProperties.HelpText="Turns the colors around the color wheel, in degrees; 0 leaves them unchanged" />
                                                <TextBlock Grid.Column="1" Classes="settingValue" Text="{Binding Hue, StringFormat='{}{0:0}°'}" />
                                            </Grid>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Brightness" Badge="Next open" Help="1 leaves the picture unchanged">
                                            <Grid ColumnDefinitions="*,52" ColumnSpacing="8">
                                                <Slider Classes="setting" Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1" Value="{Binding Brightness, Mode=TwoWay}" AutomationProperties.Name="Brightness" AutomationProperties.HelpText="1 leaves the picture unchanged" />
                                                <TextBlock Grid.Column="1" Classes="settingValue" Text="{Binding Brightness, StringFormat='{}{0:0.00}'}" />
                                            </Grid>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Contrast" Badge="Next open" Help="1 leaves the picture unchanged">
                                            <Grid ColumnDefinitions="*,52" ColumnSpacing="8">
                                                <Slider Classes="setting" Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1" Value="{Binding Contrast, Mode=TwoWay}" AutomationProperties.Name="Contrast" AutomationProperties.HelpText="1 leaves the picture unchanged" />
                                                <TextBlock Grid.Column="1" Classes="settingValue" Text="{Binding Contrast, StringFormat='{}{0:0.00}'}" />
                                            </Grid>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Saturation" Badge="Next open" Help="1 leaves the colors unchanged; 0 is black and white">
                                            <Grid ColumnDefinitions="*,52" ColumnSpacing="8">
                                                <Slider Classes="setting" Minimum="0" Maximum="3" SmallChange="0.01" LargeChange="0.1" Value="{Binding Saturation, Mode=TwoWay}" AutomationProperties.Name="Saturation" AutomationProperties.HelpText="1 leaves the colors unchanged; 0 is black and white" />
                                                <TextBlock Grid.Column="1" Classes="settingValue" Text="{Binding Saturation, StringFormat='{}{0:0.00}'}" />
                                            </Grid>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Gamma" Badge="Next open" Help="Needs hardware decoding off (Performance); 1 leaves the picture unchanged">
                                            <Grid ColumnDefinitions="*,52" ColumnSpacing="8">
                                                <Slider Classes="setting" Minimum="0.01" Maximum="10" SmallChange="0.01" LargeChange="0.1" Value="{Binding Gamma, Mode=TwoWay}" AutomationProperties.Name="Gamma" AutomationProperties.HelpText="Needs hardware decoding off (Performance); 1 leaves the picture unchanged" IsEnabled="{Binding CanAdjustGamma}" />
                                                <TextBlock Grid.Column="1" Classes="settingValue" Text="{Binding Gamma, StringFormat='{}{0:0.00}'}" />
                                            </Grid>
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Reset picture">
                                            <Button Classes="secondary settingAction" Content="Reset" HorizontalAlignment="Right" MinWidth="100" Command="{Binding ResetPictureCommand}" AutomationProperties.Name="Reset picture" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsVideo}">
                                        <TextBlock Classes="sectionTitle" Text="Deinterlacing" />
                                        <controls:SettingRow Label="Deinterlacing" Badge="Next open" Help="Automatic deinterlaces media marked as interlaced; On always does">
                                            <ComboBox ItemsSource="{Binding DeinterlaceModes}" SelectedItem="{Binding Deinterlace, Mode=TwoWay}" AutomationProperties.Name="Deinterlacing" AutomationProperties.HelpText="Automatic deinterlaces media marked as interlaced; On always does" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Method" Badge="Next open" Help="How the two fields of an interlaced frame are combined">
                                            <ComboBox ItemsSource="{Binding DeinterlaceMethods}" SelectedItem="{Binding DeinterlaceMethod, Mode=TwoWay}" AutomationProperties.Name="Deinterlacing method" AutomationProperties.HelpText="How the two fields of an interlaced frame are combined" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsVideo}">
                                        <TextBlock Classes="sectionTitle" Text="Framing" />
                                        <controls:SettingRow Label="Aspect ratio" Badge="Next open" Help="The aspect ratio new media starts with; the Video panel changes the media that is playing">
                                            <ComboBox ItemsSource="{Binding AspectRatios}" SelectedItem="{Binding DefaultAspectRatio, Mode=TwoWay}" AutomationProperties.Name="Default aspect ratio" AutomationProperties.HelpText="The aspect ratio new media starts with; the Video panel changes the media that is playing" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Crop" Badge="Next open" Help="The crop new media starts with; the Video panel changes the media that is playing">
                                            <ComboBox ItemsSource="{Binding Crops}" SelectedItem="{Binding DefaultCrop, Mode=TwoWay}" AutomationProperties.Name="Default crop" AutomationProperties.HelpText="The crop new media starts with; the Video panel changes the media that is playing" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Zoom" Badge="Next open" Help="Fit scales the video to the window; a fixed size keeps it at that scale">
                                            <ComboBox ItemsSource="{Binding Zooms}" SelectedItem="{Binding DefaultZoom, Mode=TwoWay}" AutomationProperties.Name="Default zoom" AutomationProperties.HelpText="Fit scales the video to the window; a fixed size keeps it at that scale" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Video adjustments" Help="Aspect ratio, crop and zoom for the media that is playing">
                                            <Button Classes="secondary settingAction" Content="Open video adjustments" Command="{Binding OpenVideoControlsCommand}" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- Media › Audio -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsAudio}">
                                        <TextBlock Classes="sectionTitle" Text="Volume" />
                                        <controls:SettingRow Label="Remember volume" Badge="Restart" Help="Starts with the volume and mute of your last session; when off, VLC starts at 100%" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding RememberVolume, Mode=TwoWay}"
                                                      AutomationProperties.Name="Remember volume"
                                                      AutomationProperties.HelpText="Starts with the volume and mute of your last session; when off, VLC starts at 100%" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsAudio}">
                                        <TextBlock Classes="sectionTitle" Text="Output" />
                                        <controls:SettingRow Label="Output module" Badge="Restart" Help="VLC uses this audio output; choosing a device is not available yet">
                                            <ComboBox ItemsSource="{Binding AudioOutputOptions}"
                                                      SelectedItem="{Binding AudioOutputModule, Mode=TwoWay}"
                                                      AutomationProperties.Name="Output module" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Normalization level" Badge="Restart" Help="Maximum volume normalization level; empty turns normalization off">
                                            <NumericUpDown Minimum="0.5"
                                                           Maximum="10"
                                                           Increment="0.5"
                                                           Value="{Binding NormalizationMaximumLevel, Mode=TwoWay}"
                                                           AutomationProperties.Name="Normvol max level" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="S/PDIF passthrough" Badge="Restart" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding AudioPassthrough, Mode=TwoWay}"
                                                      AutomationProperties.Name="S/PDIF passthrough" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsAudio}">
                                        <TextBlock Classes="sectionTitle" Text="Tracks" />
                                        <controls:SettingRow Label="Audio tracks and timing">
                                            <Button Classes="secondary settingAction"
                                                    Content="Audio tracks and timing"
                                                    Command="{Binding OpenAudioControlsCommand}" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- Media › Subtitles -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsSubtitles}">
                                        <TextBlock Classes="sectionTitle" Text="Tracks" />
                                        <controls:SettingRow Label="Subtitle tracks and timing" Help="Choose tracks and adjust timing during playback">
                                            <Button Classes="secondary settingAction"
                                                    Content="Subtitle tracks and timing"
                                                    Command="{Binding OpenSubtitleControlsCommand}" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- System › Network (design 6543:15649). Discs and Live capture are
                                         not shown: the app opens neither (the presets set them as VLC does). -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsNetwork}">
                                        <TextBlock Classes="sectionTitle" Text="Buffering" />
                                        <controls:SettingRow Label="Buffering" Badge="Next open" Help="How much VLC reads ahead before playing; Custom sets each source">
                                            <ComboBox ItemsSource="{Binding BufferingPresets}" SelectedItem="{Binding Buffering, Mode=TwoWay}" AutomationProperties.Name="Buffering" AutomationProperties.HelpText="How much VLC reads ahead before playing; Custom sets each source" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Local files (ms)" Badge="Next open" Help="Read-ahead for files on this computer">
                                            <NumericUpDown Minimum="0" Maximum="60000" Increment="100" FormatString="0" Value="{Binding FileCaching, Mode=TwoWay}" AutomationProperties.Name="Local files buffering" AutomationProperties.HelpText="Read-ahead for files on this computer" IsEnabled="{Binding IsCustomBuffering}" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Network streams (ms)" Badge="Next open" Help="Read-ahead for network URLs">
                                            <NumericUpDown Minimum="0" Maximum="60000" Increment="100" FormatString="0" Value="{Binding NetworkCaching, Mode=TwoWay}" AutomationProperties.Name="Network streams buffering" AutomationProperties.HelpText="Read-ahead for network URLs" IsEnabled="{Binding IsCustomBuffering}" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding ShowsProxyOnNetwork}">
                                        <TextBlock Classes="sectionTitle" Text="Proxy" />
                                        <controls:SettingRow Label="HTTP proxy" Badge="Next open" Help="host:port, or user@host:port when the proxy needs a password; empty connects directly">
                                            <TextBox Text="{Binding HttpProxy, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PlaceholderText="No proxy (host:port)" AutomationProperties.Name="HTTP proxy" AutomationProperties.HelpText="host:port, or user@host:port when the proxy needs a password; empty connects directly" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="HTTP proxy password" Badge="Next open" Help="Used with the user name in the proxy address; stored encrypted for your Windows account">
                                            <TextBox Text="{Binding HttpProxyPassword, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PasswordChar="•" AutomationProperties.Name="HTTP proxy password" AutomationProperties.HelpText="Used with the user name in the proxy address; stored encrypted for your Windows account" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsNetwork}">
                                        <TextBlock Classes="sectionTitle" Text="Security" />
                                        <controls:SettingRow Label="Verify certificates against the system trust store" Badge="Next open" Help="Trusts HTTPS servers whose certificates Windows trusts; when off, those servers are not trusted" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding VerifyCertificates, Mode=TwoWay}" AutomationProperties.Name="Verify certificates against the system trust store" AutomationProperties.HelpText="Trusts HTTPS servers whose certificates Windows trusts; when off, those servers are not trusted" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Cipher preference" Badge="Next open" Help="The order of TLS ciphers for HTTPS: faster ones first, or stronger ones">
                                            <ComboBox ItemsSource="{Binding CipherPreferences}" SelectedItem="{Binding CipherPreference, Mode=TwoWay}" AutomationProperties.Name="Cipher preference" AutomationProperties.HelpText="The order of TLS ciphers for HTTPS: faster ones first, or stronger ones" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- System › Performance (design 6571:15958). Not built: video
                                         post-processing (VLC 3.0.24's filter gets no quantizers from
                                         its FFmpeg and barely changes the picture), real-time and
                                         process priority, rescan plugins, the developer options. -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPerformance}">
                                        <TextBlock Classes="sectionTitle" Text="Decoding" />
                                        <controls:SettingRow Label="Hardware-accelerated decoding" Badge="Next open" Help="Decodes video on the graphics card, frames staying on the GPU; Off decodes on the processor">
                                            <ComboBox ItemsSource="{Binding HardwareDecodingModes}" SelectedItem="{Binding HardwareDecoding, Mode=TwoWay}" AutomationProperties.Name="Hardware-accelerated decoding" AutomationProperties.HelpText="Decodes video on the graphics card, frames staying on the GPU; Off decodes on the processor" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Skip the H.264 loop filter" Badge="Next open" Help="Saves processor time in software decoding at some cost in picture quality">
                                            <ComboBox ItemsSource="{Binding LoopFilterModes}" SelectedItem="{Binding SkipLoopFilter, Mode=TwoWay}" AutomationProperties.Name="Skip the H.264 loop filter" AutomationProperties.HelpText="Saves processor time in software decoding at some cost in picture quality" />
                                        </controls:SettingRow>
                                        <controls:SettingRow Label="Decoding threads" Badge="Next open" Help="Threads for software decoding; 0 lets VLC choose">
                                            <NumericUpDown Minimum="0" Maximum="16" Increment="1" FormatString="0" Value="{Binding DecodingThreads, Mode=TwoWay}" AutomationProperties.Name="Decoding threads" AutomationProperties.HelpText="Threads for software decoding; 0 lets VLC choose" />
                                        </controls:SettingRow>
                                    </StackPanel>
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsPerformance}">
                                        <TextBlock Classes="sectionTitle" Text="Smooth Playback" />
                                        <controls:SettingRow Label="Drop frames when the system can't keep up" Badge="Next open" Help="Skips frames that are too late instead of showing them late" ControlWidth="68">
                                            <CheckBox IsChecked="{Binding DropLateFrames, Mode=TwoWay}" AutomationProperties.Name="Drop frames when the system can't keep up" AutomationProperties.HelpText="Skips frames that are too late instead of showing them late" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <!-- System › Advanced -->
                                    <StackPanel Classes="settingsSection" IsVisible="{Binding IsAdvanced}">
                                        <TextBlock Classes="sectionTitle" Text="Diagnostics" />
                                        <controls:SettingRow Label="Media information" Help="The current media, codec streams and playback diagnostics">
                                            <Button Classes="secondary settingAction"
                                                    Content="Media information"
                                                    Command="{Binding OpenMediaInformationCommand}" />
                                        </controls:SettingRow>
                                    </StackPanel>

                                    <WrapPanel x:Name="SettingsResetRow" Orientation="Horizontal" x:FieldModifier="internal">
                                        <Button Classes="secondary settingsSmall" Content="Reset page" Command="{Binding ResetPageCommand}" AutomationProperties.Name="Reset current settings page" Margin="0,4,8,4" IsVisible="{Binding CanResetPage}" />
                                        <Button Classes="secondary settingsSmall" Content="Reset all" Command="{Binding ResetAllCommand}" AutomationProperties.Name="Reset all settings" Margin="0,4,8,4" />
                                        <Button Classes="secondary settingsSmall" Content="Cancel" Command="{Binding CancelResetCommand}" IsVisible="{Binding ConfirmReset}" AutomationProperties.Name="Cancel settings reset" Margin="0,4,8,4" />
                                        <TextBlock Text="Click Reset all again to confirm" IsVisible="{Binding ConfirmReset}" Classes="settingNote" VerticalAlignment="Center" Margin="0,4,8,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
    </controls:ModalDialog>
</UserControl>
