<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VLCAvalonia.ViewModels"
             xmlns:controls="clr-namespace:VLCAvalonia.Controls"
             x:Class="VLCAvalonia.Views.HomeView"
             x:Name="HomeRoot"
             x:DataType="vm:PlayerPresentationViewModel"
             Classes.list="{Binding HomeListLayout}">
    <UserControl.Styles>
        <Style Selector="Button.navigation">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource PlayerSecondaryText}" />
        </Style>
        <!-- A slim accent bar plus a soft tint replaces the previous solid
             selection block, matching the reference navigation. -->
        <Style Selector="Button.navigation.selected">
            <Setter Property="Foreground" Value="{DynamicResource PlayerAccent}" />
            <Setter Property="Background" Value="{DynamicResource PlayerSelection}" />
        </Style>
        <Style Selector="Button.navigation.selected Border.navAccent">
            <Setter Property="Background" Value="{DynamicResource PlayerAccent}" />
        </Style>
        <Style Selector=":is(UserControl).compact TextBlock.navLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.navigation">
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector=":is(UserControl).compact Button.headerOpen">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.mediaCard">
            <Setter Property="Width" Value="232" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style Selector="ItemsControl.mediaItems">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector=":is(UserControl).list ItemsControl.mediaItems">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector=":is(UserControl).list Border.mediaCard">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector=":is(UserControl).list Border.artwork">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="52,*,Auto">
        <Grid x:Name="HomeHeader"
              Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
              Margin="12,0"
              PointerPressed="OnHeaderPointerPressed">
            <Button Classes="iconChrome"
                    Command="{Binding ShowPlayerCommand}"
                    ToolTip.Tip="Return to player"
                    AutomationProperties.Name="Return to player">
                <PathIcon Width="20" Height="20"
                          Data="M10,3 L1,12 L10,21 L12,19 L6,13 H23 V11 H6 L12,5 Z" />
            </Button>
            <controls:VlcCone Grid.Column="1"
                              Width="30"
                              Height="34"
                              Margin="12,0" />
            <TextBlock Grid.Column="2"
                       Text="VLC"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource PlayerText}" />
            <Button Grid.Column="3"
                    Classes="playbackAction headerOpen"
                    Content="Open file"
                    Command="{Binding OpenMediaCommand}" />
            <Button Grid.Column="4"
                    Classes="iconChrome"
                    Command="{Binding ToggleQueueCommand}"
                    ToolTip.Tip="Playback queue"
                    AutomationProperties.Name="Playback queue">
                <PathIcon Width="20" Height="20"
                          Data="M3,5 H21 V7 H3 Z M3,11 H21 V13 H3 Z M3,17 H15 V19 H3 Z" />
            </Button>
            <Button Grid.Column="5"
                    Classes="iconChrome"
                    Click="OnMore"
                    ToolTip.Tip="Open options"
                    AutomationProperties.Name="Open options">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="3" Fill="{DynamicResource PlayerSecondaryText}" />
                        <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="10.5" Fill="{DynamicResource PlayerSecondaryText}" />
                        <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="18" Fill="{DynamicResource PlayerSecondaryText}" />
                    </Canvas>
                </Viewbox>
            </Button>
            <controls:WindowCaptionButtons Grid.Column="6"
                                           Margin="12,2,0,0"
                                           VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1"
             x:Name="HomeColumns"
             ColumnDefinitions="176,*">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Margin="0,8,0,0">
                    <Button Classes="navigation"
                            Classes.selected="{Binding IsHomeSection}"
                            Command="{Binding SelectHomeSectionCommand}"
                            CommandParameter="Home"
                            ToolTip.Tip="Home"
                            AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="navAccent"
                                    Width="3"
                                    Height="20"
                                    CornerRadius="1.5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                            <PathIcon Width="22" Height="22"
                                      Data="M2,11 L12,2 L22,11 L20,13 L19,12 V22 H14 V15 H10 V22 H5 V12 L4,13 Z" />
                            <TextBlock Classes="navLabel"
                                       Text="Home"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Classes="navigation"
                            Classes.selected="{Binding IsRecentSection}"
                            Command="{Binding SelectHomeSectionCommand}"
                            CommandParameter="Recent"
                            ToolTip.Tip="Recent"
                            AutomationProperties.Name="Recent">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="navAccent"
                                    Width="3"
                                    Height="20"
                                    CornerRadius="1.5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                            <PathIcon Width="22" Height="22"
                                      Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 M11,6 H13 V12 L17,15 L16,17 L11,13 Z" />
                            <TextBlock Classes="navLabel"
                                       Text="Recent"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Classes="navigation"
                            Classes.selected="{Binding IsFavoritesSection}"
                            Command="{Binding SelectHomeSectionCommand}"
                            CommandParameter="Favorites"
                            ToolTip.Tip="Favorites"
                            AutomationProperties.Name="Favorites">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="navAccent"
                                    Width="3"
                                    Height="20"
                                    CornerRadius="1.5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                            <PathIcon Width="22" Height="22"
                                      Data="M12,2 L15,9 L23,9 L17,14 L19,22 L12,17 L5,22 L7,14 L1,9 L9,9 Z" />
                            <TextBlock Classes="navLabel"
                                       Text="Favorites"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Classes="navigation"
                            Classes.selected="{Binding IsContinueSection}"
                            Command="{Binding SelectHomeSectionCommand}"
                            CommandParameter="Continue watching"
                            ToolTip.Tip="Continue watching"
                            AutomationProperties.Name="Continue watching">
                        <StackPanel Orientation="Horizontal">
                            <Border Classes="navAccent"
                                    Width="3"
                                    Height="20"
                                    CornerRadius="1.5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />
                            <PathIcon Width="22" Height="22"
                                      Data="M3,3 H21 V21 H3 Z M7,6 V18 L18,12 Z" />
                            <TextBlock Classes="navLabel"
                                       Text="Continue"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Row="1"
                        Classes="navigation"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Preferences"
                        AutomationProperties.Name="Preferences">
                    <StackPanel Orientation="Horizontal">
                        <Border Classes="navAccent"
                                Width="3"
                                Height="20"
                                CornerRadius="1.5"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center" />
                        <PathIcon Width="22" Height="22"
                                  Data="M12,15.5 A3.5,3.5 0 0 1 8.5,12 A3.5,3.5 0 0 1 12,8.5 A3.5,3.5 0 0 1 15.5,12 A3.5,3.5 0 0 1 12,15.5 M19.43,12.97 C19.47,12.65 19.5,12.33 19.5,12 C19.5,11.67 19.47,11.34 19.43,11 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.96 19.05,5.05 L16.56,6.05 C16.04,5.66 15.5,5.32 14.87,5.07 L14.5,2.42 C14.46,2.18 14.25,2 14,2 H10 C9.75,2 9.54,2.18 9.5,2.42 L9.13,5.07 C8.5,5.32 7.96,5.66 7.44,6.05 L4.95,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.65 4.57,12.97 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.03 4.95,18.95 L7.44,17.94 C7.96,18.34 8.5,18.68 9.13,18.93 L9.5,21.58 C9.54,21.82 9.75,22 10,22 H14 C14.25,22 14.46,21.82 14.5,21.58 L14.87,18.93 C15.5,18.67 16.04,18.34 16.56,17.94 L19.05,18.95 C19.27,19.03 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 L19.43,12.97 Z" />
                        <TextBlock Classes="navLabel"
                                   Text="Preferences"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- The content panel floats over the canvas with all corners
                 rounded, matching the reference layout. -->
            <Border Grid.Column="1"
                    Background="{DynamicResource PlayerSurface}"
                    CornerRadius="8"
                    Margin="0,4,8,8">
                <Grid Margin="24" RowDefinitions="Auto,Auto,*">
                    <Grid IsVisible="{Binding !ShowHomeWelcome}" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Text="{Binding HomeSection}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1"
                                Classes="playbackAction"
                                Content="{Binding HomeLayoutLabel}"
                                Command="{Binding ToggleHomeLayoutCommand}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16" IsVisible="{Binding !ShowHomeWelcome}">
                        <TextBox x:Name="HomeSearchBox"
                                 Text="{Binding HomeSearch}"
                                 PlaceholderText="Search your media"
                                 AutomationProperties.Name="Search your media" />
                        <TextBlock IsVisible="{Binding HomeHistoryPrivate}"
                                   Text="Some history is turned off in Preferences."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PlayerSecondaryText}"
                                   FontSize="12" />
                        <Button Classes="playbackAction"
                                Content="Manage library"
                                Command="{Binding OpenLibraryCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                    <Grid Grid.RowSpan="3" IsVisible="{Binding ShowHomeWelcome}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                            <controls:VlcCone Width="108" Height="108" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                <Button x:Name="HomeOpenFile"
                                        Classes="openMedia"
                                        MinWidth="100"
                                        Height="40"
                                        CornerRadius="4"
                                        Content="Open file"
                                        Command="{Binding OpenMediaCommand}" />
                                <Button Classes="openMedia"
                                        MinWidth="100"
                                        Height="40"
                                        CornerRadius="4"
                                        Content="Open folder"
                                        Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                            <TextBlock Text="or drop media anywhere"
                                       FontSize="12"
                                       Foreground="{DynamicResource PlayerSecondaryText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2"
                               IsVisible="{Binding ShowHomeEmpty}"
                               Text="{Binding HomeEmptyMessage}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PlayerSecondaryText}" />
                    <ScrollViewer Grid.Row="2"
                                  IsVisible="{Binding HomeHasItems}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Classes="mediaItems" ItemsSource="{Binding HomeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeMediaItem">
                                    <Border Classes="mediaCard"
                                            Background="{DynamicResource PlayerCard}"
                                            CornerRadius="6"
                                            ClipToBounds="True">
                                        <StackPanel>
                                            <Button Classes="menuAction"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.OpenRecentCommand, ElementName=HomeRoot}"
                                                    CommandParameter="{Binding Source}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <StackPanel>
                                                    <Border Classes="artwork"
                                                            Height="116"
                                                            Background="{DynamicResource PlayerCardArtwork}">
                                                        <controls:MediaThumbnail Source="{Binding Source}" />
                                                    </Border>
                                                    <StackPanel Margin="12" Spacing="6">
                                                        <TextBlock Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="{DynamicResource PlayerSecondaryText}"
                                                                   FontSize="12" />
                                                        <ProgressBar IsVisible="{Binding HasProgress}"
                                                                     Minimum="0"
                                                                     Maximum="1"
                                                                     Value="{Binding Progress}"
                                                                     Height="3"
                                                                     Foreground="{DynamicResource PlayerAccent}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,4,4">
                                                <Button Classes="playbackAction"
                                                        Content="+ Queue"
                                                        Command="{Binding DataContext.EnqueueHomeItemCommand, ElementName=HomeRoot}"
                                                        CommandParameter="{Binding Source}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Add {0} to queue'}" />
                                                <Button Classes="playbackAction"
                                                        Command="{Binding DataContext.AddFavoriteCommand, ElementName=HomeRoot}"
                                                        CommandParameter="{Binding Source}"
                                                        ToolTip.Tip="Add to favorites"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Add {0} to favorites'}">
                                                    <PathIcon Width="14" Height="14"
                                                              Data="M12,15.39 L8.24,17.66 L9.18,13.36 L5.91,10.5 L10.27,10.07 L12,6.09 L13.71,10.07 L18.09,10.5 L14.82,13.36 L15.76,17.66 M22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 L18.18,21 L16.54,13.97 L22,9.24 Z" />
                                                </Button>
                                                <Button Classes="playbackAction"
                                                        Command="{Binding DataContext.RemoveHomeItemCommand, ElementName=HomeRoot}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Remove from this section"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Remove {0} from this section'}">
                                                    <PathIcon Width="12" Height="12"
                                                              Data="M2,1 L5.9,5 L9.8,1 L11,2.2 L7.1,6.1 L11,10 L9.8,11.2 L5.9,7.3 L2,11.2 L0.8,10 L4.7,6.1 L0.8,2.2 Z" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2"
                IsVisible="{Binding ShowMiniPlayer}"
                Background="{DynamicResource PlayerWell}"
                BorderBrush="{DynamicResource PlayerBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,4" RowSpacing="8">
                <Button Classes="menuAction" HorizontalContentAlignment="Stretch" Command="{Binding ShowPlayerCommand}">
                    <TextBlock Text="{Binding MediaTitle}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Grid.Column="1"
                        Classes="playbackAction"
                        Content="{Binding PlayPauseName}"
                        Command="{Binding TogglePauseCommand}" />
                <Button x:Name="HomeStopButton"
                        Grid.Column="2"
                        Classes="playbackAction"
                        Command="{Binding StopCommand}"
                        ToolTip.Tip="Stop playback"
                        AutomationProperties.Name="Stop playback">
                    <PathIcon Width="14" Height="14" Data="M4,4 H20 V20 H4 Z" />
                </Button>
                <Button Grid.Column="3"
                        Classes="playbackAction"
                        Command="{Binding ShowPlayerCommand}"
                        ToolTip.Tip="Return to player"
                        AutomationProperties.Name="Return to player">
                    <PathIcon Width="14" Height="14"
                              Data="M9,5 H19 V15 H17 V8.41 L7.41,18 L6,16.59 L15.59,7 H9 Z" />
                </Button>
                <Button Grid.Column="4"
                        Classes="playbackAction"
                        Command="{Binding TogglePictureInPictureCommand}"
                        ToolTip.Tip="Picture in picture"
                        AutomationProperties.Name="Picture in picture">
                    <PathIcon Width="18" Height="18"
                              Data="M2,3 H22 V21 H2 Z M4,5 V19 H20 V5 Z M12,12 H18 V17 H12 Z" />
                </Button>
                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="5"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding Position}"
                             Foreground="{DynamicResource PlayerAccent}"
                             Height="3" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
