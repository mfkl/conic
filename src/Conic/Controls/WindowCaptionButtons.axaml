<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Conic.Controls"
             x:Class="Conic.Controls.WindowCaptionButtons">
    <!-- The design's 36x24 caption buttons, drawn in-app so the caption
         matches the dark chrome instead of the light system one. The design
         puts fullscreen between maximize and close; a window that offers it
         passes that button as the Accessory. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="MinimizeButton" Classes="caption" Click="OnMinimize" AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize">
            <controls:VlcIcon Width="24" Height="24"
                              Icon="{StaticResource Icon.Minimize}" />
        </Button>
        <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximize" AutomationProperties.Name="Maximize" ToolTip.Tip="Maximize">
            <controls:VlcIcon Width="24" Height="24"
                              x:Name="MaximizeIcon"
                              Icon="{StaticResource Icon.Maximize}" />
        </Button>
        <ContentPresenter x:Name="AccessoryPresenter" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Classes="caption close" Click="OnClose" AutomationProperties.Name="Close" ToolTip.Tip="Close">
            <controls:VlcIcon Width="24" Height="24"
                              Icon="{StaticResource Icon.Close}" />
        </Button>
    </StackPanel>
</UserControl>
